# .env.test
# Définir les variables d'environnement pour les tests
ABSTRACT_API_KEY=test_api_key_12345

# Utiliser une base de données SQLite pour les tests (plus rapide)
DATABASE_URL=sqlite:///%kernel.project_dir%/var/test.db

# Ou utiliser MySQL avec une base de test
# DATABASE_URL=mysql://root:@127.0.0.1:3306/eduplay_test?serverVersion=8.0
# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
