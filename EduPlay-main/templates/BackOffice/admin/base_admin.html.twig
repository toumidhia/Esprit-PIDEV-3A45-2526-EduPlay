<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Dashboard - EduPlay{% endblock %}</title>
    
    {# Tailwind CSS #}
    <script src="https://cdn.tailwindcss.com"></script>
    
    {# Google Fonts #}
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    {# Material Icons #}
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .filled-icon {
            font-variation-settings: 'FILL' 1;
        }
        
        /* Sidebar styles */
        .admin-sidebar {
            transition: all 0.3s ease;
        }
        
        .sidebar-nav a.active {
            background: linear-gradient(90deg, rgba(99, 183, 242, 0.1) 0%, rgba(99, 183, 242, 0.05) 100%);
            border-right: 4px solid #63b7f2;
            color: #63b7f2;
        }
        
        /* Stat cards */
        .stat-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }
        
        /* Course cards */
        .admin-course-card {
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        
        .admin-course-card:hover {
            border-color: rgba(99, 183, 242, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }
        
        /* Status badges */
        .status-published {
            background-color: #d1fae5;
            color: #065f46;
        }
        
        .status-pending {
            background-color: #fef3c7;
            color: #92400e;
        }
        
        .status-rejected {
            background-color: #fee2e2;
            color: #991b1b;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .admin-sidebar {
                position: fixed;
                left: -100%;
                z-index: 1000;
            }
            
            .admin-sidebar.active {
                left: 0;
            }
            
            .mobile-menu-btn {
                display: block;
            }
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="flex">
        {# Sidebar #}
        {% include 'BackOffice/admin/Partials/sidebar.html.twig' %}
        
        {# Main Content #}
        <div class="flex-1 flex flex-col">
            {# Navbar #}
            {% include 'BackOffice/admin/Partials/navbar.html.twig' %}
            
            {# Page Content #}
            <main class="flex-1 p-6">
                <div class="max-w-7xl mx-auto">
                    {% block content %}
<!-- HEADER AVEC BACKGROUND GRADIENT -->
<div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-2xl mb-8 shadow-xl">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-4xl font-bold mb-2">📊 Admin Dashboard</h1>
            <p class="text-blue-100 text-lg opacity-90">Bienvenue ! Voici ce qui se passe sur votre plateforme</p>
        </div>
      
    </div>
</div>

{# Statistiques rapides #}
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="stat-card bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Total Libraries</p>
                <h3 class="text-2xl font-bold text-gray-900">{{ totalLibraries }}</h3>
            </div>
            <span class="material-symbols-outlined text-3xl text-blue-500">library_books</span>
        </div>
    </div>
    
    <div class="stat-card bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Débutant</p>
                <h3 class="text-2xl font-bold text-gray-900">{{ levelDistribution['Débutant'] }}</h3>
                <p class="text-sm text-gray-500">{{ levelPercentages['Débutant'] }}%</p>
            </div>
            <span class="material-symbols-outlined text-3xl text-blue-400">school</span>
        </div>
    </div>
    
    <div class="stat-card bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Intermédiaire</p>
                <h3 class="text-2xl font-bold text-gray-900">{{ levelDistribution['Intermédiaire'] }}</h3>
                <p class="text-sm text-gray-500">{{ levelPercentages['Intermédiaire'] }}%</p>
            </div>
            <span class="material-symbols-outlined text-3xl text-blue-500">trending_up</span>
        </div>
    </div>
    
    <div class="stat-card bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Avancé/Expert</p>
                <h3 class="text-2xl font-bold text-gray-900">
                    {{ levelDistribution['Avancé'] + levelDistribution['Expert'] }}
                </h3>
                <p class="text-sm text-gray-500">
                    {{ levelPercentages['Avancé'] + levelPercentages['Expert'] }}%
                </p>
            </div>
            <span class="material-symbols-outlined text-3xl text-blue-600">star</span>
        </div>
    </div>
</div>

{# Histogramme des niveaux #}
<div class="bg-white rounded-xl shadow-md p-6 mb-8">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-900">📚Distribution des Bibliothèques par Niveau</h2>
        <span class="material-symbols-outlined text-blue-500">bar_chart</span>
    </div>
    <div class="h-80">
        <canvas id="levelChart"></canvas>
    </div>
    <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="text-center">
            <div class="inline-block w-3 h-3 rounded-full bg-blue-400 mr-2"></div>
            <span class="text-sm font-medium">Débutant: {{ levelDistribution['Débutant'] }}</span>
        </div>
        <div class="text-center">
            <div class="inline-block w-3 h-3 rounded-full bg-blue-500 mr-2"></div>
            <span class="text-sm font-medium">Intermédiaire: {{ levelDistribution['Intermédiaire'] }}</span>
        </div>
        <div class="text-center">
            <div class="inline-block w-3 h-3 rounded-full bg-purple-500 mr-2"></div>
            <span class="text-sm font-medium">Avancé: {{ levelDistribution['Avancé'] }}</span>
        </div>
        <div class="text-center">
            <div class="inline-block w-3 h-3 rounded-full bg-red-500 mr-2"></div>
            <span class="text-sm font-medium">Expert: {{ levelDistribution['Expert'] }}</span>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Données du graphique passées depuis le contrôleur
    const chartData = {{ chartData|json_encode|raw }};
    
    // Histogramme
    const levelChartCtx = document.getElementById('levelChart').getContext('2d');
    const levelChart = new Chart(levelChartCtx, {
        type: 'bar',
        data: chartData,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            let label = context.dataset.label || '';
                            if (label) {
                                label += ': ';
                            }
                            const total = {{ totalLibraries }};
                            const value = context.parsed.y;
                            const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                            label += value + ' (' + percentage + '%)';
                            return label;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1,
                        precision: 0
                    },
                    title: {
                        display: true,
                        text: 'Nombre de bibliothèques'
                    }
                },
                x: {
                    title: {
                        display: true,
                        text: 'Niveau'
                    }
                }
            }
        }
    });

    
    
    // Animation au survol des cartes
    document.querySelectorAll('.stat-card').forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px)';
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
        });
    });
});
</script>
{# Top 5 des Bibliothèques les plus fournies - Version améliorée #}
<div class="bg-white rounded-xl shadow-md p-6 mb-8">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-900">📖 Bibliothèques les plus fournies</h2>
        <span class="material-symbols-outlined text-blue-500">trending_up</span>
    </div>
    
    {% if topLibraries is not empty %}
        <div class="space-y-6">
            {% for library in topLibraries %}
                <div class="bg-gradient-to-r from-blue-50 to-white p-4 rounded-xl border border-blue-100 hover:border-blue-200 transition-all hover:shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center space-x-3">
                            <div class="flex-shrink-0">
                                <span class="flex items-center justify-center w-10 h-10 rounded-full 
                                    {% if library.position == 1 %}bg-gradient-to-br from-yellow-400 to-yellow-500 text-white shadow-md
                                    {% elseif library.position == 2 %}bg-gradient-to-br from-gray-300 to-gray-400 text-white shadow-md
                                    {% elseif library.position == 3 %}bg-gradient-to-br from-orange-400 to-orange-500 text-white shadow-md
                                    {% else %}bg-gradient-to-br from-blue-100 to-blue-200 text-blue-700{% endif %} 
                                    font-bold text-lg">
                                    {{ library.position }}
                                </span>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-gray-900">
                                    {{ library.name }}
                                </h3>
                                <p class="text-sm text-gray-600">
                                    {{ library.resourceCount }} ressources
                                </p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="inline-block px-3 py-1 rounded-full text-sm font-bold 
                                {% if library.position == 1 %}bg-yellow-100 text-yellow-800
                                {% elseif library.position == 2 %}bg-gray-100 text-gray-800
                                {% elseif library.position == 3 %}bg-orange-100 text-orange-800
                                {% else %}bg-blue-100 text-blue-800{% endif %}">
                                {{ library.percentage }}%
                            </span>
                        </div>
                    </div>
                    
                    {# Barre de progression moderne #}
                    <div class="mb-2">
                        <div class="flex justify-between text-sm text-gray-600 mb-1">
                            <span>Progression</span>
                            <span class="font-semibold">{{ library.resourceCount }} / {{ max(topLibraries|column('resourceCount')) }} ressources</span>
                        </div>
                        <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                            <div class="h-full rounded-full 
                                {% if library.position == 1 %}bg-gradient-to-r from-yellow-400 to-yellow-500
                                {% elseif library.position == 2 %}bg-gradient-to-r from-gray-400 to-gray-500
                                {% elseif library.position == 3 %}bg-gradient-to-r from-orange-400 to-orange-500
                                {% else %}bg-gradient-to-r from-blue-400 to-blue-500{% endif %}" 
                                style="width: {{ library.percentage }}%">
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex justify-between items-center mt-4 pt-3 border-t border-gray-100">
                        <div class="text-sm text-gray-500">
                            <span class="material-symbols-outlined align-middle text-sm mr-1">book</span>
                            {{ library.resourceCount }} documents
                        </div>
                        <a href="{{ path('admin_library_show', {'id': library.id}) }}" 
                           class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm">
                            Voir les détails
                            <span class="material-symbols-outlined ml-1 text-base">arrow_forward</span>
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <div class="mt-8 p-4 bg-blue-50 rounded-lg border border-blue-100">
            <div class="flex items-center">
                <span class="material-symbols-outlined text-blue-500 mr-3">info</span>
                <p class="text-sm text-blue-700">
                    Les bibliothèques sont classées par nombre de ressources. Plus la barre est remplie, plus la bibliothèque contient de ressources.
                </p>
            </div>
        </div>
    {% else %}
        <div class="text-center py-12">
            <div class="inline-block p-4 bg-blue-100 rounded-full mb-4">
                <span class="material-symbols-outlined text-4xl text-blue-400">library_books</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-700 mb-2">Aucune ressource disponible</h3>
            <p class="text-gray-500 max-w-md mx-auto">
                Commencez par ajouter des ressources aux bibliothèques pour voir les statistiques.
            </p>
            <a href="{{ path('admin_resource_new') }}" class="inline-flex items-center mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                <span class="material-symbols-outlined mr-2">add</span>
                Ajouter une ressource
            </a>
        </div>
    {% endif %}
</div>

{% endblock %}
                </div>
            </main>
        </div>
    </div>
    
    <script>
        // Mobile sidebar toggle
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
            const sidebar = document.querySelector('.admin-sidebar');
            
            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', function() {
                    sidebar.classList.toggle('active');
                });
            }
            
            // Close sidebar when clicking outside on mobile
            document.addEventListener('click', function(event) {
                if (window.innerWidth <= 768) {
                    if (!sidebar.contains(event.target) && !mobileMenuBtn.contains(event.target)) {
                        sidebar.classList.remove('active');
                    }
                }
            });
        });
    </script>
</body>
</html>