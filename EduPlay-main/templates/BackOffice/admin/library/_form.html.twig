{# templates/BackOffice/admin/library/_form.html.twig #}
{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-6'}}) }}

    {# Nom de la bibliothèque #}
    <div class="mb-6">
        {{ form_label(form.name, "Nom de la bibliothèque", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200'}}) }}
        {{ form_errors(form.name, {'attr': {'class': 'text-red-600 text-sm mt-2'}}) }}
    </div>

    {# Description #}
    <div class="mb-6">
        {{ form_label(form.description, "Description", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 resize-none', 'rows': 4}}) }}
        {{ form_errors(form.description, {'attr': {'class': 'text-red-600 text-sm mt-2'}}) }}
        <p class="text-xs text-gray-500 mt-1">Optionnel - Max 100 caractères</p>
    </div>

    {# Âge minimum et maximum #}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
            {{ form_label(form.minAge, "Âge minimum", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
            {{ form_widget(form.minAge, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200'}}) }}
            {{ form_errors(form.minAge, {'attr': {'class': 'text-red-600 text-sm mt-2'}}) }}
            <p class="text-xs text-gray-500 mt-1">Minimum 3 ans</p>
        </div>
        <div>
            {{ form_label(form.maxAge, "Âge maximum", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
            {{ form_widget(form.maxAge, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200'}}) }}
            {{ form_errors(form.maxAge, {'attr': {'class': 'text-red-600 text-sm mt-2'}}) }}
            <p class="text-xs text-gray-500 mt-1">Maximum 12 ans</p>
        </div>
    </div>

    {# Niveau de difficulté #}
    <div class="mb-6">
        {{ form_label(form.level, "Niveau de difficulté", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.level, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200'}}) }}
        {{ form_errors(form.level, {'attr': {'class': 'text-red-600 text-sm mt-2'}}) }}
    </div>

    {# Thème #}
    <div class="mb-6">
        {{ form_label(form.theme, "Thème/Catégorie", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.theme, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200'}}) }}
        {{ form_errors(form.theme, {'attr': {'class': 'text-red-600 text-sm mt-2'}}) }}
        <p class="text-xs text-gray-500 mt-1">2 à 20 caractères</p>
    </div>

    {# Image de couverture #}
    <div class="mb-6">
        {{ form_label(form.coverImageFile, "Image de couverture", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.coverImageFile, {'attr': {'class': 'w-full px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl hover:border-blue-400 transition-all duration-200 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100'}}) }}
        {{ form_errors(form.coverImageFile, {'attr': {'class': 'text-red-600 text-sm mt-2'}}) }}
        
        {% if library.coverImage is defined and library.coverImage %}
            <div class="mt-4">
                <p class="text-sm text-gray-600 mb-2">Image actuelle :</p>
                <img src="{{ asset('uploads/' ~ library.coverImage) }}" 
                     alt="Image de couverture" 
                     class="w-32 h-32 object-cover rounded-lg border border-gray-200">
            </div>
        {% endif %}
    </div>

    {# Bouton Enregistrer #}
    <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
        <a href="{{ path('admin_library_index') }}" 
           class="px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
            Annuler
        </a>
        {{ form_widget(form.save) }}
    </div>

{{ form_end(form) }}