{% extends 'BackOffice/admin/base_admin.html.twig' %}

{% block title %}Détails : {{ library.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="mb-8">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-800">{{ library.name }}</h1>
                <p class="text-gray-600 mt-2">Détails complets de la Bibliothèque</p>
            </div>
            <div class="flex space-x-3">
                <a href="{{ path('admin_library_edit', {'id': library.id}) }}" 
                   class="inline-flex items-center px-5 py-2.5 border border-blue-300 text-blue-700 font-medium rounded-lg bg-blue-50 hover:bg-blue-100 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    Modifier
                </a>
                <a href="{{ path('admin_library_index') }}" 
                   class="inline-flex items-center px-5 py-2.5 border border-gray-300 text-gray-700 font-medium rounded-lg bg-white hover:bg-gray-50 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Retour
                </a>
            </div>
        </div>
    </div>
    
    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        {% if library.coverImage %}
            <div class="h-64 bg-gradient-to-r from-blue-100 to-indigo-100 relative overflow-hidden">
                <img src="{{ asset('uploads/' ~ library.coverImage) }}" 
                     alt="{{ library.name }}" 
                     class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            </div>
        {% endif %}
        
        <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="md:col-span-2">
                    <div class="mb-8">
                        <h2 class="text-xl font-semibold text-gray-800 mb-4">Description</h2>
                        <div class="prose max-w-none text-gray-600">
                            {{ library.description|nl2br }}
                        </div>
                    </div>
                </div>
                
                <div class="md:col-span-1">
                    <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Informations</h3>
                        
                        <div class="space-y-4">
                            <div>
                                <p class="text-sm text-gray-500 mb-1">Tranche d'âge</p>
                                <p class="font-medium text-gray-800">
                                    <span class="inline-flex items-center">
                                        <svg class="w-4 h-4 mr-1 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        {{ library.minAge }} - {{ library.maxAge }} ans
                                    </span>
                                </p>
                            </div>
                            
                            <div>
                                <p class="text-sm text-gray-500 mb-1">Niveau</p>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                    {{ library.level }}
                                </span>
                            </div>
                            
                            <div>
                                <p class="text-sm text-gray-500 mb-1">Thème</p>
                                <p class="font-medium text-gray-800">{{ library.theme }}</p>
                            </div>
                            
                         
                        </div>
                    </div>
                    
                    <div class="mt-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Actions</h3>
                        <form method="post" 
                              action="{{ path('admin_library_delete', {'id': library.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette library ?');">
                            <input type="hidden" name="_token" 
                                   value="{{ csrf_token('delete' ~ library.id) }}">
                            <button type="submit" 
                                    class="w-full inline-flex items-center justify-center px-4 py-3 border border-red-300 text-red-700 font-medium rounded-lg bg-red-50 hover:bg-red-100 transition-colors">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                Supprimer cette Bibliothèque
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}