{# templates/BackOffice/admin/resource/edit.html.twig #}
{% extends 'BackOffice/admin/base_admin.html.twig' %}

{% block title %}Modifier la Ressource{% endblock %}

{% block content %}
<div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
    <!-- HEADER AVEC BACKGROUND GRADIENT -->
    <div class="px-8 py-10 bg-gradient-to-r from-indigo-500 to-purple-600 text-white">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-4xl font-bold mb-2">✏️ Modifier la ressource</h1>
                <p class="text-indigo-100">Modifiez les informations de « {{ resource.title }} »</p>
            </div>
            <div class="p-3 bg-white/20 rounded-xl backdrop-blur-sm">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- CONTENU DU FORMULAIRE -->
    <div class="p-8">
        <!-- MESSAGES FLASH -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 animate-fade-in-down">
                    <div class="flex items-center p-4 mb-4 rounded-xl border-l-4
                        {% if label == 'success' %}text-green-800 bg-gradient-to-r from-green-50 to-emerald-50 border-green-500
                        {% else %}text-red-800 bg-gradient-to-r from-red-50 to-rose-50 border-red-500{% endif %}">
                        <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 20 20">
                            {% if label == 'success' %}
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00 1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            {% else %}
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            {% endif %}
                        </svg>
                        <div class="font-medium">{{ message }}</div>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- FORMULAIRE -->
        <div class="bg-gradient-to-br from-gray-50 to-white rounded-2xl border border-gray-100 shadow-xl p-6">
            {% include 'BackOffice/admin/resource/_form.html.twig' with {'is_edit': true} %}
        </div>
    </div>
</div>

<style>
@keyframes fade-in-down {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in-down {
    animation: fade-in-down 0.5s ease-out;
}
</style>
{% endblock %}