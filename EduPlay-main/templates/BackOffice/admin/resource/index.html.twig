{# templates/BackOffice/admin/resource/index.html.twig #}
{% extends 'BackOffice/admin/base_admin.html.twig' %}

{% block title %}Gestion des Ressources{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Gestion des Ressources</h1>
            <p class="text-gray-600 mt-2">Liste de toutes les ressources disponibles</p>
        </div>
        <a href="{{ path('admin_resource_new') }}" 
           class="px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">
            + Ajouter une ressource
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-6 p-4 rounded-lg {% if label == 'success' %}bg-green-100 text-green-700 border border-green-200{% else %}bg-red-100 text-red-700 border border-red-200{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- FORMULAIRE DE RECHERCHE ET TRI -->
    <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-4">🔍 Recherche & Filtres</h2>
        
        {{ form_start(searchForm, {'attr': {'class': 'space-y-4'}}) }}
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Recherche globale -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Recherche globale
                </label>
                {{ form_widget(searchForm.keyword, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent',
                        'placeholder': 'Titre, auteur, résumé...'
                    }
                }) }}
            </div>

            <!-- Recherche par titre -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Titre uniquement
                </label>
                {{ form_widget(searchForm.title, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent',
                        'placeholder': 'Rechercher par titre...'
                    }
                }) }}
            </div>

            <!-- Recherche par auteur -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Auteur uniquement
                </label>
                {{ form_widget(searchForm.author, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent',
                        'placeholder': 'Rechercher par auteur...'
                    }
                }) }}
            </div>

            <!-- Tri -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Trier par
                </label>
                {{ form_widget(searchForm.sortBy, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                    }
                }) }}
            </div>
        </div>

        <!-- Recherche par mot-clé dans résumé -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Mot-clé dans résumé
                </label>
                {{ form_widget(searchForm.summaryKeyword, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent',
                        'placeholder': 'Mot-clé dans le résumé...'
                    }
                }) }}
            </div>
            
            <!-- Filtres actifs -->
            <div class="flex items-end">
                {% if activeFilters is defined and activeFilters|length > 0 %}
                    <div class="flex flex-wrap gap-2">
                        <span class="text-sm text-gray-600">Filtres :</span>
                        {% for key, value in activeFilters %}
                            <span class="inline-flex items-center px-3 py-1 bg-blue-100 text-blue-800 text-sm rounded-full">
                                {% if key == 'keyword' %}🌐 "{{ value }}"
                                {% elseif key == 'title' %}📖 "{{ value }}"
                                {% elseif key == 'author' %}👤 "{{ value }}"
                                {% elseif key == 'summaryKeyword' %}💬 "{{ value }}"
                                {% else %}{{ key }}: {{ value }}
                                {% endif %}
                            </span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Boutons -->
        <div class="flex justify-between items-center pt-4 border-t border-gray-200">
            <div class="text-sm text-gray-600">
                {{ resources|length }} ressource{{ resources|length > 1 ? 's' : '' }} trouvée{{ resources|length > 1 ? 's' : '' }}
            </div>
            
            <div class="flex space-x-3">
                {{ form_widget(searchForm.reset, {
                    'attr': {
                        'class': 'px-5 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50'
                    }
                }) }}
                
                {{ form_widget(searchForm.search, {
                    'attr': {
                        'class': 'px-5 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700'
                    }
                }) }}
            </div>
        </div>
        
        {{ form_end(searchForm) }}
    </div>

    <!-- TABLEAU DES RESSOURCES -->
    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Titre</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Auteur</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Langue</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Âge</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bibliothèque</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for resource in resources %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ resource.id }}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                {% if resource.coverImage %}
                                    <img src="{{ asset('uploads/' ~ resource.coverImage) }}" 
                                         alt="Couverture" 
                                         class="w-10 h-10 rounded-lg object-cover mr-3">
                                {% endif %}
                                <div>
                                    <div class="font-medium text-gray-900">{{ resource.title }}</div>
                                    {% if resource.summary %}
                                        <div class="text-sm text-gray-500 truncate max-w-xs">{{ resource.summary|slice(0, 50) }}...</div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ resource.author }}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                {% if resource.type == 'Livre' %}bg-blue-100 text-blue-800
                                {% elseif resource.type == 'Magazine' %}bg-green-100 text-green-800
                                {% elseif resource.type == 'Journal' %}bg-yellow-100 text-yellow-800
                                {% else %}bg-gray-100 text-gray-800{% endif %}">
                                {{ resource.type }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ resource.language }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ resource.minAge }} - {{ resource.maxAge }} ans</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                            {% if resource.libraryId %}
                                <span class="px-2 py-1 bg-gray-100 text-gray-800 rounded-lg text-xs">
                                    {{ resource.libraryId.name }}
                                </span>
                            {% else %}
                                <span class="text-gray-400 text-xs">Non spécifiée</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <div class="flex space-x-3">
                                <a href="{{ path('admin_resource_show', {'id': resource.id}) }}" 
                                   class="text-blue-600 hover:text-blue-900" title="Voir les détails">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </a>
                                <a href="{{ path('admin_resource_edit', {'id': resource.id}) }}" 
                                   class="text-green-600 hover:text-green-900" title="Modifier">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                                <form method="post" action="{{ path('admin_resource_delete', {'id': resource.id}) }}" 
                                      class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette ressource ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ resource.id) }}">
                                    <button type="submit" class="text-red-600 hover:text-red-900" title="Supprimer">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                                {% if resource.pdfFile %}
                                    <a href="{{ asset('pdfs/' ~ resource.pdfFile) }}" 
                                       target="_blank" 
                                       class="text-indigo-600 hover:text-indigo-900" title="Télécharger PDF">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                    </a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-4 text-center text-gray-500">
                            {% if activeFilters is defined and activeFilters|length > 0 %}
                                Aucune ressource ne correspond à vos critères de recherche.
                            {% else %}
                                Aucune ressource trouvée.
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}