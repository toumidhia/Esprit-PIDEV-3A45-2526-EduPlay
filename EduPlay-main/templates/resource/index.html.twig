                        <button class="size-12 rounded-full text-[#617989] font-bold hover:bg-[#f0f3f4] dark:hover:bg-[#2a3a46]">2</button>
                        <button class="size-12 rounded-full text-[#617989] font-bold hover:bg-[#f0f3f4] dark:hover:bg-[#2a3a46]">3</button>
