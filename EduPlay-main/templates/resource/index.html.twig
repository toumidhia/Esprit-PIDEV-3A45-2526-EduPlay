                    </div>
                    <h2 class="text-2xl font-extrabold tracking-tight text-primary">EduPlay</h2>
                </div>
                <nav class="hidden md:flex items-center gap-6">
                    <a class="text-sm font-bold text-primary border-b-2 border-primary pb-1" href="#">Libraries</a>
                    <a class="text-sm font-semibold text-[#617989] hover:text-primary transition-colors" href="#">Achievements</a>
