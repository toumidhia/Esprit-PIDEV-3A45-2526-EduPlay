<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPlay - Administration{% endblock %}</title>

    {# Bootstrap 5 CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Bootstrap Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    {# Tailwind CSS - Pour supporter les classes de votre index #}
    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@400&display=swap" rel="stylesheet">
    <style>
    .material-symbols-outlined{
        font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
    }
    </style>

    {% block stylesheets %}
        <style>
            :root {
                --sidebar-width: 250px;
                --navbar-height: 64px;
                --primary-color: #63b7f2;
                --secondary-color: #6c757d;
                --success-color: #28a745;
                --danger-color: #dc3545;
                --warning-color: #ffc107;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
                overflow-x: hidden;
                padding-top: var(--navbar-height);
            }

            /* Sidebar Styles - Ajustée pour la navbar fixed */
            .sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 100;
                padding: 0;
                box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
                background-color: #2c3e50;
                width: var(--sidebar-width);
                height: 100vh;
                overflow-y: auto;
            }

            .sidebar-sticky {
                padding-top: calc(var(--navbar-height) + 0.5rem);
                padding-bottom: 1rem;
                overflow-x: hidden;
                overflow-y: auto;
            }

            .sidebar .nav-link {
                color: #e0e0e0;
                padding: 12px 20px;
                font-weight: 500;
                transition: all 0.3s;
            }

            .sidebar .nav-link:hover {
                color: #fff;
                background-color: rgba(255, 255, 255, 0.1);
            }

            .sidebar .nav-link.active {
                color: #fff;
                background-color: var(--primary-color);
            }

            .sidebar .nav-link i {
                margin-right: 10px;
            }

            .sidebar-heading {
                font-size: .75rem;
                text-transform: uppercase;
                padding: 20px 20px 10px;
                color: #a0a0a0;
                font-weight: 600;
            }

            /* Main Content - Ajusté pour la navbar fixed */
            main {
                margin-left: var(--sidebar-width);
                padding: 20px;
                min-height: calc(100vh - var(--navbar-height));
            }

            /* Cards */
            .card {
                border: none;
                box-shadow: 0 0 10px rgba(0,0,0,.05);
                margin-bottom: 20px;
            }

            .card-header {
                background-color: #fff;
                border-bottom: 2px solid #f8f9fa;
                font-weight: 600;
            }

            /* Badges */
            .badge-status-pending {
                background-color: #ffc107;
                color: #000;
            }

            .badge-status-accepted {
                background-color: #28a745;
            }

            .badge-status-rejected {
                background-color: #dc3545;
            }

            /* Forms */
            .form-error {
                color: #dc3545;
                font-size: 0.875rem;
                margin-top: 0.25rem;
            }

            .form-control.is-invalid {
                border-color: #dc3545;
            }

            /* Stat Cards */
            .stat-card {
                border-left: 4px solid;
                transition: transform 0.2s;
            }

            .stat-card:hover {
                transform: translateY(-3px);
            }

            .stat-card.primary {
                border-left-color: var(--primary-color);
            }

            .stat-card.success {
                border-left-color: var(--success-color);
            }

            .stat-card.warning {
                border-left-color: var(--warning-color);
            }

            .stat-card.danger {
                border-left-color: var(--danger-color);
            }

            /* Buttons */
            .btn-primary {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
            }

            .btn-primary:hover {
                background-color: #4a9fd6;
                border-color: #4a9fd6;
            }

            /* Table */
            .table thead th {
                border-bottom: 2px solid #dee2e6;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.875rem;
                color: #6c757d;
            }

            /* Search Bar */
            .search-wrapper {
                position: relative;
            }

            .search-wrapper i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
            }

            .search-wrapper input {
                padding-left: 40px;
            }

            /* Logo */
            .sidebar-brand {
                padding: 20px;
                background-color: rgba(0, 0, 0, 0.2);
                color: #fff;
                font-size: 1.5rem;
                font-weight: bold;
                text-align: center;
                position: sticky;
                top: 0;
                z-index: 101;
            }

            .sidebar-brand span {
                color: var(--primary-color);
            }

            /* User avatar */
            .user-avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: bold;
            }

            .bg-admin { background-color: #dc3545; }
            .bg-enseignant { background-color: #28a745; }
            .bg-parent { background-color: #ffc107; color: #000; }
            .bg-enfant { background-color: #17a2b8; }

            /* Animations pour supporter votre index */
            @keyframes fade-in-down {
                from {
                    opacity: 0;
                    transform: translateY(-10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .animate-fade-in-down {
                animation: fade-in-down 0.5s ease-out;
            }

            @keyframes fade-in {
                from {
                    opacity: 0;
                }
                to {
                    opacity: 1;
                }
            }

            .animate-fade-in {
                animation: fade-in 0.8s ease-out;
            }

            /* Classes Tailwind personnalisées si nécessaire */
            .line-clamp-2 {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            /* Pour éviter les débordements */
            .min-w-0 {
                min-width: 0;
            }
            
            .truncate {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            /* Ajustement pour les flash messages */
            .flash-messages {
                margin-top: 0;
            }

            /* Scrollbar personnalisée */
            ::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f1f1;
            }

            ::-webkit-scrollbar-thumb {
                background: #c1c1c1;
                border-radius: 4px;
            }

            ::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }
        </style>
    {% endblock %}
</head>
<body class="antialiased">

{# Include Sidebar #}
{% include 'BackOffice/admin/Partials/sidebar.html.twig' %}

{# Include Navbar - MAINTENANT FIXED #}
{% include 'BackOffice/admin/Partials/navbar.html.twig' %}

{# Main Content #}
<main>
    {# Flash Messages - Adaptés au design de l'index #}
    <div class="flash-messages">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 animate-fade-in-down">
                    <div class="flex items-center p-4 mb-4 {% if label == 'success' %}text-green-800 bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500{% elseif label == 'error' or label == 'danger' %}text-red-800 bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500{% else %}text-blue-800 bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500{% endif %} rounded-xl" role="alert">
                        {% if label == 'success' %}
                            <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                        {% elseif label == 'error' or label == 'danger' %}
                            <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            </svg>
                        {% else %}
                            <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                        {% endif %}
                        <div class="font-medium">{{ message }}</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    {% block content %}{% endblock %}
</main>

{# Bootstrap 5 JS Bundle #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>