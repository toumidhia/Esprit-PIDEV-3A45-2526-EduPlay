{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Détection d'anomalies{% endblock %}

{% block content %}
    <h1 class="text-3xl font-extrabold mb-8">Détection d'anomalies</h1>
    <p class="text-[#617989] mb-8">Système de détection automatique des anomalies dans les commandes, produits et utilisateurs.</p>

    {# Anomalies dans les commandes #}
    <div class="mb-8">
        <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-red-600">shopping_cart</span>
            Anomalies dans les commandes ({{ anomalies.commandes|length }})
        </h2>
        {% if anomalies.commandes is not empty %}
            <div class="space-y-4">
                {% for anomaly in anomalies.commandes %}
                    <div class="bg-white rounded-xl border border-red-200 p-6">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h3 class="font-bold text-lg">Commande #{{ anomaly.commande.id }}</h3>
                                <p class="text-sm text-[#617989]">
                                    Utilisateur: {{ anomaly.commande.user.firstName }} {{ anomaly.commande.user.lastName }} |
                                    Produit: {{ anomaly.commande.product.name }} |
                                    Date: {{ anomaly.commande.dateCommande|date('d/m/Y') }}
                                </p>
                            </div>
                            <a href="{{ path('app_back_commande_show', { id: anomaly.commande.id }) }}" class="text-primary hover:underline text-sm font-medium">Voir →</a>
                        </div>
                        <div class="space-y-2">
                            {% for issue in anomaly.issues %}
                                <div class="flex items-start gap-2 p-3 rounded-lg {{ issue.severity == 'high' ? 'bg-red-50 border border-red-200' : (issue.severity == 'medium' ? 'bg-yellow-50 border border-yellow-200' : 'bg-gray-50 border border-gray-200') }}">
                                    <span class="material-symbols-outlined text-sm {{ issue.severity == 'high' ? 'text-red-600' : (issue.severity == 'medium' ? 'text-yellow-600' : 'text-gray-600') }}">
                                        {{ issue.severity == 'high' ? 'error' : (issue.severity == 'medium' ? 'warning' : 'info') }}
                                    </span>
                                    <span class="text-sm {{ issue.severity == 'high' ? 'text-red-800' : (issue.severity == 'medium' ? 'text-yellow-800' : 'text-gray-800') }}">
                                        {{ issue.message }}
                                    </span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
                <span class="material-symbols-outlined text-green-600 text-4xl mb-2">check_circle</span>
                <p class="text-green-800 font-medium">Aucune anomalie détectée dans les commandes.</p>
            </div>
        {% endif %}
    </div>

    {# Anomalies dans les produits #}
    <div class="mb-8">
        <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-orange-600">inventory_2</span>
            Anomalies dans les produits ({{ anomalies.produits|length }})
        </h2>
        {% if anomalies.produits is not empty %}
            <div class="space-y-4">
                {% for anomaly in anomalies.produits %}
                    <div class="bg-white rounded-xl border border-orange-200 p-6">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h3 class="font-bold text-lg">{{ anomaly.product.name }}</h3>
                                <p class="text-sm text-[#617989]">Prix: {{ anomaly.product.price|number_format(2, ',', ' ') }} €</p>
                            </div>
                            <a href="{{ path('app_back_product_show', { id: anomaly.product.id }) }}" class="text-primary hover:underline text-sm font-medium">Voir →</a>
                        </div>
                        <div class="space-y-2">
                            {% for issue in anomaly.issues %}
                                <div class="flex items-start gap-2 p-3 rounded-lg {{ issue.severity == 'high' ? 'bg-red-50 border border-red-200' : (issue.severity == 'medium' ? 'bg-yellow-50 border border-yellow-200' : 'bg-gray-50 border border-gray-200') }}">
                                    <span class="material-symbols-outlined text-sm {{ issue.severity == 'high' ? 'text-red-600' : (issue.severity == 'medium' ? 'text-yellow-600' : 'text-gray-600') }}">
                                        {{ issue.severity == 'high' ? 'error' : (issue.severity == 'medium' ? 'warning' : 'info') }}
                                    </span>
                                    <span class="text-sm {{ issue.severity == 'high' ? 'text-red-800' : (issue.severity == 'medium' ? 'text-yellow-800' : 'text-gray-800') }}">
                                        {{ issue.message }}
                                    </span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
                <span class="material-symbols-outlined text-green-600 text-4xl mb-2">check_circle</span>
                <p class="text-green-800 font-medium">Aucune anomalie détectée dans les produits.</p>
            </div>
        {% endif %}
    </div>

    {# Anomalies dans les utilisateurs #}
    <div class="mb-8">
        <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-purple-600">group</span>
            Anomalies dans les utilisateurs ({{ anomalies.utilisateurs|length }})
        </h2>
        {% if anomalies.utilisateurs is not empty %}
            <div class="space-y-4">
                {% for anomaly in anomalies.utilisateurs %}
                    <div class="bg-white rounded-xl border border-purple-200 p-6">
                        <div class="mb-3">
                            <h3 class="font-bold text-lg">{{ anomaly.user.firstName }} {{ anomaly.user.lastName }}</h3>
                            <p class="text-sm text-[#617989]">Email: {{ anomaly.user.email }}</p>
                        </div>
                        <div class="space-y-2">
                            {% for issue in anomaly.issues %}
                                <div class="flex items-start gap-2 p-3 rounded-lg bg-yellow-50 border border-yellow-200">
                                    <span class="material-symbols-outlined text-sm text-yellow-600">warning</span>
                                    <span class="text-sm text-yellow-800">{{ issue.message }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
                <span class="material-symbols-outlined text-green-600 text-4xl mb-2">check_circle</span>
                <p class="text-green-800 font-medium">Aucune anomalie détectée dans les utilisateurs.</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
