{% extends 'base.html.twig' %}

{% block title %}Admin - EduPlay{% endblock %}

{% block body %}
<div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-6">
    <aside class="bg-white dark:bg-white/5 joyful-shadow rounded-lg p-5 h-fit">
        <h3 class="font-extrabold text-lg mb-4">Admin</h3>

        <div class="space-y-2">
            <a href="{{ path('admin_event_index') }}" class="block px-4 py-3 rounded-lg hover:bg-black/5 dark:hover:bg-white/5">
                📅 Gestion des événements
            </a>
            <a href="{{ path('admin_event_stats') }}" class="block px-4 py-3 rounded-lg hover:bg-black/5 dark:hover:bg-white/5">
                📊 Statistiques
            </a>
            <a href="{{ path('front_event_index') }}" class="block px-4 py-3 rounded-lg hover:bg-black/5 dark:hover:bg-white/5">
                🏠 Voir Front
            </a>
        </div>
    </aside>

    <section>
        {% for message in app.flashes('success') %}
            <div class="mb-4 p-4 rounded-lg bg-white dark:bg-white/5 joyful-shadow">
                ✅ {{ message }}
            </div>
        {% endfor %}

        {% block admin_content %}{% endblock %}
    </section>
</div>
{% endblock %}
