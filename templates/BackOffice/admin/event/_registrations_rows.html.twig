{% for r in registrations %}
  {% set st = (r.status ?: 'PENDING')|upper %}
  {% set badge = 'bg-yellow-50 text-yellow-700 border border-yellow-200' %}
  {% if st == 'APPROVED' %}{% set badge = 'bg-green-50 text-green-700 border border-green-200' %}{% endif %}
  {% if st == 'CANCELLED' %}{% set badge = 'bg-red-50 text-red-700 border border-red-200' %}{% endif %}

  <tr class="hover:bg-indigo-50/40 transition">
    <td class="p-4 font-extrabold text-gray-900">{{ r.childFullName ?: '—' }}</td>
    <td class="p-4">
      <div class="font-bold text-gray-900">
        {% if r.parent %}{{ r.parent.firstName ~ ' ' ~ r.parent.lastName }}{% else %}—{% endif %}
      </div>
      <div class="text-sm text-gray-500 font-semibold">
        {{ r.parent ? r.parent.email : '—' }}
      </div>
    </td>
    <td class="p-4 font-bold text-gray-800">{{ r.parentPhone ?: '—' }}</td>
    <td class="p-4">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold bg-indigo-50 text-indigo-700 border border-indigo-100">
        {{ r.childClassLevel ?: '—' }}
      </span>
    </td>
    <td class="p-4">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold {{ badge }}">
        {{ st }}
      </span>
    </td>
    <td class="p-4 font-semibold text-gray-700">
      {{ r.registeredAt ? r.registeredAt|date('d/m/Y H:i') : '—' }}
    </td>
  </tr>
{% else %}
  <tr>
    <td colspan="6" class="p-6 text-center font-bold text-gray-500">
      Aucune inscription trouvée.
    </td>
  </tr>
{% endfor %}