{% for e in events %}
  <tr class="border-t border-gray-200">
    <td class="p-4 font-bold">{{ e.title }}</td>
    <td class="p-4">{{ e.startDate|date('d/m/Y H:i') }}</td>
    <td class="p-4">{{ e.endDate|date('d/m/Y H:i') }}</td>

    <td class="p-4">
      <div class="flex flex-wrap gap-2">
        <a class="px-4 py-2 rounded-xl bg-white border border-gray-200 font-bold hover:bg-gray-50"
           href="{{ path('admin_event_show', {id: e.id}) }}">
          Voir
        </a>

        <a class="px-4 py-2 rounded-xl bg-white border border-gray-200 font-bold hover:bg-gray-50"
           href="{{ path('admin_event_resource_index', {id: e.id}) }}">
          Ressources
        </a>

        <a class="px-4 py-2 rounded-xl bg-blue-600 text-white font-bold hover:bg-blue-700"
           href="{{ path('admin_event_edit', {id: e.id}) }}">
          Modifier
        </a>

        <form method="post"
              action="{{ path('admin_event_delete', {id: e.id}) }}"
              onsubmit="return confirm('Supprimer cet événement ?');">
          <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ e.id) }}">
          <button class="px-4 py-2 rounded-xl bg-red-50 text-red-700 border border-red-200 font-bold hover:bg-red-100" type="submit">
            Supprimer
          </button>
        </form>
      </div>
    </td>
  </tr>
{% else %}
  <tr>
    <td class="p-6 font-bold" colspan="4">Aucun événement.</td>
  </tr>
{% endfor %}