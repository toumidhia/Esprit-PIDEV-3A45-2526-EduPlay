{# templates/BackOffice/admin/event/calendar.html.twig #}
{% extends 'BackOffice/admin/Partials/container.html.twig' %}

{% block title %}Calendrier des événements{% endblock %}

{% block content %}
<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

  {# ===== HEADER ===== #}
  <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
      <div>
        <h1 class="text-4xl font-extrabold mb-2">📅 Calendrier des événements</h1>
        <p class="text-blue-100 font-medium">Vue globale de tous les événements EduPlay.</p>
      </div>
      <a href="{{ path('admin_event_index') }}"
         class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-extrabold rounded-xl hover:bg-white/30 transition-all border border-white/30">
        <span class="material-symbols-outlined mr-2 text-base">arrow_back</span>
        Retour
      </a>
    </div>
  </div>

  {# ===== LÉGENDE ===== #}
  <div class="px-6 pt-4 flex gap-4">
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 rounded-full bg-indigo-600"></div>
      <span class="text-sm font-medium text-gray-600">À venir</span>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 rounded-full bg-gray-400"></div>
      <span class="text-sm font-medium text-gray-600">Passé</span>
    </div>
  </div>

  {# ===== CALENDRIER ===== #}
  <div class="p-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
      <div id="calendar"></div>
    </div>
  </div>

</div>

{# ===== FULLCALENDAR ===== #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales/fr.global.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const calendarEl = document.getElementById('calendar');
  const calendar = new FullCalendar.Calendar(calendarEl, {
    locale: 'fr',
    initialView: 'dayGridMonth',
    headerToolbar: {
      left: 'prev,next today',
      center: 'title',
      right: 'dayGridMonth,timeGridWeek,listWeek'
    },
    events: '{{ path('admin_event_calendar_load') }}',
    eventClick: function(info) {
      if (info.event.url) {
        info.jsEvent.preventDefault();
        window.location.href = info.event.url;
      }
    },
    eventDidMount: function(info) {
      // Ajouter un tooltip au survol
      info.el.title = info.event.title + '\n' + (info.event.extendedProps.location || '');
    },
    loading: function(isLoading) {
      if (!isLoading) {
        console.log('Événements chargés avec succès');
      }
    }
  });
  calendar.render();
});
</script>
{% endblock %}