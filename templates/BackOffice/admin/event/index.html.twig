{% extends 'BackOffice/admin/base.html.twig' %}

{% block title %}Admin - Événements{% endblock %}

{% block admin_content %}
<div class="flex items-end justify-between mb-6">
    <div>
        <h1 class="text-3xl font-extrabold">Gestion des événements</h1>
        <p class="text-[#617989] dark:text-gray-400 font-medium mt-1">Créer, modifier, supprimer des événements.</p>
    </div>

    <a href="{{ path('admin_event_new') }}"
       class="px-5 py-3 rounded-full bg-primary text-white font-extrabold hover:scale-105 transition-transform">
        + Nouvel événement
    </a>
</div>

<div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-xl overflow-hidden">
    <table class="w-full text-left">
        <thead class="bg-black/5 dark:bg-white/5">
        <tr>
            <th class="p-4 font-extrabold">Titre</th>
            <th class="p-4 font-extrabold">Début</th>
            <th class="p-4 font-extrabold">Fin</th>
            <th class="p-4 font-extrabold">Actions</th>
        </tr>
        </thead>

        <tbody>
        {% for e in events %}
            <tr class="border-t border-[#dbe1e6] dark:border-gray-800">
                <td class="p-4 font-bold">{{ e.title }}</td>
                <td class="p-4">{{ e.startDate|date('d/m/Y H:i') }}</td>
                <td class="p-4">{{ e.endDate|date('d/m/Y H:i') }}</td>

                <td class="p-4">
                    <div class="flex flex-wrap gap-2">
                        {# OPTIONNEL: seulement si tu ajoutes une route show #}
                        <a class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 font-bold"
                           href="{{ path('admin_event_show', {id: e.id}) }}">
                            Voir
                        </a>

                        <a class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 font-bold"
                            href="{{ path('admin_event_resource_index', {id: e.id}) }}">
                            Ressource
                        </a>


                        <a class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 font-bold"
                           href="{{ path('admin_event_edit', {id: e.id}) }}">
                            Modifier
                        </a>

                        <form method="post"
                              action="{{ path('admin_event_delete', {id: e.id}) }}"
                              onsubmit="return confirm('Supprimer cet événement ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ e.id) }}">
                            <button class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 font-bold" type="submit">
                                Supprimer
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td class="p-6 font-bold" colspan="4">Aucun événement.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
