{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Nouvel événement{% endblock %}

{% block content %}
<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

  {# ===== HEADER GRADIENT ===== #}
  <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
      <div>
        <h1 class="text-4xl font-extrabold mb-2">✨ Créer un événement</h1>
        <p class="text-blue-100 font-medium">Remplis le formulaire pour ajouter un nouvel événement.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="{{ path('admin_event_index') }}"
           class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-extrabold rounded-xl hover:bg-white/30 transition-all border border-white/30">
          <span class="material-symbols-outlined mr-2 text-base">arrow_back</span>
          Retour
        </a>
      </div>
    </div>
  </div>

  {# ===== FORM ===== #}
  <div class="p-6">
    <div class="rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50 p-6 shadow-sm">
      {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
      {{ form_errors(form) }}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        {# ===== TITRE ===== #}
        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-indigo-600">title</span>
            <label class="font-extrabold text-gray-900">Titre</label>
          </div>
          {{ form_widget(form.title, { 'attr': { 'class': 'w-full border border-gray-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400', 'placeholder': 'Ex: Sortie au musée' } }) }}
          {{ form_errors(form.title) }}
        </div>

        {# ===== CAPACITÉ ===== #}
        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-indigo-600">groups</span>
            <label class="font-extrabold text-gray-900">Capacité (places)</label>
          </div>
          {{ form_widget(form.capacity, { 'attr': { 'class': 'w-full border border-gray-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400', 'min': '1', 'placeholder': 'Ex: 30' } }) }}
          {{ form_errors(form.capacity) }}
          <p class="text-xs text-gray-400 mt-1">💡 Nombre maximum d’inscriptions autorisées.</p>
        </div>

        {# ===== LIEU + GEOCODAGE ===== #}
        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm md:col-span-2">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-indigo-600">place</span>
            <label class="font-extrabold text-gray-900">Lieu</label>
          </div>
          {{ form_widget(form.location, { 'attr': { 'id': 'school_event_location', 'class': 'w-full border border-gray-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400', 'placeholder': 'Ex: Tunis, Tunisie', 'autocomplete': 'off' } }) }}
          {{ form_errors(form.location) }}
          {{ form_widget(form.latitude) }}
          {{ form_widget(form.longitude) }}
          <p class="text-xs text-gray-400 mt-1">💡 Tape une adresse et quitte le champ pour afficher la carte.</p>
        </div>

        {# ===== DATE DÉBUT ===== #}
        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-indigo-600">event</span>
            <label class="font-extrabold text-gray-900">Date début</label>
          </div>
          {{ form_widget(form.startDate, { 'attr': { 'class': 'w-full border border-gray-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400' } }) }}
          {{ form_errors(form.startDate) }}
        </div>

        {# ===== DATE FIN ===== #}
        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-indigo-600">schedule</span>
            <label class="font-extrabold text-gray-900">Date fin</label>
          </div>
          {{ form_widget(form.endDate, { 'attr': { 'class': 'w-full border border-gray-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400' } }) }}
          {{ form_errors(form.endDate) }}
        </div>

        {# ===== DESCRIPTION ===== #}
        <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-indigo-600">description</span>
            <label class="font-extrabold text-gray-900">Description</label>
          </div>
          {{ form_widget(form.description, { 'attr': { 'class': 'w-full border border-gray-300 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400', 'rows': '4', 'placeholder': 'Décris l\'événement...' } }) }}
          {{ form_errors(form.description) }}
        </div>

        {# ===== IMAGE ===== #}
        <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-indigo-600">image</span>
            <label class="font-extrabold text-gray-900">Image</label>
          </div>
          {{ form_widget(form.imageFile, { 'attr': { 'class': 'w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100' } }) }}
          {{ form_errors(form.imageFile) }}
        </div>

        {# ===== CARTE PREVIEW ===== #}
        <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm" id="map-container" style="display:none;">
          <div class="flex items-center gap-2 mb-3">
            <span class="material-symbols-outlined text-indigo-600">map</span>
            <div class="font-extrabold text-gray-900">Localisation sur la carte</div>
          </div>
          <div id="map-preview" style="height: 300px; border-radius: 12px;"></div>
        </div>

      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <button type="submit"
                class="inline-flex items-center px-6 py-3 rounded-xl bg-blue-600 text-white font-extrabold hover:bg-blue-700 transition shadow-sm">
          <span class="material-symbols-outlined mr-2 text-base">save</span>
          Enregistrer
        </button>
        <a href="{{ path('admin_event_index') }}"
           class="inline-flex items-center px-6 py-3 rounded-xl bg-white text-gray-800 font-extrabold border border-gray-200 hover:bg-gray-50 transition">
          Annuler
        </a>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>

{# ===== LEAFLET ===== #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
let map = null;
let marker = null;

function showMap(lat, lon) {
  const container = document.getElementById('map-container');
  const mapDiv = document.getElementById('map-preview');
  container.style.display = 'block';

  if (map) {
    marker.setLatLng([lat, lon]);
    map.setView([lat, lon], 15);
    map.invalidateSize();
    return;
  }

  const observer = new ResizeObserver(() => {
    if (mapDiv.offsetWidth > 0 && !map) {
      observer.disconnect();
      map = L.map(mapDiv).setView([lat, lon], 15);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap', maxZoom: 19
      }).addTo(map);
      marker = L.marker([lat, lon], { draggable: true }).addTo(map);
      map.invalidateSize();

      map.on('click', function(e) {
        marker.setLatLng([e.latlng.lat, e.latlng.lng]);
        updateFields(e.latlng.lat, e.latlng.lng);
        reverseGeocode(e.latlng.lat, e.latlng.lng);
      });

      marker.on('dragend', function() {
        const pos = marker.getLatLng();
        updateFields(pos.lat, pos.lng);
        reverseGeocode(pos.lat, pos.lng);
      });
    }
  });
  observer.observe(mapDiv);
}

function updateFields(lat, lng) {
  const latEl = document.getElementById('school_event_latitude');
  const lngEl = document.getElementById('school_event_longitude');
  if (latEl) latEl.value = lat.toFixed(7);
  if (lngEl) lngEl.value = lng.toFixed(7);
}

function reverseGeocode(lat, lng) {
  fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
    .then(r => r.json())
    .then(data => {
      if (data.display_name) {
        const locEl = document.getElementById('school_event_location');
        if (locEl) locEl.value = data.display_name;
      }
    });
}

const locInput = document.getElementById('school_event_location');
if (locInput) {
  locInput.addEventListener('change', function () {
    const address = this.value.trim();
    if (!address) return;
    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=1`)
      .then(r => r.json())
      .then(data => {
        if (!data.length) { alert('Adresse introuvable, sois plus précis.'); return; }
        updateFields(parseFloat(data[0].lat), parseFloat(data[0].lon));
        showMap(parseFloat(data[0].lat), parseFloat(data[0].lon));
      })
      .catch(() => alert('Erreur réseau.'));
  });
}
</script>
{% endblock %}