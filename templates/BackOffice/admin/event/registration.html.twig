{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}
  {% if event is defined %}
    Inscriptions - {{ event.title }}
  {% else %}
    Inscriptions - Événements
  {% endif %}
{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">

  {# HEADER #}
  <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-t-2xl">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
      <div>
        {% if event is defined %}
          <h1 class="text-4xl font-bold mb-2">🧾 Inscriptions</h1>
          <p class="text-blue-100">Événement : <b>{{ event.title }}</b></p>
        {% else %}
          <h1 class="text-4xl font-bold mb-2">🧾 Inscriptions par événement</h1>
          <p class="text-blue-100">Choisis un événement pour voir les inscrits.</p>
        {% endif %}
      </div>

      <div class="flex flex-wrap gap-3">
        <a href="{{ path('admin_scan_index') }}"
           class="inline-flex items-center px-6 py-3 bg-green-500 text-white font-extrabold rounded-xl hover:bg-green-600 transition-all duration-300 shadow-sm">
          <span class="material-symbols-outlined mr-2 text-base">qr_code_scanner</span>
          Scanner tickets
        </a>

        {% if event is defined %}
          <a href="{{ path('admin_event_registrations_events') }}"
             class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-semibold rounded-xl hover:bg-white/30 transition-all duration-300 border border-white/30">
            <span class="material-symbols-outlined mr-2 text-base">arrow_back</span>
            Tous les événements
          </a>
        {% endif %}

        <a href="{{ path('admin_event_index') }}"
           class="inline-flex items-center px-6 py-3 bg-white text-indigo-700 font-extrabold rounded-xl hover:bg-indigo-50 transition-all duration-300 shadow-sm">
          <span class="material-symbols-outlined mr-2 text-base">calendar_month</span>
          Événements
        </a>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-b-2xl shadow-lg border border-gray-100 p-6">

    {# SEARCH + TRI (mode liste events seulement) #}
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center">
          <span class="material-symbols-outlined text-indigo-600">search</span>
        </div>
        <div>
          <div class="text-xl font-extrabold text-gray-900">
            {% if event is defined %}Rechercher dans les inscriptions{% else %}Rechercher un événement{% endif %}
          </div>
          <div class="text-sm text-gray-500 font-semibold">
            {% if event is defined %}Enfant / téléphone / contact{% else %}Titre / lieu{% endif %}
          </div>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-3 w-full lg:w-auto">

        {# ✅ champ recherche (AJAX) #}
        <div class="relative w-full md:w-96">
          <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-sm">search</span>
          <input
            id="liveSearch"
            value="{{ q|default('') }}"
            class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
            placeholder="{% if event is defined %}Rechercher (enfant, tel...){% else %}Rechercher (titre, lieu...){% endif %}">
        </div>

        {# ✅ TRI (uniquement sur la liste des events) #}
        {% if event is not defined %}
          {% set currentSort = sort|default('startDate') %}
          {% set currentOrder = order|default('desc') %}

          <div class="flex flex-wrap gap-2">
            {% set nextOrderStart = (currentSort == 'startDate' and currentOrder == 'asc') ? 'desc' : 'asc' %}
            {% set nextOrderEnd = (currentSort == 'endDate' and currentOrder == 'asc') ? 'desc' : 'asc' %}
            {% set nextOrderCount = (currentSort == 'regCount' and currentOrder == 'asc') ? 'desc' : 'asc' %}

            <a href="{{ path('admin_event_registrations_events', { q: q|default(''), sort: 'startDate', order: nextOrderStart, page: 1 }) }}"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 hover:bg-gray-100 font-extrabold text-sm">
              <span class="material-symbols-outlined text-base">schedule</span>
              Début
              {% if currentSort == 'startDate' %}
                <span class="text-xs font-black text-indigo-700">({{ currentOrder|upper }})</span>
              {% endif %}
            </a>

            <a href="{{ path('admin_event_registrations_events', { q: q|default(''), sort: 'endDate', order: nextOrderEnd, page: 1 }) }}"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 hover:bg-gray-100 font-extrabold text-sm">
              <span class="material-symbols-outlined text-base">event</span>
              Fin
              {% if currentSort == 'endDate' %}
                <span class="text-xs font-black text-indigo-700">({{ currentOrder|upper }})</span>
              {% endif %}
            </a>

            <a href="{{ path('admin_event_registrations_events', { q: q|default(''), sort: 'regCount', order: nextOrderCount, page: 1 }) }}"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 hover:bg-gray-100 font-extrabold text-sm">
              <span class="material-symbols-outlined text-base">groups</span>
              Inscriptions
              {% if currentSort == 'regCount' %}
                <span class="text-xs font-black text-indigo-700">({{ currentOrder|upper }})</span>
              {% endif %}
            </a>
          </div>
        {% endif %}
      </div>
    </div>

    {# =========================
       MODE A : LISTE EVENTS
       ========================= #}
    {% if rows is defined %}
      {% if rows is empty %}
        <div class="p-6 rounded-2xl border border-dashed border-gray-300 bg-gray-50">
          <p class="font-extrabold text-gray-700">Aucun événement.</p>
        </div>
      {% else %}
        <div class="overflow-hidden rounded-2xl border border-gray-200">
          <table class="w-full text-left">
            <thead class="bg-gradient-to-r from-gray-50 to-gray-100">
              <tr>
                <th class="p-4 font-extrabold text-gray-700">Titre</th>
                <th class="p-4 font-extrabold text-gray-700">Dates</th>
                <th class="p-4 font-extrabold text-gray-700">Lieu</th>
                <th class="p-4 font-extrabold text-gray-700">Inscriptions</th>
                <th class="p-4 font-extrabold text-gray-700">Action</th>
              </tr>
            </thead>

            <tbody id="eventsRows" class="divide-y divide-gray-200">
              {% include 'BackOffice/admin/event/_events_rows.html.twig' with { rows: rows } %}
            </tbody>
          </table>
        </div>

        {% if totalPages|default(1) > 1 %}
          <div class="mt-6 flex justify-center items-center gap-2">
            {% if currentPage > 1 %}
              <a href="{{ path('admin_event_registrations_events', { page: currentPage - 1, q: q, sort: sort, order: order }) }}"
                 class="px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50">
                <span class="material-symbols-outlined text-sm">chevron_left</span>
              </a>
            {% endif %}

            {% for i in 1..totalPages %}
              {% if i >= currentPage - 2 and i <= currentPage + 2 %}
                <a href="{{ path('admin_event_registrations_events', { page: i, q: q, sort: sort, order: order }) }}"
                   class="px-4 py-2 rounded-xl {{ i == currentPage ? 'bg-blue-600 text-white' : 'border border-gray-200 hover:bg-gray-50' }}">
                  {{ i }}
                </a>
              {% endif %}
            {% endfor %}

            {% if currentPage < totalPages %}
              <a href="{{ path('admin_event_registrations_events', { page: currentPage + 1, q: q, sort: sort, order: order }) }}"
                 class="px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50">
                <span class="material-symbols-outlined text-sm">chevron_right</span>
              </a>
            {% endif %}
          </div>

          <div class="text-center text-sm text-gray-500 mt-2">
            Page {{ currentPage }} sur {{ totalPages }} ({{ total }} événements)
          </div>
        {% endif %}

        <div id="noLiveResult" class="hidden mt-4 p-6 rounded-2xl border border-dashed border-gray-300 bg-gray-50">
          <p class="font-extrabold text-gray-700">Aucun résultat.</p>
        </div>
      {% endif %}

    {# =========================
       MODE B : INSCRIPTIONS EVENT
       ========================= #}
    {% elseif registrations is defined %}

      {% if registrations is empty %}
        <div class="p-6 rounded-2xl border border-dashed border-gray-300 bg-gray-50">
          <p class="font-extrabold text-gray-700">Aucune inscription pour cet événement.</p>
        </div>
      {% else %}
        <div class="overflow-hidden rounded-2xl border border-gray-200">
          <table class="w-full text-left">
            <thead class="bg-gradient-to-r from-gray-50 to-gray-100">
              <tr>
                <th class="p-4 font-extrabold text-gray-700">Enfant</th>
                <th class="p-4 font-extrabold text-gray-700">Parent</th>
                <th class="p-4 font-extrabold text-gray-700">Téléphone</th>
                <th class="p-4 font-extrabold text-gray-700">Classe</th>
                <th class="p-4 font-extrabold text-gray-700">Inscrit le</th>
                <th class="p-4 font-extrabold text-gray-700">QR Code</th>
              </tr>
            </thead>

            <tbody id="eventsRows" class="divide-y divide-gray-200">
              {% include 'BackOffice/admin/event/_registrations_rows.html.twig' with { registrations: registrations } %}
            </tbody>
          </table>
        </div>

        {% if totalPages|default(1) > 1 %}
          <div class="mt-6 flex justify-center items-center gap-2">
            {% if currentPage > 1 %}
              <a href="{{ path('admin_event_registrations_show', { id: event.id, page: currentPage - 1, q: q }) }}"
                 class="px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50">
                <span class="material-symbols-outlined text-sm">chevron_left</span>
              </a>
            {% endif %}

            {% for i in 1..totalPages %}
              {% if i >= currentPage - 2 and i <= currentPage + 2 %}
                <a href="{{ path('admin_event_registrations_show', { id: event.id, page: i, q: q }) }}"
                   class="px-4 py-2 rounded-xl {{ i == currentPage ? 'bg-blue-600 text-white' : 'border border-gray-200 hover:bg-gray-50' }}">
                  {{ i }}
                </a>
              {% endif %}
            {% endfor %}

            {% if currentPage < totalPages %}
              <a href="{{ path('admin_event_registrations_show', { id: event.id, page: currentPage + 1, q: q }) }}"
                 class="px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50">
                <span class="material-symbols-outlined text-sm">chevron_right</span>
              </a>
            {% endif %}
          </div>

          <div class="text-center text-sm text-gray-500 mt-2">
            Page {{ currentPage }} sur {{ totalPages }} ({{ total }} inscriptions)
          </div>
        {% endif %}

        <div id="noLiveResult" class="hidden mt-4 p-6 rounded-2xl border border-dashed border-gray-300 bg-gray-50">
          <p class="font-extrabold text-gray-700">Aucun résultat.</p>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

{# ✅ Recherche dynamique AJAX (events + registrations) #}
<script>
(function () {
  const input = document.getElementById('liveSearch');
  const tbody = document.getElementById('eventsRows');
  const emptyBox = document.getElementById('noLiveResult');
  if (!input || !tbody) return;

  let timer = null;

  async function refresh() {
    const q = input.value.trim();
    const params = new URLSearchParams();
    params.set('q', q);
    params.set('page', 1);

    let url = '';
    {% if event is defined %}
      url = "{{ path('admin_event_registrations_show', {id: event.id}) }}?" + params.toString();
    {% else %}
      params.set('sort', '{{ sort|default('startDate') }}');
      params.set('order', '{{ order|default('desc') }}');
      url = "{{ path('admin_event_registrations_events') }}?" + params.toString();
    {% endif %}

    try {
      const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      if (!res.ok) throw new Error('Erreur réseau');

      const html = await res.text();
      tbody.innerHTML = html;

      window.history.replaceState({}, '', url);

      const visibleRows = tbody.querySelectorAll('tr').length;
      if (emptyBox) emptyBox.classList.toggle('hidden', visibleRows > 0);
    } catch (e) {
      console.error(e);
    }
  }

  function debounced() {
    clearTimeout(timer);
    timer = setTimeout(refresh, 300);
  }

  input.addEventListener('input', debounced);
})();
</script>
{% endblock %}