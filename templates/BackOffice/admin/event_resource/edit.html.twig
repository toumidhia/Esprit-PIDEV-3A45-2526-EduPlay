{% extends 'backoffice/admin/Partials/container.html.twig' %}
{% block title %}Modifier ressource{% endblock %}

{% block content %}
<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

  {# ===== HEADER GRADIENT ===== #}
  <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
      <div>
        <h1 class="text-4xl font-extrabold mb-2">✏️ Modifier une ressource</h1>
        <p class="text-blue-100 font-medium">
          Événement : <span class="font-extrabold">{{ event.title }}</span>
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a href="{{ path('admin_event_resource_index', {id: event.id}) }}"
           class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-extrabold rounded-xl hover:bg-white/30 transition-all duration-300 border border-white/30">
          <span class="material-symbols-outlined mr-2 text-base">arrow_back</span>
          Retour
        </a>
      </div>
    </div>
  </div>

  {# ===== FORM ===== #}
  <div class="p-6">
    <div class="rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50 p-6 shadow-sm">
      {{ form_start(form, { attr: { enctype: 'multipart/form-data', novalidate: 'novalidate' } }) }}
      {{ form_errors(form) }}

      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-indigo-600">folder_open</span>
            <h2 class="text-xl font-extrabold text-gray-900">Ressource</h2>
          </div>
          <span class="text-xs font-bold text-gray-500">PDF ou Lien</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
            {{ form_row(form.type) }}
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
            {{ form_row(form.title) }}
          </div>

          <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm" data-field="url">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-indigo-600">link</span>
              <div class="font-extrabold text-gray-900">Lien</div>
            </div>
            {{ form_row(form.url) }}
            <p class="text-xs text-gray-500 mt-2">
              Exemple : lien vers une page d’information, un Drive, ou un formulaire.
            </p>
          </div>

          <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm" data-field="pdf">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-indigo-600">picture_as_pdf</span>
              <div class="font-extrabold text-gray-900">PDF</div>
            </div>

            {{ form_row(form.pdfFile) }}

            {% if resource.filePath %}
              <div class="mt-3 rounded-2xl border border-blue-100 bg-blue-50/60 p-4">
                <p class="text-xs font-extrabold text-blue-900">
                  PDF actuel :
                  <a class="underline" href="{{ asset(resource.filePath) }}" target="_blank" rel="noopener">
                    Ouvrir
                  </a>
                </p>
                <p class="text-xs text-blue-700 font-semibold mt-1">
                  Si tu ne choisis pas un nouveau PDF, l’ancien reste.
                </p>
              </div>
            {% endif %}
          </div>

          <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-indigo-600">notes</span>
              <div class="font-extrabold text-gray-900">Description / Notes</div>
            </div>
            {{ form_row(form.context) }}
          </div>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <button type="submit"
                class="inline-flex items-center px-6 py-3 rounded-xl bg-blue-600 text-white font-extrabold hover:bg-blue-700 transition shadow-sm">
          <span class="material-symbols-outlined mr-2 text-base">save</span>
          Enregistrer les modifications
        </button>

        <a href="{{ path('admin_event_resource_index', {id: event.id}) }}"
           class="inline-flex items-center px-6 py-3 rounded-xl bg-white text-gray-800 font-extrabold border border-gray-200 hover:bg-gray-50 transition">
          Annuler
        </a>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>

<script>
(function () {
  const typeSelect = document.getElementById('{{ form.type.vars.id }}');

  const urlBlock = document.querySelector('[data-field="url"]');
  const pdfBlock = document.querySelector('[data-field="pdf"]');

  const urlInput = document.getElementById('{{ form.url.vars.id }}');
  const pdfInput = document.getElementById('{{ form.pdfFile.vars.id }}');

  function hideAllMain() {
    urlBlock.style.display = 'none';
    pdfBlock.style.display = 'none';
    urlInput.disabled = true;
    pdfInput.disabled = true;
  }

  function refreshMain() {
    hideAllMain();
    const v = typeSelect.value;

    if (v === 'LINK') {
      urlBlock.style.display = '';
      urlInput.disabled = false;
    } else if (v === 'PDF') {
      pdfBlock.style.display = '';
      pdfInput.disabled = false;
    }
  }

  typeSelect.addEventListener('change', refreshMain);
  refreshMain();
})();
</script>
{% endblock %}