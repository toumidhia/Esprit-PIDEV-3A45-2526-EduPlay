{% extends 'backoffice/admin/Partials/container.html.twig' %}
{% block title %}Ressources - {{ event.title }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">

  {# ===== HEADER GRADIENT ===== #}
  <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
    <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
        <div>
          <h1 class="text-4xl font-extrabold mb-2">📁 Ressources</h1>
          <p class="text-blue-100 font-medium">
            Événement : <span class="font-extrabold">{{ event.title }}</span>
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="{{ path('admin_event_resource_new', {id: event.id}) }}"
             class="inline-flex items-center px-6 py-3 bg-white text-indigo-700 font-extrabold rounded-xl hover:bg-indigo-50 transition-all duration-300 shadow-sm">
            <span class="material-symbols-outlined mr-2 text-base">add</span>
            Ajouter
          </a>

          <a href="{{ path('admin_event_index') }}"
             class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-extrabold rounded-xl hover:bg-white/30 transition-all duration-300 border border-white/30">
            <span class="material-symbols-outlined mr-2 text-base">arrow_back</span>
            Retour événements
          </a>
        </div>
      </div>
    </div>

    {# ===== SUB HEADER (infos rapides) ===== #}
    <div class="bg-white px-6 py-5 border-t border-gray-100">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center">
            <span class="material-symbols-outlined text-indigo-600">folder_open</span>
          </div>
          <div>
            <div class="text-xl font-extrabold text-gray-900">Gestion des ressources</div>
            <div class="text-sm text-gray-500 font-semibold">PDF • Liens • Checklist • Planning</div>
          </div>
        </div>

        <div class="text-sm font-bold text-gray-600">
          Total :
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
            {{ resources|length }}
          </span>
        </div>
      </div>
    </div>
  </div>

  {# ===== LISTE ===== #}
  <div class="mt-6">
    {% if resources is empty %}
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
        <div class="p-6 rounded-2xl border border-dashed border-gray-300 bg-gray-50">
          <p class="font-extrabold text-gray-700">Aucune ressource.</p>
        </div>
      </div>
    {% else %}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for r in resources %}
          {% set badgeClass = 'bg-gray-50 text-gray-700 border border-gray-200' %}
          {% set icon = 'description' %}
          {% if r.type == 'PDF' %}
            {% set badgeClass = 'bg-blue-50 text-blue-700 border border-blue-100' %}
            {% set icon = 'picture_as_pdf' %}
          {% elseif r.type == 'LINK' %}
            {% set badgeClass = 'bg-pink-50 text-pink-700 border border-pink-100' %}
            {% set icon = 'link' %}
          {% elseif r.type == 'CHECKLIST' %}
            {% set badgeClass = 'bg-yellow-50 text-yellow-800 border border-yellow-200' %}
            {% set icon = 'checklist' %}
          {% elseif r.type == 'PLANNING' %}
            {% set badgeClass = 'bg-indigo-50 text-indigo-700 border border-indigo-100' %}
            {% set icon = 'event' %}
          {% endif %}

          <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
            <div class="p-6">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gray-50 border border-gray-200 flex items-center justify-center shrink-0">
                      <span class="material-symbols-outlined text-gray-700">{{ icon }}</span>
                    </div>

                    <div class="min-w-0">
                      <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="text-lg font-extrabold text-gray-900 truncate">{{ r.title }}</h3>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold {{ badgeClass }}">
                          {{ r.type }}
                        </span>
                      </div>
                      <div class="text-xs text-gray-500 font-semibold mt-1">
                        Ajoutée le : {{ r.createdAt ? r.createdAt|date('d/m/Y H:i') : '—' }}
                      </div>
                    </div>
                  </div>

                  {# CONTENU selon type #}
                  {% if r.type == 'LINK' and r.url %}
                    <div class="mt-4 text-sm font-bold">
                      🔗
                      <a class="text-indigo-700 hover:underline break-all" href="{{ r.url }}" target="_blank" rel="noopener">
                        {{ r.url }}
                      </a>
                    </div>
                  {% endif %}

                  {% if r.type == 'PDF' and r.filePath %}
                    <div class="mt-4 text-sm font-bold">
                      📄
                      <a class="text-indigo-700 hover:underline" href="{{ asset(r.filePath) }}" target="_blank" rel="noopener">
                        Ouvrir le PDF
                      </a>
                    </div>
                  {% endif %}

                  {% if r.type == 'CHECKLIST' and r.context %}
                    <div class="mt-4 rounded-2xl border border-yellow-200 bg-yellow-50/50 p-4">
                      <div class="flex items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-yellow-800">checklist</span>
                        <p class="text-sm font-extrabold text-yellow-900">Checklist</p>
                      </div>
                      <ul class="text-sm space-y-1">
                        {% for line in r.context|split("\n") %}
                          {% set item = line|trim %}
                          {% if item != '' %}
                            <li class="flex gap-2 text-gray-800 font-medium">
                              <span class="mt-[2px]">•</span>
                              <span>{{ item|replace({'- ': ''}) }}</span>
                            </li>
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if r.type == 'PLANNING' and r.context %}
                    <div class="mt-4 rounded-2xl border border-indigo-200 bg-indigo-50/50 p-4">
                      <div class="flex items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-indigo-700">event</span>
                        <p class="text-sm font-extrabold text-indigo-900">Planning</p>
                      </div>
                      <div class="space-y-2">
                        {% for line in r.context|split("\n") %}
                          {% set t = line|trim %}
                          {% if t != '' %}
                            <div class="flex gap-3 items-start">
                              <span class="mt-1 w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                              <div class="text-sm text-gray-800 font-medium">{{ t }}</div>
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}

                  {% if r.type not in ['CHECKLIST','PLANNING'] and r.context %}
                    <p class="mt-4 text-sm text-gray-600 font-medium leading-relaxed">
                      {{ r.context }}
                    </p>
                  {% endif %}
                </div>

                {# ACTIONS #}
                <div class="flex flex-col gap-2 shrink-0">
                  {% if r.type == 'CHECKLIST' %}
                    <a class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-indigo-600 text-white font-extrabold hover:bg-indigo-700 transition"
                       href="{{ path('admin_event_checklist_edit', {eventId: event.id, resourceId: r.id}) }}">
                      <span class="material-symbols-outlined mr-2 text-base">edit</span>
                      Modifier
                    </a>
                  {% elseif r.type == 'PLANNING' %}
                    <a class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-indigo-600 text-white font-extrabold hover:bg-indigo-700 transition"
                       href="{{ path('admin_event_planning_edit', {eventId: event.id, resourceId: r.id}) }}">
                      <span class="material-symbols-outlined mr-2 text-base">edit</span>
                      Modifier
                    </a>
                  {% else %}
                    <a class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-indigo-600 text-white font-extrabold hover:bg-indigo-700 transition"
                       href="{{ path('admin_event_resource_edit', {eventId: event.id, resourceId: r.id}) }}">
                      <span class="material-symbols-outlined mr-2 text-base">edit</span>
                      Modifier
                    </a>
                  {% endif %}

                  <form method="post"
                        action="{{ path('admin_event_resource_delete', {eventId: event.id, resourceId: r.id}) }}"
                        onsubmit="return confirm('Supprimer cette ressource ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_resource_' ~ r.id) }}">
                    <button class="w-full inline-flex items-center justify-center px-4 py-2 rounded-xl bg-red-50 text-red-700 border border-red-200 font-extrabold hover:bg-red-100 transition"
                            type="submit">
                      <span class="material-symbols-outlined mr-2 text-base">delete</span>
                      Supprimer
                    </button>
                  </form>
                </div>
              </div>
            </div>

            {# FOOTER décoratif #}
            <div class="h-1 bg-gradient-to-r from-blue-500 to-indigo-600"></div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

</div>
{% endblock %}