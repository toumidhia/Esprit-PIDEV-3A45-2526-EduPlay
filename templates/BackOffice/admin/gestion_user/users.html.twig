{% extends 'BackOffice/admin/Partials/container.html.twig' %}

{% block title %}Gestion des Utilisateurs - EduPlay{% endblock %}

{% block content %}
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mt-4">
            <h1 class="h3">
                <i class="bi bi-people-fill"></i> Gestion des Utilisateurs
            </h1>
            <div>
                <a href="{{ path('app_admin_admin_new') }}" class="btn btn-danger me-2">
                    <i class="bi bi-person-plus"></i> Nouvel Administrateur
                </a>
                <a href="{{ path('app_admin_enseignant_new') }}" class="btn btn-success">
                    <i class="bi bi-person-plus"></i> Nouvel Enseignant
                </a>
            </div>
        </div>

        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Utilisateurs</li>
        </ol>

        <!-- Statistiques -->
        <div class="row">
            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                <div class="card bg-primary text-white h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Total</h6>
                                <h2 class="mt-2 mb-0">{{ stats.total }}</h2>
                            </div>
                            <i class="bi bi-people" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                <div class="card bg-danger text-white h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Admins</h6>
                                <h2 class="mt-2 mb-0">{{ stats.admin }}</h2>
                            </div>
                            <i class="bi bi-shield-lock" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                <div class="card bg-success text-white h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Enseignants</h6>
                                <h2 class="mt-2 mb-0">{{ stats.enseignant }}</h2>
                            </div>
                            <i class="bi bi-mortarboard" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                <div class="card bg-warning text-dark h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Parents</h6>
                                <h2 class="mt-2 mb-0">{{ stats.parent }}</h2>
                            </div>
                            <i class="bi bi-person-badge" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                <div class="card bg-info text-white h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Enfants</h6>
                                <h2 class="mt-2 mb-0">{{ stats.enfant }}</h2>
                            </div>
                            <i class="bi bi-emoji-smile" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ✅ FILTRES AMÉLIORÉS AVEC PAGINATION -->
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-funnel"></i> Filtres
            </div>
            <div class="card-body">
                <form method="get" action="{{ path('app_admin_users') }}" id="filterForm">
                    <div class="row">
                        <div class="col-md-3">
                            <input type="text" 
                                   name="search" 
                                   class="form-control" 
                                   placeholder="Rechercher..." 
                                   value="{{ currentSearch }}">
                        </div>
                        <div class="col-md-2">
                            <select name="type" class="form-select">
                                <option value="all" {% if currentType == 'all' %}selected{% endif %}>Tous les types</option>
                                <option value="admin" {% if currentType == 'admin' %}selected{% endif %}>Administrateurs</option>
                                <option value="enseignant" {% if currentType == 'enseignant' %}selected{% endif %}>Enseignants</option>
                                <option value="parent" {% if currentType == 'parent' %}selected{% endif %}>Parents</option>
                                <option value="enfant" {% if currentType == 'enfant' %}selected{% endif %}>Enfants</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="status" class="form-select">
                                <option value="all" {% if currentStatus == 'all' %}selected{% endif %}>Tous les statuts</option>
                                <option value="active" {% if currentStatus == 'active' %}selected{% endif %}>Actifs</option>
                                <option value="inactive" {% if currentStatus == 'inactive' %}selected{% endif %}>Inactifs</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="limit" class="form-select">
                                <option value="10" {% if currentLimit == 10 %}selected{% endif %}>10 par page</option>
                                <option value="20" {% if currentLimit == 20 %}selected{% endif %}>20 par page</option>
                                <option value="50" {% if currentLimit == 50 %}selected{% endif %}>50 par page</option>
                                <option value="100" {% if currentLimit == 100 %}selected{% endif %}>100 par page</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i> Filtrer
                            </button>
                            <a href="{{ path('app_admin_users') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- ✅ TABLEAU AVEC PAGINATION -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-table me-1"></i>
                    Liste des utilisateurs
                </span>
                <span class="badge bg-primary">
                    {{ pagination.getTotalItemCount }} utilisateur(s) trouvé(s)
                </span>
            </div>
            <div class="card-body">
                {% if pagination.getTotalItemCount > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th>#</th>
                                <th>{{ knp_pagination_sortable(pagination, 'ID', 'u.id') }}</th>
                                <th>{{ knp_pagination_sortable(pagination, 'Nom', 'u.lastName') }}</th>
                                <th>{{ knp_pagination_sortable(pagination, 'Email', 'u.email') }}</th>
                                <th>Type</th>
                                <th>{{ knp_pagination_sortable(pagination, 'Date création', 'u.createdAt') }}</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for user in pagination %}
                                <tr>
                                 <td>{{ (pagination.currentPageNumber - 1) * pagination.getItemNumberPerPage + loop.index }}</td>
                                    <td>#{{ user.id }}</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="user-avatar bg-{{
                                            user.type == 'admin' ? 'danger' :
                                            (user.type == 'enseignant' ? 'success' :
                                            (user.type == 'parent' ? 'warning' : 'info'))
                                            }} text-white rounded-circle me-3" 
                                            style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                                {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                                            </div>
                                            <div>
                                                <strong>{{ user.fullName }}</strong>
                                                {% if user.username %}
                                                    <br>
                                                    <small class="text-muted">
                                                        <i class="bi bi-person-badge"></i> {{ user.username }}
                                                    </small>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <i class="bi bi-envelope"></i> {{ user.email }}
                                        {% if user.telephone %}
                                            <br><i class="bi bi-telephone"></i> {{ user.telephone }}
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-{{
                                            user.type == 'admin' ? 'danger' :
                                            (user.type == 'enseignant' ? 'success' :
                                            (user.type == 'parent' ? 'warning' : 'info'))
                                        }}">
                                            {{ user.type|upper }}
                                        </span>
                                    </td>
                                    <td>{{ user.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        {% if user.active %}
                                            <span class="badge bg-success">Actif</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inactif</span>
                                        {% endif %}
                                    </td>
                                    <td>
    <i class="bi bi-envelope"></i> {{ user.email }}
    {% if user.telephone %}
        <br><i class="bi bi-telephone"></i> {{ user.telephone }}
    {% endif %}
    {% if user.lastLoginCountry %}
        <br><i class="bi bi-geo-alt"></i> {{ user.lastLoginCity }}, {{ user.lastLoginCountry }}
        <small class="text-muted">({{ user.lastLoginAt|date('d/m/Y H:i') }})</small>
    {% endif %}
</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            {% if user != app.user %}
                                                <form method="post" action="{{ path('app_admin_user_toggle', {'id': user.id}) }}" style="display: inline-block;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                                    <button type="submit" class="btn btn-sm {% if user.active %}btn-warning{% else %}btn-success{% endif %}"
                                                            title="{% if user.active %}Désactiver{% else %}Activer{% endif %}">
                                                        <i class="bi bi-{% if user.active %}pause-circle{% else %}play-circle{% endif %}"></i>
                                                    </button>
                                                </form>
                                                <form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}"
                                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ user.fullName }} ?');"
                                                      style="display: inline-block;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <span class="badge bg-info">Vous</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- ✅ PAGINATION -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div>
                            Affichage de {{ pagination.currentPageNumber * currentLimit - currentLimit + 1 }} 
                            à {{ min(pagination.currentPageNumber * currentLimit, pagination.getTotalItemCount) }} 
                            sur {{ pagination.getTotalItemCount }} résultat(s)
                        </div>
                        <div>
                            <nav aria-label="Pagination">
    {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
</nav>
                        </div>
                    </div>
                {% else %}
                    <div class="text-center text-muted my-5">
                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                        <p class="mt-3">Aucun utilisateur trouvé.</p>
                        <a href="{{ path('app_admin_users') }}" class="btn btn-primary">
                            <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser les filtres
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Auto-submit du formulaire lors du changement de limite
        document.querySelector('select[name="limit"]').addEventListener('change', function() {
            document.getElementById('filterForm').submit();
        });
    </script>
{% endblock %}