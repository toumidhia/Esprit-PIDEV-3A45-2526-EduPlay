{# templates/BackOffice/admin/library/_form.html.twig #}
{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-8'}}) }}

    <!-- EN-TÊTE DU FORMULAIRE -->
    <div class="mb-8 pb-6">
        <div class="flex items-center">
            <div class="p-3 bg-gradient-to-r from-blue-100 to-indigo-100 rounded-xl mr-4">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
            </div>
          
        </div>
    </div>

    <!-- CHAMPS DU FORMULAIRE -->
    <div class="space-y-6">
        {# Nom de la bibliothèque #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.name, "Nom de la bibliothèque", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
            </div>
            {{ form_widget(form.name, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-300 group-hover:border-blue-300',
                    'placeholder': 'Ex: Bibliothèque Jeunesse'
                }
            }) }}
            {{ form_errors(form.name, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            <p class="text-xs text-gray-500 mt-2">3 à 20 caractères, pas de caractères spéciaux</p>
        </div>

        {# Description #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.description, "Description", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-gray-500 bg-gray-50 px-2 py-1 rounded">Optionnel</span>
            </div>
            {{ form_widget(form.description, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-300 group-hover:border-blue-300 resize-none',
                    'rows': 4,
                    'placeholder': 'Décrivez brièvement cette bibliothèque...'
                }
            }) }}
            {{ form_errors(form.description, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            <p class="text-xs text-gray-500 mt-1">Optionnel - Max 100 caractères</p>
        </div>

        {# Âge minimum et maximum #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="group">
                <div class="flex items-center justify-between mb-2">
                    {{ form_label(form.minAge, "Âge minimum", {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                    }) }}
                    <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
                </div>
                {{ form_widget(form.minAge, {
                    'attr': {
                        'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-300 group-hover:border-blue-300',
                        'placeholder': 'Ex: 3'
                    }
                }) }}
                {{ form_errors(form.minAge, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
                <p class="text-xs text-gray-500 mt-1">Minimum 3 ans</p>
            </div>
            
            <div class="group">
                <div class="flex items-center justify-between mb-2">
                    {{ form_label(form.maxAge, "Âge maximum", {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                    }) }}
                    <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
                </div>
                {{ form_widget(form.maxAge, {
                    'attr': {
                        'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-300 group-hover:border-blue-300',
                        'placeholder': 'Ex: 12'
                    }
                }) }}
                {{ form_errors(form.maxAge, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
                <p class="text-xs text-gray-500 mt-1">Maximum 12 ans</p>
            </div>
        </div>

        {# Niveau de difficulté #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.level, "Niveau de difficulté", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
            </div>
            {{ form_widget(form.level, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-300 group-hover:border-blue-300'
                }
            }) }}
            {{ form_errors(form.level, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
        </div>

        {# Thème #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.theme, "Thème/Catégorie", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
            </div>
            {{ form_widget(form.theme, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-300 group-hover:border-blue-300',
                    'placeholder': 'Ex: Aventure, Science, Histoire...'
                }
            }) }}
            {{ form_errors(form.theme, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            <p class="text-xs text-gray-500 mt-1">2 à 20 caractères</p>
        </div>

        {# Image de couverture - CONSERVÉE TEL QUEL #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.coverImageFile, "Image de couverture", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-gray-500 bg-gray-50 px-2 py-1 rounded">Optionnel</span>
            </div>
            {{ form_widget(form.coverImageFile, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl hover:border-blue-400 transition-all duration-200 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100'
                }
            }) }}
            {{ form_errors(form.coverImageFile, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            
            {% if library.coverImage is defined and library.coverImage %}
                <div class="mt-4">
                    <p class="text-sm text-gray-600 mb-2">Image actuelle :</p>
                    <img src="{{ asset('uploads/' ~ library.coverImage) }}" 
                         alt="Image de couverture" 
                         class="w-32 h-32 object-cover rounded-lg border border-gray-200">
                </div>
            {% endif %}
        </div>
    </div>

    <!-- BOUTONS D'ACTION -->
    <div class="flex justify-end space-x-4 pt-8 border-t border-gray-200">
        <a href="{{ path('admin_library_index') }}" 
           class="px-6 py-3 border-2 border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Annuler
        </a>
        {{ form_widget(form.save, {
            'attr': {
                'class': 'px-8 py-3 bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-bold rounded-xl hover:from-blue-600 hover:to-indigo-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center'
            }
        }) }}
    </div>

{{ form_end(form) }}