{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Nouvelle Ressource{% endblock %}

{% block content %}
<div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
    <!-- HEADER AVEC BACKGROUND GRADIENT -->
    <div class="px-8 py-10 bg-gradient-to-r from-indigo-500 to-purple-600 text-white">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-4xl font-bold mb-2">📄 Nouvelle ressource</h1>
                <p class="text-indigo-100">Créez une nouvelle ressource pour votre collection</p>
            </div>
            <div class="p-3 bg-white/20 rounded-xl backdrop-blur-sm">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- CONTENU DU FORMULAIRE -->
    <div class="p-8">
        <!-- MESSAGES FLASH -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 animate-fade-in-down">
                    <div class="flex items-center p-4 mb-4 rounded-xl border-l-4
                        {% if label == 'success' %}text-green-800 bg-gradient-to-r from-green-50 to-emerald-50 border-green-500
                        {% else %}text-red-800 bg-gradient-to-r from-red-50 to-rose-50 border-red-500{% endif %}">
                        <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 20 20">
                            {% if label == 'success' %}
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00 1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            {% else %}
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            {% endif %}
                        </svg>
                        <div class="font-medium">{{ message }}</div>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

       <!-- FORMULAIRE -->
<div class="bg-gradient-to-br from-gray-50 to-white rounded-2xl border border-gray-100 shadow-xl p-6">

    {# ✅ Bandeau si titre pré-rempli depuis une demande #}
    {% if app.request.query.get('prefill') %}
        <div class="mb-6 flex items-center gap-3 px-4 py-3 bg-orange-50 border border-orange-200 rounded-xl text-orange-700 font-medium text-sm">
            <span class="text-xl">📋</span>
            <div>
                <p class="font-bold">Titre pré-rempli depuis une demande enfant</p>
                <p class="text-xs text-orange-500">Vérifiez et complétez les autres champs avant d'enregistrer</p>
            </div>
        </div>
    {% endif %}

        
            {% include 'BackOffice/admin/resource/_form.html.twig' with {'resource': null, 'is_edit': false} %}
        </div>
    </div>
</div>

<style>
@keyframes fade-in-down {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in-down {
    animation: fade-in-down 0.5s ease-out;
}
</style>
{% endblock %}