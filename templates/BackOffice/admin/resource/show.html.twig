{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Détails : {{ resource.title }}{% endblock %}

{% block content %}
<div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
    <!-- HEADER AVEC BACKGROUND GRADIENT -->
    <div class="px-8 py-10 bg-gradient-to-r from-indigo-500 to-purple-600 text-white">
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center">
            <div class="mb-6 lg:mb-0">
                <h1 class="text-4xl font-bold mb-2">{{ resource.title }}</h1>
                <p class="text-indigo-100">par {{ resource.author }}</p>
                
                <!-- Badges d'information -->
                <div class="flex flex-wrap gap-3 mt-4">
                    <!-- Type -->
                    {% set type_colors = {
                        'Livre': 'bg-gradient-to-r from-blue-500 to-indigo-600',
                        'Magazine': 'bg-gradient-to-r from-green-500 to-teal-600',
                        'Journal': 'bg-gradient-to-r from-yellow-500 to-amber-600',
                        'Article': 'bg-gradient-to-r from-purple-500 to-pink-600'
                    } %}
                    <span class="inline-flex items-center px-4 py-2 {{ type_colors[resource.type]|default('bg-gradient-to-r from-gray-600 to-gray-700') }} text-white text-sm font-bold rounded-full shadow-lg">
                        {{ resource.type }}
                    </span>
                    
                   <!-- Tranche d'âge IA -->
<div class="p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl border border-blue-100">
    <div class="flex items-center justify-between mb-2">
        <p class="text-sm font-semibold text-blue-800">📊 Tranche d'âge</p>
        <span class="inline-flex items-center px-2 py-1 bg-indigo-100 text-indigo-700 text-xs font-bold rounded-full">
            🤖 Détecté par IA
        </span>
    </div>
    <p class="text-2xl font-bold text-blue-900">{{ resource.minAge }} - {{ resource.maxAge }} ans</p>
    
    {# Barre visuelle de 3 à 12 ans #}
    <div class="mt-3">
        <div class="flex justify-between text-xs text-blue-500 mb-1">
            <span>3 ans</span>
            <span>12 ans</span>
        </div>
        <div class="relative h-3 bg-blue-100 rounded-full overflow-hidden">
            {# Zone couverte par la tranche #}
            <div class="absolute h-full bg-gradient-to-r from-blue-400 to-indigo-500 rounded-full"
                 style="
                    left: {{ ((resource.minAge - 3) / 9) * 100 }}%;
                    width: {{ ((resource.maxAge - resource.minAge) / 9) * 100 }}%;
                 ">
            </div>
        </div>
        <div class="flex justify-between text-xs text-blue-600 mt-1">
            <span class="font-bold">{{ resource.minAge }} ans</span>
            <span class="font-bold">{{ resource.maxAge }} ans</span>
        </div>
    </div>
</div>
                    <!-- Langue -->
                    <span class="inline-flex items-center px-4 py-2 bg-white/20 backdrop-blur-sm text-white text-sm font-medium rounded-full">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
                        </svg>
                        {{ resource.language }}
                    </span>
                </div>
            </div>
            
            <!-- Boutons d'action -->
            <div class="flex flex-col sm:flex-row gap-3">
                <a href="{{ path('admin_resource_index') }}" 
                   class="inline-flex items-center justify-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-semibold rounded-xl hover:bg-white/30 transition-all duration-300 border border-white/30 transform hover:-translate-y-0.5">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Retour
                </a>
                <a href="{{ path('admin_resource_edit', {'id': resource.id}) }}" 
                   class="inline-flex items-center justify-center px-6 py-3 bg-white text-indigo-600 font-bold rounded-xl hover:bg-indigo-50 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    Modifier
                </a>
            </div>
        </div>
    </div>

    <!-- CONTENU PRINCIPAL -->
    <div class="p-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- DESCRIPTION ET INFORMATIONS -->
            <div class="lg:col-span-2 space-y-8">
                <!-- IMAGE DE COUVERTURE -->
                {% if resource.coverImage %}
                    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
                        <div class="flex items-center mb-6">
                            <div class="p-3 bg-gradient-to-r from-indigo-100 to-purple-100 rounded-xl mr-4">
                                <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800">Image de couverture</h2>
                                <p class="text-gray-500">Visuel de la ressource</p>
                            </div>
                        </div>
                        
                        <div class="relative overflow-hidden rounded-xl border-2 border-gray-100 shadow-lg">
                            <img src="{{ asset('uploads/' ~ resource.coverImage) }}" 
                                 alt="{{ resource.title }}" 
                                 class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent"></div>
                        </div>
                    </div>
                {% endif %}

                <!-- RÉSUMÉ -->
                <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center mb-6">
                        <div class="p-3 bg-gradient-to-r from-blue-100 to-indigo-100 rounded-xl mr-4">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">Résumé</h2>
                            <p class="text-gray-500">Synopsis et description</p>
                        </div>
                    </div>
                    
                    {% if resource.summary %}
                        <div class="prose max-w-none">
                            <div class="text-gray-700 leading-relaxed bg-gray-50 p-6 rounded-xl border border-gray-100">
                                {{ resource.summary|nl2br }}
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-12 bg-gray-50 rounded-xl border border-gray-100">
                            <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <p class="text-gray-500 text-lg">Aucun résumé disponible</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- INFORMATIONS ET ACTIONS -->
            <div class="space-y-6">
                <!-- INFORMATIONS DÉTAILLÉES -->
                <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center mb-6">
                        <div class="p-3 bg-gradient-to-r from-green-100 to-emerald-100 rounded-xl mr-4">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">Informations</h2>
                            <p class="text-gray-500">Détails techniques</p>
                        </div>
                    </div>
                    
                    <div class="space-y-6">
                        <!-- Auteur -->
                        <div class="p-4 bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl border border-indigo-100">
                            <p class="text-sm font-semibold text-indigo-800 mb-2">👤 Auteur</p>
                            <p class="text-lg font-bold text-gray-800">{{ resource.author }}</p>
                        </div>

                        <!-- Tranche d'âge -->
                        <div class="p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl border border-blue-100">
                            <p class="text-sm font-semibold text-blue-800 mb-2">📊 Tranche d'âge</p>
                            <p class="text-2xl font-bold text-blue-900">{{ resource.minAge }} - {{ resource.maxAge }} ans</p>
                            <div class="mt-3">
                                <div class="flex justify-between text-xs text-blue-600 mb-1">
                                    <span>{{ resource.minAge }} ans</span>
                                    <span>{{ resource.maxAge }} ans</span>
                                </div>
                                <div class="h-2 bg-blue-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full" 
                                         style="width: {{ ((resource.maxAge - resource.minAge) / 15) * 100 }}%"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Type -->
                        <div class="p-4 bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl border border-gray-200">
                            <p class="text-sm font-semibold text-gray-700 mb-2">📚 Type de ressource</p>
                            <div class="flex items-center justify-between">
                                <p class="text-lg font-bold text-gray-800">{{ resource.type }}</p>
                                {% if resource.type == 'Livre' %}
                                    <span class="text-2xl">📖</span>
                                {% elseif resource.type == 'Magazine' %}
                                    <span class="text-2xl">📰</span>
                                {% elseif resource.type == 'Journal' %}
                                    <span class="text-2xl">📓</span>
                                {% else %}
                                    <span class="text-2xl">📄</span>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Langue -->
                        <div class="p-4 bg-gradient-to-r from-yellow-50 to-amber-100 rounded-xl border border-yellow-200">
                            <p class="text-sm font-semibold text-yellow-800 mb-2">🌍 Langue</p>
                            <p class="text-lg font-bold text-gray-800">{{ resource.language }}</p>
                        </div>

                        <!-- Bibliothèque -->
                        <div class="p-4 bg-gradient-to-r from-purple-50 to-violet-100 rounded-xl border border-purple-200">
                            <p class="text-sm font-semibold text-purple-800 mb-2">🏛️ Bibliothèque</p>
                            <p class="text-lg font-bold text-gray-800">{{ resource.libraryId.name }}</p>
                        </div>
                    </div>
                </div>

                <!-- FICHIER PDF -->
                {% if resource.pdfFile %}
                    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
                        <div class="flex items-center mb-6">
                            <div class="p-3 bg-gradient-to-r from-red-100 to-orange-100 rounded-xl mr-4">
                                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800">Fichier PDF</h2>
                                <p class="text-gray-500">Document téléchargeable</p>
                            </div>
                        </div>
                        
                        <div class="p-4 bg-gradient-to-r from-gray-50 to-white rounded-xl border border-gray-200">
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center">
                                    <div class="p-3 bg-red-50 rounded-lg mr-4">
                                        <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-800">Document PDF</p>
                                        <p class="text-sm text-gray-500">Format numérique</p>
                                    </div>
                                </div>
                            </div>
                            
                            <a href="{{ asset('pdfs/' ~ resource.pdfFile) }}" 
                               target="_blank" 
                               class="block w-full text-center px-6 py-3 bg-gradient-to-r from-red-500 to-orange-500 text-white font-bold rounded-xl hover:from-red-600 hover:to-orange-600 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center justify-center">
                                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                                Télécharger le PDF
                            </a>
                        </div>
                    </div>
                {% endif %}

                <!-- ACTIONS -->
                <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center mb-6">
                        <div class="p-3 bg-gradient-to-r from-red-100 to-rose-100 rounded-xl mr-4">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">Actions</h2>
                            <p class="text-gray-500">Gestion de la ressource</p>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <!-- Bouton Modifier -->
                        <a href="{{ path('admin_resource_edit', {'id': resource.id}) }}" 
                           class="block w-full text-center px-6 py-4 border-2 border-indigo-200 text-indigo-700 font-bold rounded-xl bg-indigo-50 hover:bg-indigo-100 hover:border-indigo-300 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center justify-center">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            Modifier
                        </a>
                        
                        <!-- Bouton Supprimer -->
                        <form method="post" 
                              action="{{ path('admin_resource_delete', {'id': resource.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer « {{ resource.title }} » ? Cette action est irréversible.');">
                            <input type="hidden" name="_token" 
                                   value="{{ csrf_token('delete' ~ resource.id) }}">
                            <button type="submit" 
                                    class="w-full px-6 py-4 border-2 border-red-200 text-red-700 font-bold rounded-xl bg-red-50 hover:bg-red-100 hover:border-red-300 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center justify-center">
                                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}