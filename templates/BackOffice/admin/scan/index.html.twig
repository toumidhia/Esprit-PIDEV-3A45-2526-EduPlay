{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Scanner un ticket - EduPlay Admin{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto px-4 py-8">

  <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
    
    <div class="text-center mb-8">
      <span class="material-symbols-outlined text-6xl text-primary">qr_code_scanner</span>
      <h1 class="text-3xl font-extrabold mt-4">Scanner un ticket</h1>
      <p class="text-gray-500">Scannez le QR code du parent pour valider l'entrée</p>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('success') %}
      <div class="mb-4 p-4 bg-green-100 text-green-700 rounded-xl font-bold flex items-center gap-2">
        <span class="material-symbols-outlined text-green-700">check_circle</span>
        {{ message }}
      </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
      <div class="mb-4 p-4 bg-yellow-100 text-yellow-700 rounded-xl font-bold flex items-center gap-2">
        <span class="material-symbols-outlined text-yellow-700">warning</span>
        {{ message }}
      </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
      <div class="mb-4 p-4 bg-red-100 text-red-700 rounded-xl font-bold flex items-center gap-2">
        <span class="material-symbols-outlined text-red-700">error</span>
        {{ message }}
      </div>
    {% endfor %}

    {# Scanner intégré (fonctionne sur mobile) #}
    <div class="mt-6">
      <div id="qr-reader" style="width: 100%; border-radius: 12px; overflow: hidden;"></div>
      
      <div id="qr-reader-results" class="mt-4 text-center"></div>
    </div>

    {# Formulaire manuel (en cas d'échec) #}
    <details class="mt-6">
      <summary class="text-sm text-gray-500 cursor-pointer hover:text-gray-700">
        Ou saisir le code manuellement
      </summary>
      
      <form action="{{ path('admin_scan_verify') }}" method="POST" class="mt-4">
        <input type="hidden" name="_token" value="{{ csrf_token('scan_verify') }}">
        
        <div class="flex flex-col sm:flex-row gap-3">
          <input type="text" 
                 name="code" 
                 id="codeInput"
                 placeholder="Saisir le code du ticket"
                 class="flex-1 h-12 px-4 rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary focus:outline-none">
          <button type="submit" 
                  class="px-6 h-12 bg-primary text-white font-bold rounded-xl hover:bg-primary/80 transition flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-base">verify</span>
            Vérifier
          </button>
        </div>
      </form>
    </details>

  </div>

  {# Raccourcis #}
  <div class="mt-4 grid grid-cols-2 gap-3">
    <a href="{{ path('admin_event_index') }}" 
       class="flex items-center justify-center gap-2 px-4 py-3 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition font-bold">
      <span class="material-symbols-outlined text-base">event</span>
      Événements
    </a>
    <a href="{{ path('admin_event_registrations_events') }}" 
       class="flex items-center justify-center gap-2 px-4 py-3 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition font-bold">
      <span class="material-symbols-outlined text-base">list</span>
      Inscriptions
    </a>
  </div>

</div>

{# Bibliothèque de scan HTML5 #}
<script src="https://unpkg.com/html5-qrcode/minified/html5-qrcode.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const html5QrCode = new Html5Qrcode("qr-reader");
    
    const qrCodeSuccessCallback = (decodedText, decodedResult) => {
      // Désactiver le scan après un succès
      html5QrCode.stop();
      
      // Extraire le code de l'URL
      const urlParts = decodedText.split('/');
      const code = urlParts[urlParts.length - 1];
      
      // Afficher le résultat
      document.getElementById('qr-reader-results').innerHTML = `
        <div class="bg-green-100 text-green-700 p-4 rounded-xl font-bold">
          Code détecté ! Redirection...
        </div>
      `;
      
      // Rediriger vers la page de validation
      setTimeout(() => {
        window.location.href = "{{ path('admin_scan_verify') }}?code=" + encodeURIComponent(code);
      }, 1000);
    };
    
    const config = { fps: 10, qrbox: { width: 250, height: 250 } };
    
    // Démarrer le scanner
    html5QrCode.start({ facingMode: "environment" }, config, qrCodeSuccessCallback)
      .catch(err => {
        document.getElementById('qr-reader-results').innerHTML = `
          <div class="bg-red-100 text-red-700 p-4 rounded-xl font-bold">
            Erreur caméra : ${err}
          </div>
        `;
      });
  });
</script>

<style>
  #qr-reader {
    border: none !important;
  }
  #qr-reader__scan_region {
    background: #f3f4f6 !important;
    border-radius: 12px;
  }
  #qr-reader__dashboard {
    padding: 0 !important;
  }
  #qr-reader__status_span {
    background: #63b7f2 !important;
    color: white !important;
    border-radius: 20px !important;
    padding: 8px 16px !important;
  }
</style>
{% endblock %}