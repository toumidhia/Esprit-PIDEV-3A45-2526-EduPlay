{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Gestion des Inscriptions - EduPlay{% endblock %}

{% block content %}
    <div class="container-fluid px-4">
        <h1 class="mt-4">
            <i class="bi bi-people-fill"></i> Gestion des Inscriptions
        </h1>
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Inscriptions</li>
        </ol>

        <!-- Statistiques -->
        <div class="row">
            <div class="col-xl-3 col-md-6">
                <div class="card bg-primary text-white mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Total Inscriptions</h6>
                                <h2 class="mt-2 mb-0">{{ subscriptions|length }}</h2>
                            </div>
                            <i class="bi bi-ticket-perforated" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-success text-white mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Cours distincts</h6>
                                <h2 class="mt-2 mb-0">{{ uniqueCoursesCount }}</h2>
                            </div>
                            <i class="bi bi-book" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-info text-white mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Enfants inscrits</h6>
                                <h2 class="mt-2 mb-0">{{ uniqueKidsCount }}</h2>
                            </div>
                            <i class="bi bi-people" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-warning text-white mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Parents actifs</h6>
                                <h2 class="mt-2 mb-0">{{ uniqueParentsCount }}</h2>
                            </div>
                            <i class="bi bi-person-badge" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau des inscriptions -->
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-table me-1"></i>
                Liste des inscriptions actives ({{ subscriptions|length }})
            </div>
            <div class="card-body">
                {% if subscriptions|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                            <tr>
                                <th>ID</th>
                                <th>Enfant</th>
                                <th>Parent</th>
                                <th>Cours</th>
                                <th>Niveau</th>
                                <th>Date d'inscription</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for subscription in subscriptions %}
                                <tr>
                                    <td>#{{ subscription.id }}</td>
                                    <td>
                                        <strong>{{ subscription.kid.fullName }}</strong>
                                        <br>
                                        <small class="text-muted">{{ subscription.kid.niveau|default('N/A') }}</small>
                                    </td>
                                    <td>{{ subscription.parent.fullName }}</td>
                                    <td>
                                        <a href="{{ path('app_course_show', {'id': subscription.course.id}) }}" class="text-decoration-none">
                                            {{ subscription.course.title }}
                                        </a>
                                    </td>
                                    <td>
                                        {% if subscription.course.level == 'Beginner' %}
                                            <span class="badge bg-success">Débutant</span>
                                        {% elseif subscription.course.level == 'Intermediate' %}
                                            <span class="badge bg-warning text-dark">Intermédiaire</span>
                                        {% else %}
                                            <span class="badge bg-danger">Avancé</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ subscription.subscribedAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        <span class="badge bg-success">Active</span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="{{ path('app_course_show', {'id': subscription.course.id}) }}"
                                               class="btn btn-sm btn-info"
                                               title="Voir le cours">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <form method="post"
                                                  action="{{ path('app_subscription_unsubscribe', {
                                                      'courseId': subscription.course.id,
                                                      'kidId': subscription.kid.id
                                                  }) }}"
                                                  onsubmit="return confirm('Êtes-vous sûr de vouloir désinscrire cet enfant ?');"
                                                  style="display: inline-block; margin-left: 5px;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('unsubscribe' ~ subscription.course.id ~ subscription.kid.id) }}">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Désinscrire">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center text-muted my-5">
                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                        <p class="mt-3">Aucune inscription active.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}