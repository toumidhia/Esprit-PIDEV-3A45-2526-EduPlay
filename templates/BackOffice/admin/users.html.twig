<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin - Eduplay</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen">

<div class="flex">

    {# Sidebar #}
    {% include 'BackOffice/admin/Partials/sidebar.html.twig' %}

    <div class="flex-1 flex flex-col">

        {# Navbar #}
        {% include 'BackOffice/admin/Partials/navbar.html.twig' %}

        {# Content #}
        <main class="flex-1 p-6">

            <!-- Header -->
            <header class="bg-red-600 text-white shadow w-full">
                <div class="px-8 py-6">
                    <h1 class="text-3xl font-bold"> Administration</h1>
                </div>
            </header>

            <!-- Flash messages -->
            <div class="px-8 py-4">
                {% for message in app.flashes('success') %}
                    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                        {{ message }}
                    </div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                        {{ message }}
                    </div>
                {% endfor %}
            </div>

            <!-- Section Administrateurs -->
            <div class="mb-10">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold"> Administrateurs</h2>
                    <a href="{{ path('app_admin_admin_new') }}" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700">
                         Ajouter un admin
                    </a>
                </div>

                {% if admins is empty %}
                    <p class="text-gray-600">Aucun administrateur</p>
                {% else %}
                    <div class="bg-white rounded-lg shadow overflow-hidden">
                        <table class="min-w-full">
                            <thead class="bg-gray-100">
                                <tr>
                                    <th class="px-6 py-3 text-left text-sm font-bold text-gray-700">Nom complet</th>
                                    <th class="px-6 py-3 text-left text-sm font-bold text-gray-700">Email</th>
                                    <th class="px-6 py-3 text-left text-sm font-bold text-gray-700">Date création</th>
                                    <th class="px-6 py-3 text-right text-sm font-bold text-gray-700">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                {% for admin in admins %}
                                    <tr>
                                        <td class="px-6 py-4">
                                            {{ admin.fullName }}
                                            {% if admin.id == app.user.id %}
                                                <span class="ml-2 bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded">Vous</span>
                                            {% endif %}
                                        </td>
                                        <td class="px-6 py-4 text-gray-600">{{ admin.email }}</td>
                                        <td class="px-6 py-4 text-gray-600">{{ admin.createdAt|date('d/m/Y') }}</td>
                                        <td class="px-6 py-4 text-right">
                                            {% if admin.id != app.user.id %}
                                                <form method="post" action="{{ path('app_admin_admin_delete', {id: admin.id}) }}" 
                                                      class="inline"
                                                      onsubmit="return confirm('Supprimer cet administrateur ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ admin.id) }}">
                                                    <button type="submit" class="text-red-600 hover:text-red-800">
                                                        Supprimer
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

            <!-- Section Enseignants -->
            <div>
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold"> Enseignants</h2>
                    <a href="{{ path('app_admin_enseignant_new') }}" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700">
                        Ajouter un enseignant
                    </a>
                </div>

                {% if enseignants is empty %}
                    <p class="text-gray-600">Aucun enseignant</p>
                {% else %}
                    <div class="bg-white rounded-lg shadow overflow-hidden">
                        <table class="min-w-full">
                            <thead class="bg-gray-100">
                                <tr>
                                    <th class="px-6 py-3 text-left text-sm font-bold text-gray-700">Nom complet</th>
                                    <th class="px-6 py-3 text-left text-sm font-bold text-gray-700">Email</th>
                                    <th class="px-6 py-3 text-left text-sm font-bold text-gray-700">Téléphone</th>
                                    <th class="px-6 py-3 text-left text-sm font-bold text-gray-700">Spécialité</th>
                                    <th class="px-6 py-3 text-right text-sm font-bold text-gray-700">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                {% for enseignant in enseignants %}
                                    <tr>
                                        <td class="px-6 py-4">{{ enseignant.fullName }}</td>
                                        <td class="px-6 py-4 text-gray-600">{{ enseignant.email }}</td>
                                        <td class="px-6 py-4 text-gray-600">{{ enseignant.telephone ?? '-' }}</td>
                                        <td class="px-6 py-4 text-gray-600">{{ enseignant.specialite ?? '-' }}</td>
                                        <td class="px-6 py-4 text-right">
                                            <form method="post" action="{{ path('app_admin_enseignant_delete', {id: enseignant.id}) }}" 
                                                  class="inline"
                                                  onsubmit="return confirm('Supprimer cet enseignant ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enseignant.id) }}">
                                                <button type="submit" class="text-red-600 hover:text-red-800">
                                                    Supprimer
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

        </main>

    </div>
</div>

</body>
</html>
