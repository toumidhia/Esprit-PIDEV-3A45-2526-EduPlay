{% extends 'BackOffice/base.html.twig' %}

{% block title %}Dashboard Admin - EduPlay{% endblock %}

{% block content %}
<h1 class="h3 mb-4"><i class="bi bi-speedometer2"></i> Tableau de Bord Administrateur</h1>

{# Statistics Cards #}
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Total Cours</h6>
                        <h2 class="mb-0">{{ totalCourses }}</h2>
                    </div>
                    <div>
                        <i class="bi bi-book" style="font-size: 3rem; color: var(--primary-color);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card stat-card warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">En Attente</h6>
                        <h2 class="mb-0">{{ pendingCourses }}</h2>
                    </div>
                    <div>
                        <i class="bi bi-hourglass-split" style="font-size: 3rem; color: var(--warning-color);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card stat-card success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Acceptés</h6>
                        <h2 class="mb-0">{{ acceptedCourses }}</h2>
                    </div>
                    <div>
                        <i class="bi bi-check-circle" style="font-size: 3rem; color: var(--success-color);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card stat-card primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Inscriptions</h6>
                        <h2 class="mb-0">{{ totalSubscriptions }}</h2>
                    </div>
                    <div>
                        <i class="bi bi-people" style="font-size: 3rem; color: var(--primary-color);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        {# Pending Approvals #}
        <div class="card mb-4">
            <div class="card-header">
                <h5><i class="bi bi-exclamation-circle"></i> Cours en Attente d'Approbation</h5>
            </div>
            <div class="card-body">
                {% if recentPending|length > 0 %}
                    <div class="list-group">
                        {% for course in recentPending %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">{{ course.title }}</h6>
                                        <small class="text-muted">
                                            Par {{ course.teacherId.fullName }} - {{ course.createdAt|date('d/m/Y') }}
                                        </small>
                                    </div>
                                    <div>
                                        <a href="{{ path('app_course_show', {'id': course.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Voir
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted mb-0">Aucun cours en attente</p>
                {% endif %}
            </div>
        </div>

        {# Popular Courses #}
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-trophy"></i> Cours les Plus Populaires</h5>
            </div>
            <div class="card-body">
                {% if popularCourses|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Cours</th>
                                    <th>Niveau</th>
                                    <th>Inscriptions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in popularCourses %}
                                    {% set course = item[0] %}
                                    {% set count = item.subscriptionCount %}
                                    <tr>
                                        <td>{{ course.title }}</td>
                                        <td>
                                            {% if course.level == 'Beginner' %}
                                                <span class="badge bg-success">Débutant</span>
                                            {% elseif course.level == 'Intermediate' %}
                                                <span class="badge bg-warning">Inter.</span>
                                            {% else %}
                                                <span class="badge bg-danger">Avancé</span>
                                            {% endif %}
                                        </td>
                                        <td><strong>{{ count }}</strong> élèves</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">Aucune donnée disponible</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-md-4">
        {# Quick Actions #}
        <div class="card mb-4">
            <div class="card-header">
                <h5><i class="bi bi-lightning"></i> Actions Rapides</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{{ path('app_course_index') }}" class="btn btn-outline-primary">
                        <i class="bi bi-book"></i> Gérer les Cours
                    </a>
                    <a href="{{ path('app_seance_index') }}" class="btn btn-outline-success">
                        <i class="bi bi-calendar-event"></i> Gérer les Séances
                    </a>
                    <a href="{{ path('app_analytics_dashboard') }}" class="btn btn-outline-info">
                        <i class="bi bi-graph-up"></i> Voir les Statistiques
                    </a>
                    <a href="{{ path('app_subscription_list') }}" class="btn btn-outline-warning">
                        <i class="bi bi-people"></i> Voir les Inscriptions
                    </a>
                </div>
            </div>
        </div>

        {# Level Distribution #}
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-pie-chart"></i> Répartition par Niveau</h5>
            </div>
            <div class="card-body">
                {% for level in levelDistribution %}
                    <div class="mb-2">
                        <div class="d-flex justify-content-between">
                            <span>
                                {% if level.level == 'Beginner' %}
                                    Débutant
                                {% elseif level.level == 'Intermediate' %}
                                    Intermédiaire
                                {% else %}
                                    Avancé
                                {% endif %}
                            </span>
                            <strong>{{ level.count }}</strong>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-{% if level.level == 'Beginner' %}success{% elseif level.level == 'Intermediate' %}warning{% else %}danger{% endif %}" 
                                 role="progressbar" 
                                 style="width: {{ (level.count / acceptedCourses * 100)|round }}%">
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
