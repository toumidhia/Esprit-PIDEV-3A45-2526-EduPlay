{% extends 'BackOffice/enseignant/Partials/container.html.twig' %}

{% block title %}Dashboard Enseignant - EduPlay{% endblock %}

{% block content %}
<h1 class="h3 mb-4"><i class="bi bi-person-badge"></i> Tableau de Bord Enseignant</h1>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card stat-card warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Cours en Attente</h6>
                        <h2 class="mb-0">{{ pendingCount }}</h2>
                    </div>
                    <div>
                        <i class="bi bi-hourglass-split" style="font-size: 3rem; color: var(--warning-color);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card stat-card success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Cours Acceptés</h6>
                        <h2 class="mb-0">{{ acceptedCount }}</h2>
                    </div>
                    <div>
                        <i class="bi bi-check-circle" style="font-size: 3rem; color: var(--success-color);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5><i class="bi bi-book"></i> Mes Cours</h5>
        <a href="{{ path('app_course_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Nouveau Cours
        </a>
    </div>
    <div class="card-body">
        {% if myCourses|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Niveau</th>
                            <th>Statut</th>
                            <th>Créé le</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for course in myCourses %}
                            <tr>
                                <td>{{ course.title }}</td>
                                <td>
                                    {% if course.level == 'Beginner' %}
                                        <span class="badge bg-success">Débutant</span>
                                    {% elseif course.level == 'Intermediate' %}
                                        <span class="badge bg-warning">Intermédiaire</span>
                                    {% else %}
                                        <span class="badge bg-danger">Avancé</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if course.status == 'pending' %}
                                        <span class="badge badge-status-pending">En attente</span>
                                    {% elseif course.status == 'accepted' %}
                                        <span class="badge badge-status-accepted">Accepté</span>
                                    {% else %}
                                        <span class="badge badge-status-rejected">Rejeté</span>
                                    {% endif %}
                                </td>
                                <td>{{ course.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('app_course_show', {'id': course.id}) }}" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    {% if course.status == 'pending' %}
                                        <a href="{{ path('app_course_edit', {'id': course.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-center text-muted my-5">
                <i class="bi bi-inbox" style="font-size: 3rem;"></i><br>
                Vous n'avez pas encore créé de cours.
                <br><br>
                <a href="{{ path('app_course_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Créer mon premier cours
                </a>
            </p>
        {% endif %}
    </div>
</div>
{% endblock %}
