<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPlay - Administration{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <script id="tailwind-config">
          tailwind.config = {
            darkMode: "class",
            theme: {
              extend: {
                colors: {
                  "primary": "#63b7f2",
                  "accent-yellow": "#F7C56E",
                  "accent-pink": "#F29BAE",
                  "background-light": "#f6f7f8",
                  "background-dark": "#101b22",
                },
                fontFamily: {
                  "display": ["Plus Jakarta Sans"]
                },
                borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
              },
            },
          }
        </script>
    <style>
          .blob {
            position: absolute;
            filter: blur(60px);
            z-index: -1;
            opacity: 0.4;
          }
          .material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
          }
          :root {
                --primary-color: #63b7f2;
                --secondary-color: #6c757d;
                --success-color: #28a745;
                --danger-color: #dc3545;
                --warning-color: #ffc107;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #f6f7f8;
            }

            /* Sidebar Styles */
            .sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 100;
                padding: 0;
                box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
                background-color: #2c3e50;
                width: var(--sidebar-width);
            }

            .sidebar-sticky {
                position: sticky;
                top: 0;
                height: calc(100vh - 48px);
                padding-top: .5rem;
                overflow-x: hidden;
                overflow-y: auto;
            }

            .sidebar .nav-link {
                color: #e0e0e0;
                padding: 12px 20px;
                font-weight: 500;
                transition: all 0.3s;
            }

            .sidebar .nav-link:hover {
                color: #fff;
                background-color: rgba(255, 255, 255, 0.1);
            }

            .sidebar .nav-link.active {
                color: #fff;
                background-color: var(--primary-color);
            }

            .sidebar .nav-link i {
                margin-right: 10px;
            }

            .sidebar-heading {
                font-size: .75rem;
                text-transform: uppercase;
                padding: 20px 20px 10px;
                color: #a0a0a0;
                font-weight: 600;
            }

            /* Main Content */
           main {
  padding: 20px;
  color: #212529; /* ✅ texte noir bootstrap */
}

            /* Top Navbar */
            .navbar-custom {
                background-color: #fff;
                box-shadow: 0 2px 4px rgba(0,0,0,.08);
            }

            /* Cards */
            .card {
                border: none;
                box-shadow: 0 0 10px rgba(0,0,0,.05);
                margin-bottom: 20px;
            }

            .card-header {
                background-color: #fff;
                border-bottom: 2px solid #f8f9fa;
                font-weight: 600;
            }

            /* Badges */
            .badge-status-pending {
                background-color: #ffc107;
                color: #000;
            }

            .badge-status-accepted {
                background-color: #28a745;
            }

            .badge-status-rejected {
                background-color: #dc3545;
            }

            /* Forms */
            .form-error {
                color: #dc3545;
                font-size: 0.875rem;
                margin-top: 0.25rem;
            }

            .form-control.is-invalid {
                border-color: #dc3545;
            }

            /* Stat Cards */
            .stat-card {
                border-left: 4px solid;
                transition: transform 0.2s;
            }

            .stat-card:hover {
                transform: translateY(-3px);
            }

            .stat-card.primary {
                border-left-color: var(--primary-color);
            }

            .stat-card.success {
                border-left-color: var(--success-color);
            }

            .stat-card.warning {
                border-left-color: var(--warning-color);
            }

            .stat-card.danger {
                border-left-color: var(--danger-color);
            }

            /* Buttons */
            .btn-primary {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
            }

            .btn-primary:hover {
                background-color: #4a9fd6;
                border-color: #4a9fd6;
            }

            /* Table */
            .table thead th {
                border-bottom: 2px solid #dee2e6;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.875rem;
                color: #6c757d;
            }

            /* Search Bar */
            .search-wrapper {
                position: relative;
            }

            .search-wrapper i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
            }

            .search-wrapper input {
                padding-left: 40px;
            }

            /* Logo */
            .sidebar-brand {
                padding: 20px;
                background-color: rgba(0, 0, 0, 0.2);
                color: #fff;
                font-size: 1.5rem;
                font-weight: bold;
                text-align: center;
            }

            .sidebar-brand span {
                color: var(--primary-color);
            }

            /* User avatar */
            .user-avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: bold;
            }

            .bg-admin { background-color: #dc3545; }
            .bg-enseignant { background-color: #28a745; }
            .bg-parent { background-color: #ffc107; color: #000; }
            .bg-enfant { background-color: #17a2b8; }
        </style>
</head>
<body>

{# Unified Premium Navbar #}
<div>
    {% include 'Partials/_navbar.html.twig' %}
</div>

{# Main Content #}
<main>
    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-{% if label == 'success' %}check-circle{% elseif label == 'error' or label == 'danger' %}exclamation-triangle{% else %}info-circle{% endif %}"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
</main>

{# Bootstrap 5 JS Bundle #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>