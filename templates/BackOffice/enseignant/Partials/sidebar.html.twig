{# templates/BackOffice/_sidebar.html.twig #}

<aside class="admin-sidebar w-64 bg-white border-r border-gray-200 flex flex-col h-screen fixed top-0 left-0" style="width: var(--sidebar-width);">

    <!-- Header avec logo -->
    <div class="p-6 border-b border-gray-200">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center">
                <i class="bi bi-mortarboard-fill text-white text-2xl"></i>
            </div>
            <div>
                <h2 class="text-xl font-bold text-gray-900">Edu<span class="text-blue-600">Play</span></h2>
                <p class="text-sm text-gray-500">Teacher</p>
            </div>
        </div>
    </div>

    <!-- Navigation avec scroll -->
    <nav class="sidebar-nav flex-1 p-4 overflow-y-auto" style="max-height: calc(100vh - 180px);">
        <ul class="space-y-1">

            {# ================= COMPTE ================= #}
            <li class="sidebar-heading mt-2 mb-2">
                <div class="flex items-center gap-2 px-4">
                    <div class="w-1 h-4 bg-gradient-to-b from-blue-500 to-indigo-600 rounded-full"></div>
                    <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Compte</span>
                </div>
            </li>

            <li>
                <a href="{{ path('teacher_game_index') }}"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 {% if app.request.get('_route') starts with 'teacher_game' %}bg-gradient-to-r from-blue-50 to-indigo-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-50{% endif %}">
                    <i class="bi bi-controller text-lg"></i>
                    <span class="font-medium">Game</span>
                </a>
            </li>

            <li>
                <a href="{{ path('teacher_level_index') }}"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 {% if app.request.get('_route') starts with 'teacher_level' %}bg-gradient-to-r from-blue-50 to-indigo-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-50{% endif %}">
                    <i class="bi bi-bar-chart text-lg"></i>
                    <span class="font-medium">Level</span>
                </a>
            </li>

            <li>
                <a href="{{ path('app_course_index') }}"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 {% if app.request.get('_route') starts with 'app_course' %}bg-gradient-to-r from-blue-50 to-indigo-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-50{% endif %}">
                    <i class="bi bi-journal-bookmark text-lg"></i>
                    <span class="font-medium">Cours</span>
                </a>
            </li>

        </ul>
    </nav>

    <!-- Footer avec déconnexion -->
    <div class="p-4 border-t border-gray-200 mt-auto">
        <a href="{{ path('app_logout') }}" 
           class="flex items-center gap-3 p-3 bg-gradient-to-r from-red-50 to-rose-50 rounded-xl hover:from-red-100 hover:to-rose-100 transition-all duration-200 group">
            <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg flex items-center justify-center">
                <i class="bi bi-box-arrow-right text-white text-sm"></i>
            </div>
            <div>
                <span class="font-medium text-red-600">Déconnexion</span>
                <p class="text-xs text-gray-500">{{ app.user.firstName }} {{ app.user.lastName }}</p>
            </div>
        </a>
    </div>
</aside>

<style>
/* Scrollbar personnalisée */
.sidebar-nav::-webkit-scrollbar {
    width: 4px;
}
.sidebar-nav::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
.sidebar-nav::-webkit-scrollbar-thumb { background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%); border-radius: 4px; }
.sidebar-nav::-webkit-scrollbar-thumb:hover { background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%); }

/* Animation ripple sur clic */
.admin-sidebar a { position: relative; overflow: hidden; }
.admin-sidebar a::after {
    content: ''; position: absolute; top: 50%; left: 50%; width: 0; height: 0;
    border-radius: 50%; background: rgba(59, 130, 246, 0.1); transform: translate(-50%, -50%);
    transition: width 0.3s, height 0.3s;
}
.admin-sidebar a:active::after { width: 200px; height: 200px; }

/* Hover icons */
.admin-sidebar a:hover i { transform: scale(1.1); transition: transform 0.2s; }
.admin-sidebar a i { transition: transform 0.2s; }

/* Animation entrée */
@keyframes slideIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
.admin-sidebar li { animation: slideIn 0.3s ease-out forwards; opacity: 0; }
{% for i in 0..20 %}
.admin-sidebar li:nth-child({{ i }}) { animation-delay: {{ i * 0.02 }}s; }
{% endfor %}
</style>