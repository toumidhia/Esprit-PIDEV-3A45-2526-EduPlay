{% extends 'BackOffice/enseignant/Partials/container.html.twig' %}

{% block title %}Nouveau Cours - EduPlay{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <a href="{{ path('app_course_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors mb-4">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Retour à la liste des cours
        </a>
        <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-4xl">add_circle</span>
            Créer un nouveau cours
        </h1>
        <p class="mt-2 text-sm text-gray-500">Remplissez les informations ci-dessous pour proposer un nouveau cours.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="border-b border-gray-100 bg-gray-50/50 px-8 py-5">
            <h2 class="text-lg font-semibold text-gray-900">Informations générales</h2>
        </div>
        
        <div class="p-8">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-6'}}) }}
            
            {# Error Messages #}
            {% if form.vars.errors|length > 0 %}
                <div class="rounded-lg bg-red-50 p-4 border border-red-100 mb-6">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <span class="material-symbols-outlined text-red-400">error</span>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">Erreur lors de la soumission</h3>
                            <div class="mt-2 text-sm text-red-700">
                                {{ form_errors(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Titre #}
            <div>
                {{ form_label(form.title, "Titre du cours", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.title, {'attr': {
                    'class': 'w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors ' ~ (form.title.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                    'placeholder': 'Ex: Introduction à la programmation'
                }}) }}
                {% if form.title.vars.errors|length > 0 %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.title) }}</p>
                {% endif %}
            </div>

            {# Description #}
            <div>
                {{ form_label(form.description, "Description complète", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.description, {'attr': {
                    'class': 'w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors ' ~ (form.description.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                    'rows': '5',
                    'placeholder': 'Décrivez ce que les élèves vont apprendre...'
                }}) }}
                {% if form.description.vars.errors|length > 0 %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.description) }}</p>
                {% endif %}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {# Durée #}
                <div>
                    {{ form_label(form.durationTraining, "Durée (en semaines)", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.durationTraining, {'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors ' ~ (form.durationTraining.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                        'placeholder': 'Ex: 4'
                    }}) }}
                    {% if form.durationTraining.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600">{{ form_errors(form.durationTraining) }}</p>
                    {% endif %}
                </div>

                {# Niveau #}
                <div>
                    {{ form_label(form.level, "Niveau ciblé", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.level, {'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors ' ~ (form.level.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : '')
                    }}) }}
                    {% if form.level.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600">{{ form_errors(form.level) }}</p>
                    {% endif %}
                </div>
            </div>

            {# Support PDF #}
            <div class="pt-4 border-t border-gray-100">
                <div class="flex items-start gap-4">
                    <div class="size-12 rounded-xl bg-gray-50 border border-gray-200 flex items-center justify-center text-gray-400 shrink-0">
                        <span class="material-symbols-outlined">upload_file</span>
                    </div>
                    <div class="flex-grow">
                        {{ form_label(form.pdfFile, "Support de cours (PDF)", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.pdfFile, {'attr': {
                            'class': 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20 transition-all ' ~ (form.pdfFile.vars.errors|length > 0 ? 'border-red-300 text-red-600' : '')
                        }}) }}
                        <p class="mt-1.5 text-xs text-gray-500">Optionnel. Vous pouvez joindre un document PDF pour vos élèves.</p>
                        {% if form.pdfFile.vars.errors|length > 0 %}
                            <p class="mt-1 text-sm text-red-600">{{ form_errors(form.pdfFile) }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a href="{{ path('app_course_index') }}" class="px-5 py-2.5 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
                    Annuler
                </a>
                <button type="submit" class="px-5 py-2.5 bg-primary hover:bg-primary/90 text-white font-medium rounded-lg shadow-sm transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">save</span>
                    Créer le cours
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}