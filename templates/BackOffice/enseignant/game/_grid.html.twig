{# templates/teacher/game/_grid.html.twig #}

{% if games|length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for game in games %}
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all">
                <div class="p-4 flex justify-between items-start">
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary">
                        <span class="material-symbols-outlined text-sm">category</span>
                        {{ game.type|upper }}
                    </span>

                    {% if game.idLevel is not null %}
                        <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-bold">
                            {{ game.idLevel.name }}
                        </span>
                    {% endif %}
                </div>

                <div class="px-6 pb-6">
                    <h3 class="text-xl font-bold mb-2 text-[#111518] dark:text-white">{{ game.name }}</h3>
                    <p class="text-sm text-[#617989] dark:text-gray-400 mb-4 line-clamp-2">{{ game.description }}</p>

                    {% if game.image %}
                        <div class="flex items-center gap-2 text-sm text-[#617989] dark:text-gray-400 mb-4">
                            <span class="material-symbols-outlined text-sm">image</span>
                            <span class="truncate">{{ game.image }}</span>
                        </div>
                    {% endif %}

                    <div class="flex flex-wrap gap-2 mt-4">
                        <a href="{{ path('teacher_game_show', {'id': game.id}) }}"
                           class="flex-1 text-center px-4 py-2 bg-primary/10 text-primary rounded-lg font-bold hover:bg-primary/20 transition-colors">
                            View
                        </a>

                        
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-xl">
        <span class="material-symbols-outlined text-6xl text-[#617989] dark:text-gray-400 mb-4">sports_esports</span>
        <h3 class="text-xl font-bold text-[#617989] dark:text-gray-400 mb-2">No Games Found</h3>
        <p class="text-[#617989] dark:text-gray-400 mb-4">Try adjusting your filters or create a new game!</p>
    </div>
{% endif %}
