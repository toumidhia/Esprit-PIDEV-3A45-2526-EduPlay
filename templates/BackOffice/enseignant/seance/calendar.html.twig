{% extends 'BackOffice/enseignant/Partials/container.html.twig' %}

{% block title %}Calendrier des Séances{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.css' rel='stylesheet' />
    <style>
        .fc-event { cursor: pointer; }
        .fc-toolbar-title { font-size: 1.25rem !important; font-weight: 700 !important; }
        .fc-button-primary { background-color: var(--color-primary-600, #4f46e5) !important; border-color: var(--color-primary-600, #4f46e5) !important; }
    </style>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-4xl">calendar_month</span>
                Calendrier des Séances
            </h1>
            <p class="text-gray-500 mt-2">Consultez l'emploi du temps global de vos cours.</p>
        </div>
        <div class="flex gap-3">
            <a href="{{ path('app_seance_index', {'view': 'list'}) }}" class="inline-flex items-center px-4 py-2.5 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors shadow-sm">
                <span class="material-symbols-outlined mr-2">list</span>
                Vue Liste
            </a>
            <a href="{{ path('app_seance_new') }}" class="inline-flex items-center px-4 py-2.5 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary/90 transition-colors shadow-sm">
                <span class="material-symbols-outlined mr-2">add</span>
                Nouvelle Séance
            </a>
        </div>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
        <div id="calendar"></div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.js'></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/locales/fr.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'fr',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                events: {{ seances|json_encode|raw }},
                eventClick: function(info) {
                    window.location.href = '/seance/' + info.event.id;
                }
            });
            calendar.render();
        });
    </script>
{% endblock %}
