{% extends 'BackOffice/enseignant/Partials/container.html.twig' %}

{% block title %}Gérer les Séances - EduPlay{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {# Header Section #}
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-4xl">calendar_month</span>
                Gestion des Séances
            </h1>
            <p class="mt-2 text-sm text-gray-500">Planifiez et gérez les sessions en direct pour vos cours.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
            <a href="{{ path('app_subscription_list') }}" class="inline-flex justify-center items-center gap-2 px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                <span class="material-symbols-outlined text-sm">group</span>
                Inscriptions
            </a>
            <a href="{{ path('app_seance_new') }}" class="inline-flex justify-center items-center gap-2 px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-primary hover:bg-primary/90 transition-colors">
                <span class="material-symbols-outlined text-sm">add</span>
                Nouvelle Séance
            </a>
        </div>
    </div>

    {# Main Content Card #}
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="border-b border-gray-100 bg-gray-50/50 px-6 py-4 flex justify-between items-center">
            <h2 class="text-lg font-semibold text-gray-900">
                Liste des Séances <span class="ml-2 py-0.5 px-2.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{{ seances|length }}</span>
            </h2>
        </div>

        {% if seances|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Séance & Cours</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Heure</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Lieu / Lien</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for seance in seances %}
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-bold text-gray-900">{{ seance.title|default('Séance #' ~ seance.id) }}</span>
                                        <span class="text-xs text-gray-500 line-clamp-1 mt-1 max-w-xs">{{ seance.course.title }}</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-medium text-gray-900 flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-xs text-gray-400">event</span>
                                            {{ seance.date|date('d/m/Y') }}
                                        </span>
                                        <span class="text-xs text-gray-500 mt-1 flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-xs text-gray-400">schedule</span>
                                            {{ seance.startTime|date('H:i') }} - {{ seance.endTime|date('H:i') }}
                                        </span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-600 flex items-center gap-1.5 max-w-[200px] truncate" title="{{ seance.location }}">
                                        <span class="material-symbols-outlined text-xs text-gray-400">location_on</span>
                                        {{ seance.location|default('Non spécifié') }}
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if seance.status == 'scheduled' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            Planifiée
                                        </span>
                                    {% elseif seance.status == 'ongoing' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5 animate-pulse"></span>
                                            En cours
                                        </span>
                                    {% elseif seance.status == 'completed' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            Terminée
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            Annulée
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="{{ path('app_seance_show', {'id': seance.id}) }}" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Voir les détails">
                                            <span class="material-symbols-outlined text-[20px]">visibility</span>
                                        </a>
                                        <a href="{{ path('app_seance_edit', {'id': seance.id}) }}" class="p-1.5 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="Modifier">
                                            <span class="material-symbols-outlined text-[20px]">edit</span>
                                        </a>
                                        <form method="post" action="{{ path('app_seance_delete', {'id': seance.id}) }}" style="display:inline;" onsubmit="return confirm('Voulez-vous vraiment supprimer cette séance ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ seance.id) }}">
                                            <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Supprimer">
                                                <span class="material-symbols-outlined text-[20px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="p-16 text-center">
                <div class="inline-flex items-center justify-center size-20 rounded-full bg-gray-50 text-gray-400 mb-6">
                    <span class="material-symbols-outlined text-4xl">event_busy</span>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">Aucune séance planifiée</h3>
                <p class="text-gray-500 max-w-sm mx-auto mb-6">Vous n'avez pas encore programmé de séances en direct pour vos élèves.</p>
                <a href="{{ path('app_seance_new') }}" class="inline-flex justify-center items-center gap-2 px-6 py-3 border border-transparent shadow-sm text-sm font-medium rounded-xl text-white bg-primary hover:bg-primary/90 transition-all hover:-translate-y-0.5">
                    <span class="material-symbols-outlined">add</span>
                    Programmer une séance
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
