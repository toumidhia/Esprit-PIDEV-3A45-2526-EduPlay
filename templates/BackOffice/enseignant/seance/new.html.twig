{% extends 'BackOffice/enseignant/Partials/container.html.twig' %}

{% block title %}Nouvelle Séance - EduPlay{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <a href="{{ path('app_seance_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors mb-4">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Retour à l'agenda
        </a>
        <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-4xl">event_available</span>
            Programmer une séance
        </h1>
        <p class="mt-2 text-sm text-gray-500">Créer une session d'apprentissage en direct rattachée à l'un de vos cours.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="border-b border-gray-100 bg-gray-50/50 px-8 py-5">
            <h2 class="text-lg font-semibold text-gray-900">Détails de la session</h2>
        </div>
        
        <div class="p-8">
            {# Form Error Handling #}
            {% if form.vars.errors|length > 0 %}
                <div class="rounded-lg bg-red-50 p-4 border border-red-100 mb-8 flex items-start gap-3">
                    <span class="material-symbols-outlined text-red-500 mt-0.5">error</span>
                    <div>
                        <h3 class="text-sm font-bold text-red-800">Des erreurs ont été trouvées :</h3>
                        <div class="mt-2 text-sm text-red-700">
                            {{ form_errors(form) }}
                        </div>
                    </div>
                </div>
            {% endif %}

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-6'}}) }}

            {# Cours associé #}
            <div>
                {{ form_label(form.course, 'Cours associé', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                {{ form_widget(form.course, {'attr': {
                    'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors bg-white shadow-sm ' ~ (form.course.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : '')
                }}) }}
                <p class="mt-1.5 text-xs text-gray-500 flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">info</span>
                    Seuls les cours acceptés par l'administration sont disponibles.
                </p>
                {% if form.course.vars.errors|length > 0 %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.course) }}</p>
                {% endif %}
            </div>

            {# Titre #}
            <div>
                {{ form_label(form.title, 'Titre de la séance', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                {{ form_widget(form.title, {'attr': {
                    'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors bg-white shadow-sm ' ~ (form.title.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                    'placeholder': 'Ex: Introduction à la programmation - Partie 1'
                }}) }}
                {% if form.title.vars.errors|length > 0 %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.title) }}</p>
                {% endif %}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {# Date #}
                <div>
                    {{ form_label(form.date, 'Date de la séance', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-gray-400 text-lg">calendar_today</span>
                        </div>
                        {{ form_widget(form.date, {'attr': {
                            'class': 'w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors bg-white shadow-sm ' ~ (form.date.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                            'placeholder': 'JJ/MM/AAAA'
                        }}) }}
                    </div>
                    {% if form.date.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600">{{ form_errors(form.date) }}</p>
                    {% endif %}
                </div>

                {# Heure début #}
                <div>
                    {{ form_label(form.startTime, 'Heure de début', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-gray-400 text-lg">schedule</span>
                        </div>
                        {{ form_widget(form.startTime, {'attr': {
                            'class': 'w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors bg-white shadow-sm ' ~ (form.startTime.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                            'placeholder': 'HH:MM'
                        }}) }}
                    </div>
                    {% if form.startTime.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600">{{ form_errors(form.startTime) }}</p>
                    {% endif %}
                </div>

                {# Heure fin #}
                <div>
                    {{ form_label(form.endTime, 'Heure de fin', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-gray-400 text-lg">timelapse</span>
                        </div>
                        {{ form_widget(form.endTime, {'attr': {
                            'class': 'w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors bg-white shadow-sm ' ~ (form.endTime.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                            'placeholder': 'HH:MM'
                        }}) }}
                    </div>
                    {% if form.endTime.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600">{{ form_errors(form.endTime) }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {# Lieu #}
                <div>
                    {{ form_label(form.location, 'Lieu ou URL', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-gray-400 text-lg">location_on</span>
                        </div>
                        {{ form_widget(form.location, {'attr': {
                            'class': 'w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors bg-white shadow-sm ' ~ (form.location.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                            'placeholder': 'Ex: Salle 101 ou Lien Zoom'
                        }}) }}
                    </div>
                    {% if form.location.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600">{{ form_errors(form.location) }}</p>
                    {% endif %}
                </div>

                {# Statut #}
                <div>
                    {{ form_label(form.status, 'Statut', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                    {{ form_widget(form.status, {'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors bg-white shadow-sm ' ~ (form.status.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : '')
                    }}) }}
                    {% if form.status.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600">{{ form_errors(form.status) }}</p>
                    {% endif %}
                </div>
            </div>

            {# Description #}
            <div>
                {{ form_label(form.description, 'Description de la séance', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                {{ form_widget(form.description, {'attr': {
                    'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors shadow-sm resize-y ' ~ (form.description.vars.errors|length > 0 ? 'border-red-300 focus:border-red-500 focus:ring-red-200' : ''),
                    'rows': 4,
                    'placeholder': 'Décrivez le programme ou les préparatifs requis pour cette session.'
                }}) }}
                {% if form.description.vars.errors|length > 0 %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.description) }}</p>
                {% endif %}
            </div>

            <div class="pt-6 mt-2 border-t border-gray-100 flex items-center justify-end gap-3">
                <a href="{{ path('app_seance_index') }}" class="px-5 py-2.5 border border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-colors">
                    Annuler
                </a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary hover:bg-primary/90 text-white font-semibold rounded-xl transition-all shadow-sm shadow-primary/20 hover:shadow-md">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    Planifier la séance
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}