<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Teacher Dashboard{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .admin-sidebar { transition: all 0.3s ease; }
        @media (max-width: 768px) {
            .admin-sidebar { position: fixed; left: -100%; z-index: 1000; }
            .admin-sidebar.active { left: 0; }
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">
<div class="flex">
    {# Sidebar #}
    {% include 'BackOffice/teacher/Partials/sidebar.html.twig' %}

    {# Right content #}
    <div class="flex-1 flex flex-col">
        {# Navbar si tu veux #}
        {# {% include 'BackOffice/teacher/Partials/navbar.html.twig' %} #}

        <main class="flex-1 p-6">
            <div class="max-w-7xl mx-auto">
                {% block body %}{% endblock %}
            </div>
        </main>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
    const sidebar = document.querySelector('.admin-sidebar');
    if (mobileMenuBtn) {
        mobileMenuBtn.addEventListener('click', () => sidebar.classList.toggle('active'));
    }
});
</script>
</body>
</html>
