{{ form_start(form, {'attr': {'id': 'game-form','class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

<div class="space-y-4">
    <div>
        {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-bold text-[#111518] dark:text-white mb-2'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-3 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
        <div class="text-red-600 text-sm mt-1">{{ form_errors(form.name) }}</div>
        {% if form.name.vars.help is defined %}
            <p class="text-xs text-[#617989] dark:text-gray-400 mt-1">{{ form.name.vars.help }}</p>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.type, null, {'label_attr': {'class': 'block text-sm font-bold text-[#111518] dark:text-white mb-2'}}) }}
            {{ form_widget(form.type, {'attr': {'class': 'w-full px-4 py-3 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
            <div class="text-red-600 text-sm mt-1">{{ form_errors(form.type) }}</div>
            {% if form.type.vars.help is defined %}
                <p class="text-xs text-[#617989] dark:text-gray-400 mt-1">{{ form.type.vars.help }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.idLevel, null, {'label_attr': {'class': 'block text-sm font-bold text-[#111518] dark:text-white mb-2'}}) }}
            {{ form_widget(form.idLevel, {'attr': {'class': 'w-full px-4 py-3 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
            <div class="text-red-600 text-sm mt-1">{{ form_errors(form.idLevel) }}</div>
        </div>
    </div>

    <div>
        {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-bold text-[#111518] dark:text-white mb-2'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-3 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
        <div class="text-red-600 text-sm mt-1">{{ form_errors(form.description) }}</div>
        {% if form.description.vars.help is defined %}
            <p class="text-xs text-[#617989] dark:text-gray-400 mt-1">{{ form.description.vars.help }}</p>
        {% endif %}
    </div>
    {# preview temp en NEW si validation échoue #}
{# preview si image temp existe #}
{% if form.imageTemp.vars.value %}
  <div class="mb-4">
    <p class="font-bold mb-2">Image sélectionnée :</p>
    <img src="{{ asset('uploads/tmp/' ~ form.imageTemp.vars.value) }}"
         class="w-48 rounded-lg border" alt="temp">
  </div>
{% endif %}

{{ form_widget(form.imageTemp) }}

{% if game.image %}
    <div class="mb-4">
        <p class="font-bold mb-2">Image actuelle :</p>
        <img src="{{ asset('uploads/games/' ~ game.image) }}"
             alt="{{ game.name }}"
             class="w-48 rounded-lg border">
    </div>
{% endif %}
    <div>
        {{ form_label(form.image, null, {'label_attr': {'class': 'block text-sm font-bold text-[#111518] dark:text-white mb-2'}}) }}
        {{ form_widget(form.image, {'attr': {'class': 'w-full px-4 py-3 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
        <div class="text-red-600 text-sm mt-1">{{ form_errors(form.image) }}</div>
        {% if form.image.vars.help is defined %}
            <p class="text-xs text-[#617989] dark:text-gray-400 mt-1">{{ form.image.vars.help }}</p>
        {% endif %}
    </div>
</div>


<div class="flex gap-4 mt-6">
    <button type="submit" class="flex-1 px-6 py-3 bg-primary text-white rounded-full font-bold hover:scale-105 transition-transform shadow-lg">
        <span class="material-symbols-outlined text-sm inline">save</span>
        Save Game
    </button>

    <a href="{{ path('teacher_game_index') }}" class="flex-1 text-center px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#111518] dark:text-white rounded-full font-bold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
        Cancel
    </a>
</div>

{{ form_end(form) }}
