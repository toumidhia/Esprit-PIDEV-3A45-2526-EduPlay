<form method="post"
      action="{{ path('teacher_level_delete', {'id': level.id}) }}"
      onsubmit="return confirm('Are you sure you want to delete this level? This action cannot be undone.');"
      class="inline">

    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ level.id) }}">

    <button type="submit"
            class="flex items-center gap-2 px-6 py-3 bg-red-500 text-white rounded-full font-bold hover:bg-red-600 transition-colors">
        <span class="material-symbols-outlined">delete</span>
        Delete Level
    </button>
</form>




