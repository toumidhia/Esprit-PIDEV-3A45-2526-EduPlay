{{ form_start(form, {'attr': {'id': 'level-form','class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

<div class="space-y-4">
  <div>
    {{ form_label(form.name, null, {'label_attr': {'class':'block text-sm font-bold mb-2'}}) }}
    {{ form_widget(form.name, {'attr': {'class':'w-full px-4 py-3 rounded-lg border'}}) }}
    <div class="text-red-600 text-sm mt-1">{{ form_errors(form.name) }}</div>
  </div>

  <div>
    {{ form_label(form.description, null, {'label_attr': {'class':'block text-sm font-bold mb-2'}}) }}
    {{ form_widget(form.description, {'attr': {'class':'w-full px-4 py-3 rounded-lg border'}}) }}
    <div class="text-red-600 text-sm mt-1">{{ form_errors(form.description) }}</div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      {{ form_label(form.difficulty, null, {'label_attr': {'class':'block text-sm font-bold mb-2'}}) }}
      {{ form_widget(form.difficulty, {'attr': {'class':'w-full px-4 py-3 rounded-lg border'}}) }}
      <div class="text-red-600 text-sm mt-1">{{ form_errors(form.difficulty) }}</div>
    </div>

    <div>
      {{ form_label(form.minAge, null, {'label_attr': {'class':'block text-sm font-bold mb-2'}}) }}
      {{ form_widget(form.minAge, {'attr': {'class':'w-full px-4 py-3 rounded-lg border'}}) }}
      <div class="text-red-600 text-sm mt-1">{{ form_errors(form.minAge) }}</div>
    </div>

    <div>
      {{ form_label(form.maxAge, null, {'label_attr': {'class':'block text-sm font-bold mb-2'}}) }}
      {{ form_widget(form.maxAge, {'attr': {'class':'w-full px-4 py-3 rounded-lg border'}}) }}
      <div class="text-red-600 text-sm mt-1">{{ form_errors(form.maxAge) }}</div>
    </div>

    <div>
      {{ form_label(form.pedagGoal, null, {'label_attr': {'class':'block text-sm font-bold mb-2'}}) }}
      {{ form_widget(form.pedagGoal, {'attr': {'class':'w-full px-4 py-3 rounded-lg border'}}) }}
      <div class="text-red-600 text-sm mt-1">{{ form_errors(form.pedagGoal) }}</div>
    </div>
  </div>
</div>
{% if form_errors(form) %}
    <div class="mb-4 p-3 rounded-lg bg-red-100 text-red-800 text-sm">
        {{ form_errors(form) }}
    </div>
{% endif %}
<div class="flex gap-4 mt-6">
  <button type="submit" class="flex-1 px-6 py-3 bg-primary text-white rounded-full font-bold">
    Save Level
  </button>

  <a href="{{ path('teacher_level_index') }}"
     class="flex-1 text-center px-6 py-3 bg-gray-200 rounded-full font-bold">
    Cancel
  </a>
</div>

{{ form_end(form) }}
