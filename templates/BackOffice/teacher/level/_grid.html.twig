{% if levels|length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for level in levels %}
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all">
                <div class="p-4 flex justify-between items-start">
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary">
                        <span class="material-symbols-outlined text-sm">signal_cellular_alt</span>
                        DIFF {{ level.difficulty }}
                    </span>

                    <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-bold">
                        {{ level.minAge }}-{{ level.maxAge }} yrs
                    </span>
                </div>

                <div class="px-6 pb-6">
                    <h3 class="text-xl font-bold mb-2 text-[#111518] dark:text-white">{{ level.name }}</h3>
                    <p class="text-sm text-[#617989] dark:text-gray-400 mb-4 line-clamp-2">
                        {{ level.description }}
                    </p>

                    <div class="flex flex-wrap gap-2 mt-4">
                        <a href="{{ path('teacher_level_show', {'id': level.id}) }}"
                           class="flex-1 text-center px-4 py-2 bg-primary/10 text-primary rounded-lg font-bold hover:bg-primary/20 transition-colors">
                            View
                        </a>

                        
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-xl">
        <span class="material-symbols-outlined text-6xl text-[#617989] dark:text-gray-400 mb-4">signal_cellular_alt</span>
        <h3 class="text-xl font-bold text-[#617989] dark:text-gray-400 mb-2">No Levels Found</h3>
        <p class="text-[#617989] dark:text-gray-400 mb-4">Try adjusting your filters or create a new level!</p>
    </div>
{% endif %}
