<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription Parent - Eduplay</title>
    <script src="https://cdn.tailwindcss.com"></script>
    
</head>
<body class="bg-gray-50">
    <div class="min-h-screen flex items-center justify-center py-12 px-4">
        <div class="max-w-2xl w-full bg-white rounded-lg shadow-lg p-8">
            <h2 class="text-3xl font-bold text-center mb-8">Créer un compte parent</h2>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-4 rounded-lg {{ label == 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
            {% import '_form_errors.html.twig' as ferrors %}

            {{ form_start(registrationForm, { 'action': path('app_register'), 'method': 'POST', 'attr': {'class': 'registration-form'} }) }}
                <div class="mb-4 form-errors">
                    {{ ferrors.show(registrationForm) }}
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        {{ form_label(registrationForm.lastName, 'Nom', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                        {{ form_widget(registrationForm.lastName, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                        {{ ferrors.show(registrationForm.lastName) }}
                    </div>
                    <div>
                        {{ form_label(registrationForm.firstName, 'Prénom', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                        {{ form_widget(registrationForm.firstName, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                        {{ ferrors.show(registrationForm.firstName) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                    {{ ferrors.show(registrationForm.email) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.telephone, 'Téléphone', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                    {{ form_widget(registrationForm.telephone, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                    {{ ferrors.show(registrationForm.telephone) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.adresse, 'Adresse', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                    {{ form_widget(registrationForm.adresse, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                    {{ ferrors.show(registrationForm.adresse) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.password.first, 'Mot de passe', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                    <p class="text-sm text-gray-500 mb-1">Requis – minimum 6 caractères</p>
                    {{ form_widget(registrationForm.password.first, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500', 'required': true}}) }}
                    {{ ferrors.show(registrationForm.password.first) }}
                </div>

                <div class="mb-6">
                    {{ form_label(registrationForm.password.second, 'Confirmer le mot de passe', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                    {{ form_widget(registrationForm.password.second, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500', 'required': true}}) }}
                    {{ ferrors.show(registrationForm.password.second) }}
                </div>

                <div class="">
                    <button type="submit" name="submit" aria-label="Créer mon compte" class="w-full bg-blue-500 text-white font-bold py-3 rounded-lg hover:bg-blue-600 focus:outline-none">
                        Créer mon compte
                    </button>
                </div>

                <div class="text-center mt-4">
                    <p class="text-gray-600">Vous avez déjà un compte ?</p>
                    <a href="{{ path('app_login') }}" class="text-blue-500 hover:underline">Se connecter</a>
                </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>

    
</body>
</html>