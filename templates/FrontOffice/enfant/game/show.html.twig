{% extends 'FrontOffice/enfant/Partials/container.html.twig' %}

{% block content %}

<div class="max-w-3xl mx-auto px-6 py-10 text-center">
<div class="mt-8 flex ">
    <a href="{{ path('front_games') }}"
       class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-white font-bold hover:scale-105 transition shadow-lg">
       
        <span class="material-symbols-outlined">arrow_back</span>
        Retour aux jeux
    </a>
</div>


    {# Nom du jeu #}
    <h1 class="text-4xl font-extrabold mb-6">
        {{ game.name }}
    </h1>

    {# Image grande et centrée #}
    <div class="flex justify-center mb-8">
        <img
            src="{{ asset('uploads/games/' ~ game.image) }}"
            class="w-full max-w-xl h-auto rounded-xl shadow-lg object-cover"
            alt="{{ game.name }}"
        >
    </div>

    {# Description normale #}
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow p-6 mb-6">
        <h2 class="text-xl font-bold mb-3">
            Description
        </h2>

        <p class="text-gray-700 dark:text-gray-300 text-lg">
            {{ game.description }}
        </p>
    </div>

    {# Résumé IA #}
    <div class="bg-blue-50 dark:bg-gray-800 rounded-xl shadow p-6">
        <h2 class="text-xl font-bold mb-3 text-primary">
            Résumé adapté à ton âge
        </h2>

        <p  id="ai-summary" class="text-gray-700 dark:text-gray-300 text-lg">
            {{ aiSummary ?: game.description }}
        </p>
        <div class="mt-4 flex justify-center gap-3">
  <button type="button"
          class="px-4 py-2 rounded-lg bg-green-600 text-white"
          id="btn-en">🇬🇧 English</button>

  <button type="button"
          class="px-4 py-2 rounded-lg bg-purple-600 text-white"
          id="btn-ar">🇹🇳 عربي</button>

  <button type="button"
          class="px-4 py-2 rounded-lg bg-gray-600 text-white"
          id="btn-fr">🇫🇷 Français</button>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const el = document.getElementById('ai-summary');
  el.dataset.original = el.innerText;

  async function doTranslate(lang) {
    const original = el.dataset.original || el.innerText;

    const res = await fetch('{{ path("app_translate") }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: original, source: 'fr', target: lang })
    });

    const data = await res.json();

    if (data.translatedText) {
      el.innerText = data.translatedText;
      el.dir = (lang === 'ar') ? 'rtl' : 'ltr';
    }
  }

  document.getElementById('btn-en').addEventListener('click', () => doTranslate('en'));
  document.getElementById('btn-ar').addEventListener('click', () => doTranslate('ar'));
  document.getElementById('btn-fr').addEventListener('click', () => {
    el.innerText = el.dataset.original;
    el.dir = 'ltr';
  });
});
</script>
    </div>
    

</div>


{% endblock %}