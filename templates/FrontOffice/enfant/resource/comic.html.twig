{% extends 'FrontOffice/base.html.twig' %}
{% block title %}BD — {{ resource.title }}{% endblock %}

{% block content %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@400;700&display=swap');

    body { background: #fff9e6; }

    .comic-title {
        font-family: 'Bangers', cursive;
        font-size: 3rem;
        text-align: center;
        color: #1a1a1a;
        text-shadow: 3px 3px 0px #f59e0b;
        letter-spacing: 3px;
        margin-bottom: 30px;
    }

    .comic-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        max-width: 900px;
        margin: 0 auto;
        border: 4px solid #1a1a1a;
        background: #1a1a1a;
    }

    .comic-cell {
        background: white;
        position: relative;
        min-height: 280px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .comic-cell-full {
        grid-column: 1 / -1;
        background: white;
        position: relative;
        min-height: 200px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .comic-narrator {
        font-family: 'Comic Neue', cursive;
        font-weight: 700;
        font-size: 0.75rem;
        background: #1a1a1a;
        color: white;
        padding: 4px 10px;
    }

    .comic-cell img, .comic-cell-full img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .comic-cell-full img { height: 160px; }

    .speech-bubble {
        position: relative;
        background: white;
        border: 3px solid #1a1a1a;
        border-radius: 20px;
        padding: 8px 12px;
        margin: 8px;
        font-family: 'Comic Neue', cursive;
        font-weight: 700;
        font-size: 0.85rem;
        text-align: center;
    }

    .speech-bubble::before {
        content: '';
        position: absolute;
        top: -12px; left: 20px;
        border-left: 8px solid transparent;
        border-right: 8px solid transparent;
        border-bottom: 12px solid #1a1a1a;
    }

    .speech-bubble::after {
        content: '';
        position: absolute;
        top: -8px; left: 22px;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-bottom: 10px solid white;
    }

    .case-number {
        position: absolute;
        top: 4px; right: 8px;
        font-family: 'Bangers', cursive;
        font-size: 1.2rem;
        color: #f59e0b;
        z-index: 3;
    }

    /* Loading */
    #loadingScreen {
        max-width: 500px;
        margin: 60px auto;
        text-align: center;
        padding: 40px;
        background: white;
        border-radius: 24px;
        border: 4px solid #1a1a1a;
        box-shadow: 8px 8px 0 #f59e0b;
    }

    .spinner {
        width: 60px; height: 60px;
        border: 6px solid #f3f3f3;
        border-top: 6px solid #f59e0b;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 20px auto;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .step { display: flex; align-items: center; gap-10px; margin: 8px 0; font-size: 0.9rem; }
    .step.done { color: #16a34a; }
    .step.active { color: #f59e0b; font-weight: bold; }
    .step.pending { color: #9ca3af; }

    @media (max-width: 640px) {
        .comic-grid { grid-template-columns: 1fr; }
        .comic-cell-full { grid-column: 1; }
        .comic-title { font-size: 2rem; }
    }
</style>

<div class="min-h-screen p-6" style="background: #fff9e6;">

    <!-- HEADER -->
    <div class="max-w-900 mx-auto mb-6 bg-gray-900 text-white rounded-2xl p-5 flex justify-between items-center" style="max-width:900px">
        <div>
            <a href="{{ path('app_resource_read', {'id': resource.id}) }}"
               class="text-white/60 hover:text-white text-sm transition-colors">
                ← Retour au livre
            </a>
            <h2 class="text-white font-bold text-lg mt-1">{{ resource.title }}</h2>
            <p class="text-white/50 text-sm">{{ resource.author }}</p>
        </div>
        <span class="text-5xl">🎨</span>
    </div>

    <!-- ÉCRAN DE CHARGEMENT -->
    <div id="loadingScreen">
        <div class="text-5xl mb-4">📚✨</div>
        <div class="spinner"></div>
        <p style="font-family:'Bangers',cursive; font-size:1.5rem; letter-spacing:2px; color:#1a1a1a;">
            Ton histoire prend vie...
        </p>
        <p class="text-gray-500 text-sm mt-2 mb-6">
            L'IA lit le livre, génère le scénario<br>et crée les illustrations 🎨
        </p>

        <div class="text-left space-y-2 bg-gray-50 rounded-xl p-4">
            <div class="step" id="step1">⬜ Lecture du livre...</div>
            <div class="step" id="step2">⬜ Génération du résumé...</div>
            <div class="step" id="step3">⬜ Création du scénario BD...</div>
            <div class="step" id="step4">⬜ Génération des illustrations...</div>
            <div class="step" id="step5">⬜ Finalisation...</div>
        </div>
    </div>

    <!-- RÉSULTAT BD (caché au départ) -->
    <div id="comicResult" class="hidden">

        <h1 class="comic-title" id="comicTitle">Ma BD</h1>

        <div class="comic-grid" id="comicGrid">
            <!-- Cases générées dynamiquement par JS -->
        </div>

        <div class="flex justify-center gap-4 mt-8" style="max-width:900px; margin: 30px auto 0;">
            <a href="{{ path('app_resource_read', {'id': resource.id}) }}"
               class="px-6 py-3 bg-gray-800 text-white font-bold rounded-xl hover:bg-gray-900 transition-all">
                ← Retour au livre
            </a>
            <button onclick="window.print()"
                    class="px-6 py-3 bg-yellow-400 text-black font-bold rounded-xl hover:bg-yellow-500 transition-all">
                🖨️ Imprimer la BD
            </button>
        </div>

        <p class="text-center text-gray-400 text-xs mt-6 pb-10">
            🤖 Bande dessinée générée automatiquement par IA depuis le contenu du livre.
        </p>
    </div>

    <!-- ÉCRAN D'ERREUR (caché au départ) -->
    <div id="errorScreen" class="hidden text-center py-20">
        <p class="text-5xl mb-4">😕</p>
        <h3 class="text-xl font-bold text-gray-700 mb-2">Génération impossible</h3>
        <p class="text-gray-500 mb-6" id="errorMessage">Une erreur est survenue.</p>
        <a href="{{ path('app_resource_read', {'id': resource.id}) }}"
           class="px-6 py-3 bg-gray-800 text-white font-bold rounded-xl">
            ← Retour au livre
        </a>
    </div>

</div>

<script>
const generateUrl = '{{ path("app_resource_comic_generate", {"id": resource.id}) }}';
const steps = ['step1', 'step2', 'step3', 'step4', 'step5'];
let currentStep = 0;

// Simuler la progression des étapes pendant la génération
function advanceStep() {
    if (currentStep < steps.length) {
        // Marquer les précédents comme done
        if (currentStep > 0) {
            document.getElementById(steps[currentStep - 1]).textContent =
                '✅ ' + document.getElementById(steps[currentStep - 1]).textContent.slice(2);
            document.getElementById(steps[currentStep - 1]).className = 'step done';
        }
        // Marquer le courant comme actif
        document.getElementById(steps[currentStep]).textContent =
            '⏳ ' + document.getElementById(steps[currentStep]).textContent.slice(2);
        document.getElementById(steps[currentStep]).className = 'step active';
        currentStep++;
    }
}

// Avancer une étape toutes les 6 secondes (30s total pour 5 étapes)
advanceStep(); // Étape 1 immédiatement
const stepInterval = setInterval(advanceStep, 6000);

// ========================= APPEL AJAX =========================
fetch(generateUrl)
    .then(response => response.json())
    .then(data => {
        clearInterval(stepInterval);

        if (!data.success) {
            // Afficher l'erreur
            document.getElementById('loadingScreen').classList.add('hidden');
            document.getElementById('errorScreen').classList.remove('hidden');
            document.getElementById('errorMessage').textContent = data.message || 'Erreur inconnue.';
            return;
        }

        // Construire la BD
        const comic = data.comic;
        document.getElementById('comicTitle').textContent = comic.titre || '{{ resource.title }}';

        const grid = document.getElementById('comicGrid');
        grid.innerHTML = '';

        comic.scenes.forEach((scene, index) => {
            const isLast = index === comic.scenes.length - 1 && comic.scenes.length === 5;
            const cell = document.createElement('div');
            cell.className = isLast ? 'comic-cell-full' : 'comic-cell';

            cell.innerHTML = `
                ${scene.narrateur ? `<div class="comic-narrator">${scene.narrateur}</div>` : ''}
                <span class="case-number">${scene.numero}</span>
                <img src="${scene.image_url}" alt="Scène ${scene.numero}"
                     onerror="this.src='/images/comic_placeholder.png'">
                ${scene.dialogue ? `<div class="speech-bubble">${scene.dialogue}</div>` : ''}
            `;

            grid.appendChild(cell);
        });

        // Afficher la BD, cacher le loading
        document.getElementById('loadingScreen').classList.add('hidden');
        document.getElementById('comicResult').classList.remove('hidden');
    })
    .catch(error => {
        clearInterval(stepInterval);
        document.getElementById('loadingScreen').classList.add('hidden');
        document.getElementById('errorScreen').classList.remove('hidden');
        document.getElementById('errorMessage').textContent = 'Erreur réseau : ' + error.message;
    });
</script>

{% endblock %}