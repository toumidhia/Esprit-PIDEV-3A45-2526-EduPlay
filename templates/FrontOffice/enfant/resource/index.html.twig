                        <a class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-blue-500" href="#"><span class="material-symbols-outlined">alternate_email</span></a>
                    </div>
                </div>
                <div class="flex flex-col gap-4">
                    <h4 class="font-extrabold">Découvrir</h4>
                    <a class="text-sm text-[#617989] hover:text-blue-500 transition-colors" href="#">Jeux Éducatifs</a>
                    <a class="text-sm text-[#617989] hover:text-blue-500 transition-colors" href="#">Bibliothèque de Lecture</a>
                    <a class="text-sm text-[#617989] hover:text-blue-500 transition-colors" href="#">Kits STEM</a>
                    <a class="text-sm text-[#617989] hover:text-blue-500 transition-colors" href="#">Outils pour Enseignants</a>
                </div>
                <div class="flex flex-col gap-4">
                    <h4 class="font-extrabold">Support</h4>
                    <a class="text-sm text-[#617989] hover:text-blue-500 transition-colors" href="#">Centre d'Aide</a>
                    <a class="text-sm text-[#617989] hover:text-blue-500 transition-colors" href="#">Directives de Sécurité</a>
                    <a class="text-sm text-[#617989] hover:text-blue-500 transition-colors" href="#">Politique de Confidentialité</a>
                    <a class="text-sm text-[#617989] hover:text-blue-500 transition-colors" href="#">Contactez-nous</a>
                </div>
