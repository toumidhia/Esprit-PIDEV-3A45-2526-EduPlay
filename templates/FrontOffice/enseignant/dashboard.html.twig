<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Enseignant - Eduplay</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
<div class="min-h-screen">
    <!-- Header -->
    <header class="bg-green-600 text-white shadow">
        <div class="max-w-7xl mx-auto px-4 py-6 flex justify-between items-center">
            <h1 class="text-3xl font-bold">👨‍🏫 Espace Enseignant</h1>
            <div class="flex items-center gap-4">
                <span class="text-lg">Bienvenue {{ enseignant.fullName }}</span>
                <a href="{{ path('app_course_index') }}" class="bg-green-700 px-6 py-2 rounded-lg hover:bg-green-800">
                    Mes Cours
                </a>
                <a href="{{ path('app_logout') }}" class="bg-green-800 px-6 py-2 rounded-lg hover:bg-green-900">
                    Déconnexion
                </a>
            </div>
        </div>
    </header>

    <!-- Flash messages -->
    <div class="max-w-7xl mx-auto px-4 py-4">
        {% for message in app.flashes('success') %}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}
    </div>

    <!-- Main content -->
    <main class="max-w-7xl mx-auto px-4 py-8">

        <!-- Info Card -->
        <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
            <h2 class="text-2xl font-bold mb-4">📋 Mes informations</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <p class="text-gray-600 font-semibold">Email</p>
                    <p class="text-lg">{{ enseignant.email }}</p>
                </div>
                {% if enseignant.telephone %}
                    <div>
                        <p class="text-gray-600 font-semibold">Téléphone</p>
                        <p class="text-lg">{{ enseignant.telephone }}</p>
                    </div>
                {% endif %}
                {% if enseignant.specialite %}
                    <div>
                        <p class="text-gray-600 font-semibold">Spécialité</p>
                        <p class="text-lg">{{ enseignant.specialite }}</p>
                    </div>
                {% endif %}
                <div>
                    <p class="text-gray-600 font-semibold">Membre depuis</p>
                    <p class="text-lg">{{ enseignant.createdAt|date('d/m/Y') }}</p>
                </div>
            </div>
        </div>

        <!-- Quick Actions Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <a href="{{ path('app_course_new') }}" class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg shadow-lg p-6 text-white hover:shadow-xl transition-shadow cursor-pointer block">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xl font-bold">Créer un Cours</h3>
                    <span class="text-4xl">📝</span>
                </div>
                <p class="mb-4">Créer un nouveau contenu pédagogique</p>
                <div class="bg-white text-blue-600 px-4 py-2 rounded-lg font-semibold hover:bg-blue-50 inline-block">
                    Nouveau cours
                </div>
            </a>

            <a href="{{ path('app_course_index') }}" class="bg-gradient-to-br from-green-500 to-green-600 rounded-lg shadow-lg p-6 text-white hover:shadow-xl transition-shadow cursor-pointer block">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xl font-bold">Mes Cours</h3>
                    <span class="text-4xl">📚</span>
                </div>
                <p class="mb-4">Gérer mes contenus pédagogiques</p>
                <div class="bg-white text-green-600 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 inline-block">
                    Voir mes cours
                </div>
            </a>

            <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg shadow-lg p-6 text-white hover:shadow-xl transition-shadow cursor-pointer">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xl font-bold">Statistiques</h3>
                    <span class="text-4xl">📊</span>
                </div>
                <p class="mb-4">Analyser les résultats et progrès</p>
                <button class="bg-white text-purple-600 px-4 py-2 rounded-lg font-semibold hover:bg-purple-50">
                    Voir les stats
                </button>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="bg-white rounded-lg shadow-lg p-6">
            <h2 class="text-2xl font-bold mb-4">📅 Activité récente</h2>
            <div class="space-y-4">
                <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-lg">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-2xl">
                        📝
                    </div>
                    <div class="flex-1">
                        <p class="font-semibold">Bienvenue sur Eduplay !</p>
                        <p class="text-sm text-gray-600">Votre compte enseignant a été créé avec succès</p>
                    </div>
                    <span class="text-sm text-gray-500">{{ enseignant.createdAt|date('d/m/Y') }}</span>
                </div>

                <div class="text-center text-gray-500 py-8">
                    <p class="text-lg">🎯 Commencez par créer votre premier cours !</p>
                    <a href="{{ path('app_course_new') }}" class="inline-block mt-4 bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600">
                        Créer mon premier cours
                    </a>
                </div>
            </div>
        </div>

    </main>
</div>
</body>
</html>