{% extends 'backoffice/enseignant/Partials/container.html.twig' %}
{% block body %}
<div class="container mx-auto p-10">

    <h1 class="text-3xl font-bold mb-6">{{ game.name }}</h1>

    <img src="{{ asset('uploads/games/' ~ game.image) }}"
         class="w-64 rounded-lg mb-6">

    <p class="mb-4">{{ game.description }}</p>

    <span class="px-4 py-2 bg-primary text-white rounded">
        {{ game.type }}
    </span>

</div>
{% endblock %}