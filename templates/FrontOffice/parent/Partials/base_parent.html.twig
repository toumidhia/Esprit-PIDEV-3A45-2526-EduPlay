<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Admin Dashboard - EduPlay{% endblock %}</title>

    {# Tailwind CSS #}
    <script src="https://cdn.tailwindcss.com"></script>

    {# Google Fonts #}
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    {# Material Icons #}
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings:
                'FILL' 0,
                'wght' 400,
                'GRAD' 0,
                'opsz' 24;
        }

        /* Sidebar */
        .admin-sidebar {
            transition: all 0.3s ease;
        }

        .sidebar-nav a.active {
            background: linear-gradient(90deg, rgba(99,183,242,0.1) 0%, rgba(99,183,242,0.05) 100%);
            border-right: 4px solid #63b7f2;
            color: #63b7f2;
        }

        /* Cards */
        .stat-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .admin-course-card {
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .admin-course-card:hover {
            border-color: rgba(99,183,242,0.3);
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        /* Status */
        .status-published { background-color: #d1fae5; color: #065f46; }
        .status-pending { background-color: #fef3c7; color: #92400e; }
        .status-rejected { background-color: #fee2e2; color: #991b1b; }

        /* Mobile */
        @media (max-width: 768px) {
            .admin-sidebar {
                position: fixed;
                left: -100%;
                z-index: 1000;
            }

            .admin-sidebar.active {
                left: 0;
            }

            .mobile-menu-btn {
                display: block;
            }
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">

<div class="flex flex-col min-h-screen">

    {# Navbar #}
    {% include 'FrontOffice/Parent/Partials/navbar.html.twig' %}

    {# Content #}
    <main class="flex-1 p-6">
        <div class="max-w-7xl mx-auto">
            
                {% block content %}{% endblock %}
            </div>
        </main>

    </div>
</div>

<script>
// Removed sidebar scripts - no longer needed
</script>

</body>
</html>
