<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}EduPlay{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .admin-sidebar { transition: all 0.3s ease; }

        @media (max-width: 768px) {
            .admin-sidebar {
                position: fixed;
                left: -100%;
                z-index: 1000;
            }
            .admin-sidebar.active { left: 0; }
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">

<div class="flex">

    {# Sidebar #}
    {% include 'FrontOffice/parent/Partials/sidebar.html.twig' %}

    <div class="flex-1 flex flex-col">

        {# Navbar #}
        {% include 'FrontOffice/parent/Partials/navbar.html.twig' %}

        {# 🔥 CONTENU DYNAMIQUE 🔥 #}
        <main class="flex-1 p-6">
            <div class="max-w-7xl mx-auto">
                {% block body %}{% endblock %}
            </div>
        </main>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
    const sidebar = document.querySelector('.admin-sidebar');

    if (mobileMenuBtn && sidebar) {
        mobileMenuBtn.addEventListener('click', () => {
            sidebar.classList.toggle('active');
        });
    }
});
</script>

</body>
</html>
