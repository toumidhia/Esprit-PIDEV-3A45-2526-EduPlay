<style>
    /* Sidebar Styles */
    .sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 100;
        padding: 0;
        box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        background-color: #2c3e50;
        width: var(--sidebar-width);
        display: flex;
        flex-direction: column;
    }

    .sidebar-sticky {
        flex: 1;
        padding-top: .5rem;
        padding-bottom: 1rem;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .sidebar .nav-link {
        color: #e0e0e0;
        padding: 12px 20px;
        font-weight: 500;
        transition: all 0.3s;
    }

    .sidebar .nav-link:hover {
        color: #fff;
        background-color: rgba(255, 255, 255, 0.1);
    }

    .sidebar .nav-link.active {
        color: #fff;
        background-color: var(--primary-color);
    }

    .sidebar .nav-link i {
        margin-right: 10px;
    }

    .sidebar-heading {
        font-size: .75rem;
        text-transform: uppercase;
        padding: 20px 20px 10px;
        color: #a0a0a0;
        font-weight: 600;
    }

    .sidebar-brand {
        padding: 20px;
        background-color: rgba(0, 0, 0, 0.2);
        color: #fff;
        font-size: 1.5rem;
        font-weight: bold;
        text-align: center;
    }

    .sidebar-brand span {
        color: var(--primary-color);
    }

    /* Scrollbar personnalisé pour le sidebar */
    .sidebar-sticky::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-sticky::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.1);
    }

    .sidebar-sticky::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }

    .sidebar-sticky::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.3);
    }
</style>

{# Sidebar #}
<nav class="sidebar">
    <div class="sidebar-brand">
        <i class="bi bi-mortarboard-fill"></i> Edu<span>Play</span>
    </div>

    <div class="sidebar-sticky">
        <ul class="nav flex-column">

        <a href="{{ path('front_event_index') }}" class="flex items-center gap-4 px-5 py-4 rounded-lg hover:bg-gray-50 transition-colors {{ app.request.get('_route') starts with 'front_event_index' ? 'active' : '' }}">
            <span class="material-symbols-outlined text-gray-600">event</span>
            <span class="font-semibold text-gray-700">Events</span>
        </a>

        <a href="{{ path('front_my_registrations') }}" class="flex items-center gap-4 px-5 py-4 rounded-lg hover:bg-gray-50 transition-colors {{ app.request.get('_route') starts with 'front_my_registrations' ? 'active' : '' }}">
            <span class="material-symbols-outlined text-gray-600">event</span>
            <span class="font-semibold text-gray-700">Inscriptions Events</span>
        </a>

        <a href="{{ path('app_front_shop') }}" class="flex items-center gap-4 px-5 py-4 rounded-lg hover:bg-gray-50 transition-colors {{ app.request.get('_route') starts with 'app_front_shop' ? 'active' : '' }}">
            <span class="material-symbols-outlined text-gray-600">shopping_cart</span>
            <span class="font-semibold text-gray-700">Boutique</span>
        </a>
            {# ================= DASHBOARD ================= #}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_dashboard' %}active{% endif %}"
                   href="{{ path('app_dashboard') }}">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>

            {% if is_granted('ROLE_ADMIN') %}

                {# ================= E-COMMERCE ================= #}
                <div class="sidebar-heading">E-Commerce</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_seance' %}active{% endif %}" href="{{ path('app_seance_index') }}">
                        <i class="bi bi-calendar-event"></i> Séances
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_subscription_list' %}active{% endif %}" href="{{ path('app_subscription_list') }}">
                        <i class="bi bi-people"></i> Inscriptions Séances
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'admin_event_index' %}active{% endif %}" href="{{ path('admin_event_index') }}">
                        <i class="bi bi-calendar-event"></i> Events
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_back_product' %}active{% endif %}"
                       href="{{ path('app_back_product_index') }}">
                        <i class="bi bi-box-seam"></i> Produits
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_back_commande' %}active{% endif %}"
                       href="{{ path('app_back_commande_index') }}">
                        <i class="bi bi-cart-check"></i> Commandes
                    </a>
                </li>

                {# ================= LIBRARY ================= #}
                <div class="sidebar-heading">Bibliothèque</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'admin_library' %}active{% endif %}"
                       href="{{ path('admin_library_index') }}">
                        <i class="bi bi-book"></i> Library
                    </a>
                </li>

                {# ================= RESSOURCES ================= #}
                <div class="sidebar-heading">Ressources</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'admin_resource' %}active{% endif %}"
                       href="{{ path('admin_resource_index') }}">
                        <i class="bi bi-folder2-open"></i> Ressources
                    </a>
                </li>

                {# ================= USERS ================= #}
                <div class="sidebar-heading">Utilisateurs</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') == 'app_admin_users' %}active{% endif %}"
                       href="{{ path('app_admin_users') }}">
                        <i class="bi bi-people-fill"></i> Users
                    </a>
                </li>

                {# ================= STATISTIQUES ================= #}
                <div class="sidebar-heading">Analytiques</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') == 'admin_stats' %}active{% endif %}"
                       href="{{ path('admin_stats') }}">
                        <i class="bi bi-graph-up"></i> Statistiques
                    </a>
                </li>

            {% endif %}

            {# ================= ACCOUNT ================= #}
            <div class="sidebar-heading">Compte</div>

            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="bi bi-box-arrow-right"></i> Déconnexion
                </a>
            </li>

        </ul>
    </div>
</nav>