<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-14 py-4">
    <div class="flex items-center justify-between gap-6">

      {# Brand #}
      <a href="{{ path('app_parent_dashboard') }}" class="flex items-center gap-3">
        <div class="w-11 h-11 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-md">
          <span class="material-symbols-outlined text-white text-2xl">family_home</span>
        </div>
        <div class="leading-tight">
          <div class="text-lg font-extrabold text-gray-900">EduPlay</div>
          <div class="text-xs text-gray-500 font-medium">Espace Parent</div>
        </div>
      </a>

      {# Desktop menu #}
      <nav class="hidden md:flex items-center gap-2">
        {% set r = app.request.get('_route') %}

        <a href="{{ path('app_parent_dashboard') }}"
           class="px-4 py-2 rounded-lg font-semibold transition
           {{ r == 'app_parent_dashboard' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Dashboard
        </a>

        <a href="{{ path('front_event_index') }}"
           class="px-4 py-2 rounded-lg font-semibold transition
           {{ r starts with 'front_event' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Events
        </a>

        <a href="{{ path('front_my_registrations') }}"
           class="px-4 py-2 rounded-lg font-semibold transition
           {{ r starts with 'front_my_registrations' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Mes Inscriptions
        </a>

        <a href="{{ path('app_front_shop') }}"
           class="px-4 py-2 rounded-lg font-semibold transition
           {{ r starts with 'app_front_shop' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Boutique
        </a>

        <a href="{{ path('app_parent_commandes') }}"
           class="px-4 py-2 rounded-lg font-semibold transition
           {{ r == 'app_parent_commandes' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Mes commandes
        </a>
      </nav>

      {# Right side #}
      <div class="flex items-center gap-3">
        <a href="{{ path('app_logout') }}"
           class="hidden md:flex items-center gap-2 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition font-semibold">
          <span class="material-symbols-outlined text-base">logout</span>
          Déconnexion
        </a>

        {# Mobile menu button #}
        <button id="mobileMenuBtn"
                class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition"
                aria-label="Open menu">
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>
    </div>

    {# Mobile dropdown #}
    <div id="mobileMenu" class="md:hidden hidden pt-4">
      {% set r = app.request.get('_route') %}
      <div class="grid gap-2">

        <a href="{{ path('app_parent_dashboard') }}"
           class="px-4 py-3 rounded-lg font-semibold {{ r == 'app_parent_dashboard' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Dashboard
        </a>

        <a href="{{ path('front_event_index') }}"
           class="px-4 py-3 rounded-lg font-semibold {{ r starts with 'front_event' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Events
        </a>

        <a href="{{ path('front_my_registrations') }}"
           class="px-4 py-3 rounded-lg font-semibold {{ r starts with 'front_my_registrations' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Inscriptions
        </a>

        <a href="{{ path('app_front_shop') }}"
           class="px-4 py-3 rounded-lg font-semibold {{ r starts with 'app_front_shop' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Boutique
        </a>

        <a href="{{ path('app_parent_commandes') }}"
           class="px-4 py-3 rounded-lg font-semibold {{ r == 'app_parent_commandes' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' }}">
          Mes commandes
        </a>

        <a href="{{ path('app_logout') }}"
           class="mt-2 px-4 py-3 rounded-lg font-semibold bg-red-500 text-white hover:bg-red-600 transition flex items-center gap-2">
          <span class="material-symbols-outlined text-base">logout</span>
          Déconnexion
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  if (btn && menu) {
    btn.addEventListener('click', () => menu.classList.toggle('hidden'));
  }
</script>
{# Top Navbar #}
<nav class="navbar navbar-custom navbar-light">
    <div class="container-fluid">
        <span class="navbar-text">
            <i class="bi bi-person-circle"></i>
            Bienvenue, <strong>{{ app.user.firstName }} {{ app.user.lastName }}</strong>
            <span class="badge bg-secondary ms-2">{{ app.user.type|upper }}</span>
        </span>
    </div>
</nav>
