<header class="bg-white border-b border-gray-200 px-8 py-5 shadow-sm">
    <div class="flex items-center justify-between">

        <div class="flex items-center gap-6">
            <div class="flex items-center gap-3">
                <a href="{{ path('app_parent_dashboard') }}" class="text-gray-600 hover:text-blue-600 font-medium">Mon espace</a>
                <a href="{{ path('app_parent_commandes') }}" class="text-gray-600 hover:text-blue-600 font-medium">Mes commandes</a>
            </div>
        </div>

        <div class="flex items-center gap-6">
            <div class="hidden lg:block relative">
                <span class="material-symbols-outlined absolute left-3 top-3 text-gray-400 text-sm">search</span>
