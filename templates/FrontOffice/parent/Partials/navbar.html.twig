<header class="bg-white border-b border-gray-200 px-8 py-5 shadow-sm">
    <div class="flex items-center justify-between">

        <div class="flex items-center gap-8">
            {# Logo/Brand #}
            <a href="{{ path('app_parent_dashboard') }}" class="flex items-center gap-2 font-bold text-lg text-gray-900">
                <span class="text-xl">🚀</span>
                <span>EduPlay</span>
            </a>

            {# Navigation Links #}
            <div class="hidden md:flex items-center gap-6">
                <a href="{{ path('app_parent_dashboard') }}" class="text-gray-600 hover:text-blue-600 font-medium transition-colors">Mon espace</a>
                <a href="{{ path('app_front_shop') }}" class="text-gray-600 hover:text-blue-600 font-medium transition-colors">Boutique</a>
                <a href="{{ path('app_parent_commandes') }}" class="text-gray-600 hover:text-blue-600 font-medium transition-colors">Mes commandes</a>
            </div>
        </div>

        <div class="flex items-center gap-6">
            <div class="hidden lg:block relative">
                <span class="material-symbols-outlined absolute left-3 top-3 text-gray-400 text-sm">search</span>
                <input
                    type="text"
                    class="pl-10 pr-4 py-2.5 w-72 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                    placeholder="Rechercher..."
                >
            </div>

            <button class="p-2 rounded-lg hover:bg-gray-100 relative transition-colors">
                <span class="material-symbols-outlined text-gray-700">notifications</span>
                <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold">3</span>
            </button>

            <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-4 py-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors font-medium text-sm">
                <span class="material-symbols-outlined text-sm">logout</span>
                <span class="hidden sm:inline">Déconnexion</span>
            </a>
        </div>

    </div>
</header>
