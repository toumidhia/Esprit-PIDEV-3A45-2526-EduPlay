{% extends 'FrontOffice/parent/Partials/container.html.twig' %}

{% block title %}Dashboard Parent - Eduplay{% endblock %}

{% block content %}
<div class="min-h-screen bg-gray-50">


    <!-- Flash messages -->
    <div class="max-w-7xl mx-auto px-4 py-4">
        {% for message in app.flashes('success') %}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}
    </div>

    <div class="flex flex-wrap gap-3">
      <a href="{{ path('app_parent_enfant_new') }}"
         class="bg-blue-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-700 transition inline-flex items-center gap-2">
        <span class="material-symbols-outlined text-base">add</span>
        Ajouter un enfant
      </a>

        {% if enfants is empty %}
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-8 text-center">
                <p class="text-xl text-gray-700 mb-4">
                    Vous n'avez pas encore ajouté d'enfant
                </p>
                <a href="{{ path('app_parent_enfant_new') }}"
                   class="inline-block bg-blue-500 text-white px-8 py-3 rounded-lg hover:bg-blue-600">
                    Créer le premier compte enfant
                </a>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for enfant in enfants %}
                    <div class="bg-white rounded-lg shadow-lg p-6">
                        <div class="flex items-center mb-4">
                            <div class="w-16 h-16 bg-blue-500 rounded-full flex items-center justify-center text-white text-2xl font-bold">
                                {{ enfant.firstName|slice(0, 1) }}
                            </div>
                            <div class="ml-4">
                                <h3 class="text-xl font-bold">{{ enfant.fullName }}</h3>
                                <p class="text-gray-600">
                                    {% if enfant.age %}
                                        {{ enfant.age }} ans
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        <div class="space-y-2 mb-4">
                            <p class="text-sm">
                                <strong>Identifiant:</strong>
                                <code class="bg-gray-100 px-2 py-1 rounded">
                                    {{ enfant.username ?: enfant.email }}
                                </code>
                            </p>

                            {% if enfant.niveau %}
                                <p class="text-sm">
                                    <strong>Niveau:</strong> {{ enfant.niveau }}
                                </p>
                            {% endif %}

                            {% if enfant.birthDate %}
                                <p class="text-sm">
                                    <strong>Né(e) le:</strong>
                                    {{ enfant.birthDate|date('d/m/Y') }}
                                </p>
                            {% endif %}
                        </div>

                        <form method="post"
                              action="{{ path('app_parent_enfant_delete', {id: enfant.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce compte ?');">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ enfant.id) }}">
                            <button type="submit"
                                    class="w-full bg-red-500 text-white py-2 rounded hover:bg-red-600">
                                Supprimer
                            </button>
                            <a href="{{ path('app_parent_enfant_edit', {id: enfant.id}) }}"
                                    class="w-full mb-2 inline-block text-center bg-yellow-500 text-white py-2 rounded hover:bg-yellow-600">
                                Modifier
                            </a>
                        </form>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </main>

</div>
{% endblock %}
