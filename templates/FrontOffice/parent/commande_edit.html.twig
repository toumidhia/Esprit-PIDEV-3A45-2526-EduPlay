{% extends 'FrontOffice/parent/Partials/container.html.twig' %}

{% block title %}Modifier commande - EduPlay{% endblock %}

{% block content %}
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Modifier la commande #{{ commande.id }}</h1>
        <p class="text-gray-600 mt-1">Mettez à jour les détails de votre commande.</p>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 px-4 py-3 rounded-xl {{ label == 'success' ? 'bg-green-100 text-green-800' : (label == 'error' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800') }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div class="bg-gray-50 p-4 rounded-lg">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Produit</label>
                    <p class="text-lg font-semibold text-gray-900">{{ commande.product ? commande.product.name : '-' }}</p>
                    <p class="text-sm text-gray-600 mt-1">Prix unitaire: {{ commande.product ? commande.product.price|number_format(2, ',', ' ') : '0,00' }} DT</p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Date de commande</label>
                    <p class="text-lg font-semibold text-gray-900">{{ commande.dateCommande ? commande.dateCommande|date('d/m/Y H:i') : '-' }}</p>
                </div>
            </div>

            {% import '_form_errors.html.twig' as ferrors %}

            <form method="post" class="space-y-6">
                <div>
                    {{ form_label(form.quantity, 'Quantité', {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.quantity, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200'}}) }}
                    {{ ferrors.show(form.quantity) }}
                    <p class="text-xs text-gray-500 mt-1">Maximum 100 unités</p>
                </div>

                <div class="bg-blue-50 border border-blue-200 p-4 rounded-lg">
                    <p class="text-sm font-bold text-gray-700">Total estimé:</p>
                    <p class="text-2xl font-bold text-blue-600">
                        <span id="totalAmount">{{ (commande.product.price * commande.quantity)|number_format(2, ',', ' ') }}</span> DT
                    </p>
                </div>

                <div class="flex gap-4">
                    <button type="submit" class="flex-1 bg-blue-500 text-white font-bold py-3 rounded-lg hover:bg-blue-600 transition-colors">
                        💾 Enregistrer les modifications
                    </button>
                    <a href="{{ path('app_parent_commandes') }}" class="flex-1 bg-gray-300 text-gray-700 font-bold py-3 rounded-lg hover:bg-gray-400 transition-colors text-center">
                        ❌ Annuler
                    </a>
                </div>

                {{ form_rest(form) }}
            </form>
        </div>
    </div>

    <script>
        // Update total amount when quantity changes
        document.addEventListener('DOMContentLoaded', function() {
            const quantityInput = document.querySelector('input[name*="quantity"]');
            const totalSpan = document.getElementById('totalAmount');
            const pricePerUnit = {{ commande.product ? commande.product.price : 0 }};

            if (quantityInput && totalSpan) {
                quantityInput.addEventListener('change', function() {
                    const quantity = parseInt(this.value) || 0;
                    const total = (pricePerUnit * quantity).toFixed(2);
                    totalSpan.textContent = parseFloat(total).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' DT';
                });
            }
        });
    </script>
{% endblock %}
