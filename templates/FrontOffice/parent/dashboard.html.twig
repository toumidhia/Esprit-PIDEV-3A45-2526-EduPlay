{% extends 'FrontOffice/Parent/Partials/base_parent.html.twig' %}

{% block title %}Dashboard Parent - EduPlay{% endblock %}

{% block body %}
  {# Flash messages #}
  <div class="mb-6">
    {% for message in app.flashes('success') %}
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-3">
        {{ message }}
      </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-3">
        {{ message }}
      </div>
    {% endfor %}
  </div>

  {# Header section (dans le body, pas un vrai <header> global) #}
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8">
    <div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">
        Bienvenue {{ parent.firstName }} !
      </h1>
      <p class="text-gray-500 font-medium mt-2">Gérez vos enfants et vos inscriptions.</p>
    </div>

    <div class="flex flex-wrap gap-3">
      <a href="{{ path('app_parent_enfant_new') }}"
         class="bg-blue-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-700 transition inline-flex items-center gap-2">
        <span class="material-symbols-outlined text-base">add</span>
        Ajouter un enfant
      </a>

      <a href="{{ path('app_subscription_list') }}"
         class="bg-green-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-green-700 transition">
        Voir les cours
      </a>
    </div>
  </div>

  <h2 class="text-2xl font-extrabold mb-6">Mes enfants</h2>

  {% if enfants is empty %}
    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-8 text-center">
      <p class="text-xl text-gray-700 mb-4 font-bold">Vous n'avez pas encore ajouté d'enfant</p>
      <a href="{{ path('app_parent_enfant_new') }}"
         class="inline-block bg-blue-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-blue-700 transition">
        Créer le premier compte enfant
      </a>
    </div>
  {% else %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for enfant in enfants %}
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 hover:shadow-md transition">
          <div class="flex items-center mb-4">
            <div class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center text-white text-xl font-extrabold">
              {{ enfant.firstName|default('E')|slice(0, 1) }}
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-extrabold">
                {{ enfant.fullName ?? (enfant.firstName ~ ' ' ~ enfant.lastName) }}
              </h3>
              <p class="text-gray-600 text-sm font-medium">
                {% if enfant.age is defined and enfant.age %}
                  {{ enfant.age }} ans
                {% endif %}
              </p>
            </div>
          </div>

          <div class="space-y-2 mb-5 text-sm">
            <p>
              <strong>Identifiant:</strong>
              <code class="bg-gray-100 px-2 py-1 rounded">
                {{ enfant.username ?: enfant.email }}
              </code>
            </p>

            {% if enfant.niveau is defined and enfant.niveau %}
              <p><strong>Niveau:</strong> {{ enfant.niveau }}</p>
            {% endif %}

            {% if enfant.birthDate is defined and enfant.birthDate %}
              <p><strong>Né(e) le:</strong> {{ enfant.birthDate|date('d/m/Y') }}</p>
            {% endif %}
          </div>

          <form method="post"
                action="{{ path('app_parent_enfant_delete', {id: enfant.id}) }}"
                onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce compte ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enfant.id) }}">
            <button type="submit" class="w-full bg-red-500 text-white py-2.5 rounded-xl font-bold hover:bg-red-600 transition">
              Supprimer
            </button>
          </form>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
