{% extends 'FrontOffice/parent/Partials/base_parent.html.twig' %}

{% block title %}Dashboard Parent - EduPlay{% endblock %}

{% block content %}
    <div class="mb-12">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold text-gray-900 mb-2">Bienvenue {{ parent.firstName }} 👋</h1>
                <p class="text-gray-600">Gérez vos enfants et vos commandes</p>
            </div>
            <a href="{{ path('app_parent_enfant_new') }}" class="inline-flex items-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold shadow-md">
                <span class="material-symbols-outlined">person_add</span>
                Ajouter un enfant
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="mb-6 px-6 py-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
            {{ message }}
        </div>
    {% endfor %}

    <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Mes enfants</h2>

        {% if enfants is empty %}
            <div class="bg-white border-2 border-dashed border-blue-300 rounded-xl p-12 text-center">
                <span class="material-symbols-outlined text-blue-500 text-5xl mb-4 block">person_outline</span>
                <p class="text-xl text-gray-700 mb-6 font-semibold">Vous n'avez pas encore ajouté d'enfant</p>
                <a href="{{ path('app_parent_enfant_new') }}" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold">
                    Créer le premier compte enfant
                </a>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for enfant in enfants %}
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
                        <div class="bg-gradient-to-r from-blue-500 to-blue-600 p-8 flex items-center justify-between">
                            <div>
                                <h3 class="text-2xl font-bold text-white">{{ enfant.fullName }}</h3>
                                <p class="text-blue-100 mt-1">{{ enfant.age }} ans</p>
                            </div>
                            <div class="w-16 h-16 bg-white bg-opacity-20 rounded-lg flex items-center justify-center text-white text-2xl font-bold">
                                {{ enfant.firstName|slice(0, 1) }}
                            </div>
                        </div>

                        <div class="p-6 space-y-4">
                            <div>
                                <p class="text-sm text-gray-600 font-medium mb-1">Identifiant</p>
                                <code class="bg-gray-100 px-3 py-2 rounded text-sm font-mono text-gray-900">{{ enfant.username }}</code>
                            </div>
                            {% if enfant.niveau %}
                                <div>
                                    <p class="text-sm text-gray-600 font-medium mb-1">Niveau</p>
                                    <p class="text-gray-900 font-semibold">{{ enfant.niveau }}</p>
                                </div>
                            {% endif %}
                            <div>
                                <p class="text-sm text-gray-600 font-medium mb-1">Date de naissance</p>
                                <p class="text-gray-900">{{ enfant.birthDate|date('d/m/Y') }}</p>
                            </div>

                            <form method="post" action="{{ path('app_parent_enfant_delete', {id: enfant.id}) }}" 
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce compte ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enfant.id) }}">
                                <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2 mt-4">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}