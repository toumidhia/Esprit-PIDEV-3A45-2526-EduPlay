<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ajouter un enfant - Eduplay</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <div class="min-h-screen py-12 px-4">
        <div class="max-w-2xl mx-auto">
            <!-- Back button -->
            <div class="mb-6">
                <a href="{{ path('app_parent_dashboard') }}" class="text-blue-500 hover:underline">
                    ← Retour au dashboard
                </a>
            </div>

            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-3xl font-bold text-center mb-8">Ajouter un enfant</h2>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                    <p class="text-sm text-gray-700">
                        ℹ Créez un compte pour votre enfant. Il pourra se connecter avec l'identifiant et le mot de passe que vous allez définir.
                    </p>
                </div>

                {{ form_start(form) }}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            {{ form_label(form.lastName, 'Nom', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                            {{ form_widget(form.lastName, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                            {{ form_errors(form.lastName) }}
                        </div>
                        <div>
                            {{ form_label(form.firstName, 'Prénom', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                            {{ form_widget(form.firstName, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                            {{ form_errors(form.firstName) }}
                        </div>
                    </div>

                    {# ✅ CORRECTION: username -> email #}
                    <div class="mb-4">
                        {{ form_label(form.email, 'Identifiant de connexion (Email)', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500', 'placeholder': 'Ex: alice@gmail.com'}}) }}
                        <p class="text-sm text-gray-500 mt-1">{{ form_help(form.email) }}</p>
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            {{ form_label(form.birthDate, 'Date de naissance', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                            {{ form_widget(form.birthDate, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                            {{ form_errors(form.birthDate) }}
                        </div>
                        <div>
                            {{ form_label(form.niveau, 'Niveau scolaire', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                            {{ form_widget(form.niveau, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                            {{ form_errors(form.niveau) }}
                        </div>
                    </div>

                    <hr class="my-6 border-gray-300">
                    <h3 class="text-xl font-bold mb-4">Définir le mot de passe de connexion</h3>

                    {# ✅ CORRECTION: password.first/second -> password (car PasswordType simple) #}
                    <div class="mb-6">
                        {{ form_label(form.password, 'Mot de passe', {'label_attr': {'class': 'block text-gray-700 font-bold mb-2'}}) }}
                        {{ form_widget(form.password, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500'}}) }}
                        <p class="text-sm text-gray-500 mt-1">{{ form_help(form.password) }}</p>
                        {{ form_errors(form.password) }}
                    </div>

                    <div class="space-y-3">
                        <button type="submit" class="w-full bg-blue-500 text-white font-bold py-3 rounded-lg hover:bg-blue-600">
                            Créer le compte
                        </button>
                        <a href="{{ path('app_parent_dashboard') }}" class="block w-full text-center bg-gray-300 text-gray-700 font-bold py-3 rounded-lg hover:bg-gray-400">
                            Annuler
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</body>
</html>
