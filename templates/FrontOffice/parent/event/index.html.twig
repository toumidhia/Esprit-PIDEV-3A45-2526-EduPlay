{% extends 'FrontOffice/parent/Partials/container.html.twig' %}

{% block title %}Événements - EduPlay{% endblock %}

{% block content %}
<section class="px-6 md:px-20 lg:px-40 py-12">
  <div class="max-w-[1280px] mx-auto">

    {# HEADER #}
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold">🎉 Événements</h1>
        <p class="text-gray-500 font-medium mt-2">
          Découvrez les prochains événements et inscrivez vos enfants !
        </p>
      </div>

      {# FILTRES #}
      <div class="bg-white/80 backdrop-blur-sm p-4 rounded-2xl shadow-lg border border-gray-100">
        <form id="filterForm" method="get" class="flex flex-wrap items-center gap-3">
          
          {# Recherche #}
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-sm">search</span>
            <input id="searchInput" 
                   name="q" 
                   value="{{ q }}" 
                   class="w-64 h-11 pl-10 pr-4 rounded-full border border-gray-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                   placeholder="Rechercher..."
                   autocomplete="off">
          </div>

          {# Tri #}
          <select id="sortSelect" name="sort" class="h-11 px-4 rounded-full border border-gray-200 focus:ring-2 focus:ring-blue-500 bg-white">
            <option value="start" {{ sort == 'start' ? 'selected' : '' }}>📅 Date début</option>
            <option value="created" {{ sort == 'created' ? 'selected' : '' }}>🆕 Date création</option>
            <option value="title" {{ sort == 'title' ? 'selected' : '' }}>🔤 Titre</option>
          </select>

          {# Ordre #}
          <select id="orderSelect" name="order" class="h-11 px-4 rounded-full border border-gray-200 focus:ring-2 focus:ring-blue-500 bg-white">
            <option value="asc" {{ order == 'asc' ? 'selected' : '' }}>⬆️ Ascendant</option>
            <option value="desc" {{ order == 'desc' ? 'selected' : '' }}>⬇️ Descendant</option>
          </select>

          {# Bouton de réinitialisation #}
          <button type="button" id="resetFilters" 
                  class="h-11 px-4 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">refresh</span>
            Réinitialiser
          </button>

          {# Compteur de résultats #}
          <span id="resultCount" class="text-sm text-gray-500 ml-2">
            {{ total }} résultat(s)
          </span>
        </form>
      </div>
    </div>

    {# LISTE DES ÉVÉNEMENTS #}
    <div id="eventsContainer">
      {% include 'FrontOffice/Parent/event/_event_cards.html.twig' %}
    </div>

    {# PAGINATION MAISON #}
    {% if totalPages > 1 %}
    <div class="mt-10 flex justify-center items-center gap-2">
      {# Bouton Précédent #}
      {% if currentPage > 1 %}
        <a href="{{ path('front_event_index', { page: currentPage - 1, q: q, sort: sort, order: order }) }}" 
           class="px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50">
          <span class="material-symbols-outlined text-sm">chevron_left</span>
        </a>
      {% endif %}
      
      {# Numéros de page #}
      {% for i in 1..totalPages %}
        {% if i >= currentPage - 2 and i <= currentPage + 2 %}
          <a href="{{ path('front_event_index', { page: i, q: q, sort: sort, order: order }) }}" 
             class="px-4 py-2 rounded-xl {{ i == currentPage ? 'bg-blue-600 text-white' : 'border border-gray-200 hover:bg-gray-50' }}">
            {{ i }}
          </a>
        {% endif %}
      {% endfor %}
      
      {# Bouton Suivant #}
      {% if currentPage < totalPages %}
        <a href="{{ path('front_event_index', { page: currentPage + 1, q: q, sort: sort, order: order }) }}" 
           class="px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50">
          <span class="material-symbols-outlined text-sm">chevron_right</span>
        </a>
      {% endif %}
    </div>
    <div class="text-center text-sm text-gray-500 mt-2">
      Page {{ currentPage }} sur {{ totalPages }} ({{ total }} événements)
    </div>
    {% endif %}

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('searchInput');
  const sortSelect = document.getElementById('sortSelect');
  const orderSelect = document.getElementById('orderSelect');
  const resetBtn = document.getElementById('resetFilters');
  const eventsContainer = document.getElementById('eventsContainer');

  let debounceTimer;

  function updateEvents() {
    const params = new URLSearchParams();
    if (searchInput.value) params.set('q', searchInput.value);
    params.set('sort', sortSelect.value);
    params.set('order', orderSelect.value);
    params.set('page', 1);

    const url = "{{ path('front_event_index') }}?" + params.toString();

    fetch(url, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => response.text())
    .then(html => {
      eventsContainer.innerHTML = html;
      window.location.href = url; // Rechargement complet pour la pagination
    })
    .catch(error => console.error('Erreur:', error));
  }

  function debouncedUpdate() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updateEvents, 300);
  }

  searchInput.addEventListener('input', debouncedUpdate);
  sortSelect.addEventListener('change', updateEvents);
  orderSelect.addEventListener('change', updateEvents);

  resetBtn.addEventListener('click', function() {
    searchInput.value = '';
    sortSelect.value = 'start';
    orderSelect.value = 'asc';
    updateEvents();
  });
});
</script>
{% endblock %}