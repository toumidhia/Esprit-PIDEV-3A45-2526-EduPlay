{% extends 'FrontOffice/parent/Partials/container.html.twig' %}

{% block title %}Événements - EduPlay{% endblock %}

{% block content %}
<section class="px-6 md:px-20 lg:px-40 py-12">
  <div class="max-w-[1280px] mx-auto">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold">Événements</h1>
        <p class="text-gray-500 font-medium mt-2">
          Découvrez les prochains événements et inscrivez-vous.
        </p>
      </div>

      <form method="get" class="flex gap-3">
        <input name="q" value="{{ q }}" class="h-11 px-5 rounded-full border" placeholder="Rechercher…">

        <select name="sort" class="h-11 px-4 rounded-full border">
          <option value="start" {{ sort == 'start' ? 'selected' : '' }}>Date début</option>
          <option value="created" {{ sort == 'created' ? 'selected' : '' }}>Date création</option>
        </select>

        <select name="order" class="h-11 px-4 rounded-full border">
          <option value="asc" {{ order == 'asc' ? 'selected' : '' }}>Asc</option>
          <option value="desc" {{ order == 'desc' ? 'selected' : '' }}>Desc</option>
        </select>

        <button class="px-6 rounded-full bg-blue-500 text-white font-bold">
          Filtrer
        </button>
      </form>
    </div>

    {% if events is empty %}
      <div class="bg-white p-8 rounded-xl font-bold">
        Aucun événement pour le moment.
      </div>
    {% else %}
      <div class="grid md:grid-cols-3 gap-6">
        {% for e in events %}
          <a href="{{ path('front_event_show', {id: e.id}) }}"
             class="bg-white rounded-xl p-6 shadow hover:shadow-xl transition">
            <h3 class="font-extrabold text-lg">{{ e.title }}</h3>
            <p class="text-sm text-gray-500 mt-2">{{ e.description|slice(0,120) }}…</p>
            <div class="mt-4 font-bold text-sm">
              📅 {{ e.startDate|date('d/m/Y H:i') }}
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>
{% endblock %}
