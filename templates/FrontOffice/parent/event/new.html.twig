{% extends 'FrontOffice/parent/Partials/container.html.twig' %}
{% block title %}Inscription - {{ event.title }}{% endblock %}

{% block body %}
<section class="px-6 md:px-20 lg:px-40 py-12">
  <div class="max-w-[700px] mx-auto">

    <a class="inline-flex items-center gap-2 text-primary font-bold mb-6 hover:underline"
       href="{{ path('front_event_show', {id: event.id}) }}">
      <span class="material-symbols-outlined">arrow_back</span>
      Retour à l’événement
    </a>

    <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-7">
      <h1 class="text-3xl font-extrabold">Inscrire un enfant</h1>
      <p class="text-[#617989] dark:text-gray-400 font-medium mt-2">
        Événement : <b>{{ event.title }}</b>
      </p>

      <div class="mt-6">
        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="bg-black/5 dark:bg-white/10 rounded-xl p-4">
          {{ form_row(form.childFullName) }}
          <p class="text-xs text-[#617989] dark:text-gray-400 mt-2">
            Astuce : écris “Prénom Nom”.
          </p>
        </div>

        <button class="mt-6 px-6 py-3 rounded-full bg-accent-yellow text-[#111518] font-extrabold hover:scale-105 transition-transform">
          Confirmer l’inscription
        </button>

        {{ form_end(form) }}
      </div>
    </div>

  </div>
</section>
{% endblock %}
