<div class="bg-white/80 backdrop-blur-sm rounded-2xl p-6 border border-gray-100">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-extrabold flex items-center gap-2">
      <span class="material-symbols-outlined text-primary">auto_awesome</span>
      Recommandé pour vous
    </h2>
    <a href="{{ path('parent_recommendations') }}" class="text-sm text-primary hover:underline">
      Voir tout →
    </a>
  </div>

  {% if recommendations is empty %}
    <p class="text-gray-500 text-center py-4">
      Aucune recommandation pour le moment.<br>
      Inscrivez-vous à des événements pour en recevoir !
    </p>
  {% else %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for item in recommendations %}
        {% set event = item.event %}
        <a href="{{ path('front_event_show', {id: event.id}) }}" 
           class="group bg-white rounded-xl shadow-sm hover:shadow-md transition overflow-hidden border border-gray-100">
          
          {% if event.imagePath %}
            <div class="h-32 overflow-hidden">
              <img src="{{ asset(event.imagePath) }}" alt="{{ event.title }}" class="w-full h-full object-cover group-hover:scale-110 transition">
            </div>
          {% else %}
            <div class="h-32 bg-gradient-to-r from-primary/30 to-primary/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-4xl text-primary/50">event</span>
            </div>
          {% endif %}
          
          <div class="p-4">
            <h3 class="font-extrabold text-gray-900 group-hover:text-primary transition">
              {{ event.title }}
            </h3>
            
            <div class="mt-2 flex items-center gap-1 text-sm text-gray-500">
              <span class="material-symbols-outlined text-base">event</span>
              {{ event.startDate|date('d/m/Y') }}
            </div>
            
            <div class="mt-3">
              <div class="flex flex-wrap gap-1">
                {% for reason in item.reasons %}
                  <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full">
                    {{ reason }}
                  </span>
                {% endfor %}
              </div>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>