{% extends 'FrontOffice/parent/Partials/base_parent.html.twig' %}

{% block title %}Mes inscriptions{% endblock %}

{% block body %}
<section class="px-6 md:px-20 lg:px-40 py-12">
  <div class="max-w-[1000px] mx-auto">

    <div class="flex items-end justify-between gap-6 mb-10">
      <div>
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">Mes inscriptions</h1>
        <p class="text-[#617989] dark:text-gray-400 font-medium mt-2">
          Liste de tes inscriptions aux événements.
        </p>
      </div>
      <a href="{{ path('front_event_index') }}"
         class="px-5 py-3 rounded-full bg-black/5 dark:bg-white/10 font-bold hover:scale-105 transition-transform">
        ← Retour événements
      </a>
    </div>

    <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-6">
      {% if registrations is empty %}
        <p class="font-bold">Aucune inscription.</p>
      {% else %}
        <div class="space-y-4">
          {% for r in registrations %}
            <div class="p-4 rounded-xl bg-black/5 dark:bg-white/10 flex items-start justify-between gap-4">
              <div>
                <div class="font-extrabold">{{ r.event.title }}</div>
                <div class="text-sm font-bold text-[#617989] dark:text-gray-400">
                  Enfant : {{ r.childFullName }}
                </div>
                <div class="text-sm font-bold mt-1">
                  📅 {{ r.event.startDate|date('d/m/Y H:i') }} → {{ r.event.endDate|date('d/m/Y H:i') }}
                </div>
              </div>

              <form method="post"
                    action="{{ path('front_registration_cancel', {id: r.id}) }}"
                    onsubmit="return confirm('Annuler cette inscription ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_registration_' ~ r.id) }}">
                <button class="px-5 py-2 rounded-full bg-black/10 dark:bg-white/10 font-bold hover:scale-105 transition-transform">
                  Annuler
                </button>
              </form>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>
</section>
{% endblock %}
