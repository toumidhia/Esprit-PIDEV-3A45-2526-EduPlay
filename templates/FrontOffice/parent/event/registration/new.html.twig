{% extends 'base.html.twig' %}

{% block title %}Register - {{ event.title }}{% endblock %}

{% block body %}
<section class="px-6 md:px-20 lg:px-40 py-12">
  <div class="max-w-[980px] mx-auto overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

    {# HEADER GRADIENT #}
    <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <h1 class="text-4xl font-extrabold mb-2">🧒 Event registration</h1>
          <p class="text-blue-100 font-medium">
            Event: <span class="font-extrabold">{{ event.title }}</span>
          </p>
        </div>

        <a href="{{ path('front_event_show', {id: event.id}) }}"
           class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-extrabold rounded-xl hover:bg-white/30 transition-all border border-white/30">
          ← Back
        </a>
      </div>
    </div>

    {# FORM CARD #}
    <div class="p-6">
      <div class="rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50 p-6 shadow-sm">
        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        {{ form_errors(form) }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm md:col-span-2">
            {{ form_row(form.childFullName) }}
            <p class="mt-2 text-xs font-semibold text-gray-500">Required</p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
            {{ form_row(form.parentPhone) }}
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
            {{ form_row(form.childClassLevel) }}
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
            {{ form_row(form.emergencyContactName) }}
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
            {{ form_row(form.emergencyContactPhone) }}
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm md:col-span-2">
            {{ form_row(form.medicalNotes) }}
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm md:col-span-2">
            {{ form_row(form.notes) }}
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <button type="submit"
                  class="inline-flex items-center px-6 py-3 rounded-xl bg-blue-600 text-white font-extrabold hover:bg-blue-700 transition shadow-sm">
            ✅ Confirm registration
          </button>

          <a href="{{ path('front_event_show', {id: event.id}) }}"
             class="inline-flex items-center px-6 py-3 rounded-xl bg-white text-gray-800 font-extrabold border border-gray-200 hover:bg-gray-50 transition">
            Cancel
          </a>
        </div>

        {{ form_end(form) }}
      </div>
    </div>

  </div>
</section>
{% endblock %}