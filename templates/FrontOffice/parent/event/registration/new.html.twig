{% extends 'FrontOffice/parent/Partials/base_parent.html.twig' %}

{% block title %}Inscription - {{ event.title }}{% endblock %}

{% block body %}
<section class="px-6 md:px-20 lg:px-40 py-12">
  <div class="max-w-[900px] mx-auto">

    <div class="flex items-end justify-between gap-6 mb-8">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">Inscription</h1>
        <p class="text-[#617989] dark:text-gray-400 font-medium mt-2">
          Événement : <b>{{ event.title }}</b>
        </p>
      </div>

      <a href="{{ path('front_event_show', {id: event.id}) }}"
         class="h-11 px-5 rounded-full bg-black/5 dark:bg-white/10 font-bold inline-flex items-center justify-center hover:scale-105 transition-transform">
        ← Retour
      </a>
    </div>

    <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-6">
      {{ form_start(form) }}
      {{ form_errors(form) }}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2 bg-black/5 dark:bg-white/10 rounded-xl p-4">
          {{ form_row(form.childFullName) }}
          <p class="text-xs text-[#617989] dark:text-gray-400 mt-2">Exemple : Lina Ben Ali</p>
        </div>

        <div class="bg-black/5 dark:bg-white/10 rounded-xl p-4">
          {{ form_row(form.parentPhone) }}
        </div>

        <div class="bg-black/5 dark:bg-white/10 rounded-xl p-4">
          {{ form_row(form.childClassLevel) }}
        </div>

        <div class="md:col-span-2 bg-black/5 dark:bg-white/10 rounded-xl p-4">
          {{ form_row(form.medicalNotes) }}
        </div>

        <div class="bg-black/5 dark:bg-white/10 rounded-xl p-4">
          {{ form_row(form.emergencyContactName) }}
        </div>

        <div class="bg-black/5 dark:bg-white/10 rounded-xl p-4">
          {{ form_row(form.emergencyContactPhone) }}
        </div>

        <div class="md:col-span-2 bg-black/5 dark:bg-white/10 rounded-xl p-4">
          {{ form_row(form.notes) }}
        </div>
      </div>

      <button class="mt-6 h-11 px-6 rounded-full bg-accent-yellow text-[#111518] font-extrabold hover:scale-105 transition-transform">
        Confirmer l’inscription
      </button>

      {{ form_end(form) }}
    </div>
  </div>
</section>
{% endblock %}
