{% extends 'FrontOffice/parent/Partials/base_parent.html.twig' %}
{% block title %}{{ event.title }} - EduPlay{% endblock %}

{% block body %}
<section class="px-6 md:px-20 lg:px-40 py-12">
  <div class="max-w-[1280px] mx-auto">

    <a class="inline-flex items-center gap-2 text-primary font-bold mb-6 hover:underline"
       href="{{ path('front_event_index') }}">
      <span class="material-symbols-outlined">arrow_back</span>
      Retour aux événements
    </a>

    {# ✅ Header Event #}
    <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl overflow-hidden">
      {% if event.imagePath %}
        <img src="{{ asset(event.imagePath) }}" alt="{{ event.title }}" class="w-full h-64 object-cover">
      {% endif %}

      <div class="p-7">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
          <div>
            <h1 class="text-3xl md:text-4xl font-extrabold">{{ event.title }}</h1>

            <p class="text-[#617989] dark:text-gray-400 font-medium mt-3 leading-relaxed">
              {{ event.description }}
            </p>

            <div class="mt-5 flex flex-wrap gap-2">
              <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-primary/15 text-primary">
                Début : {{ event.startDate|date('d/m/Y H:i') }}
              </span>
              <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-black/10 dark:bg-white/10">
                Fin : {{ event.endDate|date('d/m/Y H:i') }}
              </span>

              {% if event.location %}
                <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-accent-pink/15 text-accent-pink">
                  📍 {{ event.location }}
                </span>
              {% endif %}
            </div>
          </div>

          {# ✅ Inscription #}
          <a class="h-11 px-6 rounded-full bg-accent-yellow text-[#111518] font-extrabold hover:scale-105 transition-transform inline-flex items-center justify-center"
            href="{{ path('front_event_register', {id: event.id}) }}">
            S'inscrire
          </a>

        </div>
      </div>
    </div>

    {# ✅ Resources / Checklist / Planning #}
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-6">

      {# Ressources (PDF/LINK) #}
      <div class="lg:col-span-2 bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-extrabold">Ressources</h2>
          <span class="text-xs font-bold text-[#617989] dark:text-gray-400">PDF / Liens</span>
        </div>

        {% set mainResources = resources|filter(r => r.type in ['PDF','LINK']) %}

        {% if mainResources is empty %}
          <p class="text-sm font-bold">Aucune ressource disponible.</p>
        {% else %}
          <div class="space-y-4">
            {% for r in mainResources %}
              <div class="p-4 rounded-2xl bg-black/5 dark:bg-white/10">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-extrabold">{{ r.title }}</h3>

                      {% if r.type == 'PDF' %}
                        <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-primary/15 text-primary">PDF</span>
                      {% else %}
                        <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-accent-pink/15 text-accent-pink">LINK</span>
                      {% endif %}
                    </div>

                    {% if r.context %}
                      <p class="text-sm text-[#617989] dark:text-gray-400 mt-2">{{ r.context }}</p>
                    {% endif %}
                  </div>

                  <div class="shrink-0">
                    {% if r.type == 'LINK' and r.url %}
                      <a class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white dark:bg-gray-900 font-extrabold text-primary hover:underline"
                         href="{{ r.url }}" target="_blank" rel="noopener">
                        🔗 Ouvrir
                      </a>
                    {% endif %}

                    {% if r.type == 'PDF' and r.filePath %}
                      <a class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white dark:bg-gray-900 font-extrabold text-primary hover:underline"
                         href="{{ asset(r.filePath) }}" target="_blank" rel="noopener">
                        📄 Ouvrir
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {# Checklist + Planning #}
      <div class="space-y-6">

        {# Checklist #}
        <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-extrabold">Checklist</h2>
            <span class="text-xs font-bold text-[#617989] dark:text-gray-400">Préparation</span>
          </div>

          {% set checklist = (resources|filter(r => r.type == 'CHECKLIST'))|first %}
          {% if checklist and checklist.context %}
            <ul class="text-sm space-y-2">
              {% for line in checklist.context|split("\n") %}
                {% set item = line|trim %}
                {% if item != '' %}
                  <li class="flex gap-2">
                    <span class="mt-[2px]">•</span>
                    <span>{{ item|replace({'- ': ''}) }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% else %}
            <p class="text-sm font-bold">Aucune checklist.</p>
          {% endif %}
        </div>

        {# Planning #}
        <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-extrabold">Planning</h2>
            <span class="text-xs font-bold text-[#617989] dark:text-gray-400">Déroulement</span>
          </div>

          {% set planning = (resources|filter(r => r.type == 'PLANNING'))|first %}
          {% if planning and planning.context %}
            <div class="space-y-2 text-sm">
              {% for line in planning.context|split("\n") %}
                {% set t = line|trim %}
                {% if t != '' %}
                  <div class="flex gap-3 items-start">
                    <span class="mt-1 w-2 h-2 rounded-full bg-primary"></span>
                    <div>{{ t }}</div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% else %}
            <p class="text-sm font-bold">Aucun planning.</p>
          {% endif %}
        </div>

      </div>
    </div>

  </div>
</section>
{% endblock %}
