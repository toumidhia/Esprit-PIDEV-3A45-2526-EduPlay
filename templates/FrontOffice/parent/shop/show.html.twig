{% extends 'FrontOffice/parent/Partials/container.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <nav class="mb-8">
        <a href="{{ path('app_front_shop') }}" class="text-primary font-bold hover:underline inline-flex items-center gap-1">
            <span class="material-symbols-outlined text-xl">arrow_back</span>
            Retour à la boutique
        </a>
    </nav>
    <article class="max-w-3xl mx-auto bg-white rounded-xl border border-[#dbe1e6] overflow-hidden shadow-lg card">
        {% if product.picture %}
            <div class="w-full h-72 bg-gray-100 overflow-hidden">
                <img src="/uploads/products/{{ product.picture }}" alt="{{ product.name }}" class="w-full h-full object-cover" />
            </div>
        {% endif %}
        <div class="p-8 md:p-12">
            <h1 class="text-3xl font-extrabold mb-4">{{ product.name }}</h1>
            <p class="text-2xl font-bold text-primary mb-6">{{ product.price|number_format(2, ',', ' ') }} DT</p>
            <p class="text-[#617989] leading-relaxed mb-8">{{ product.description }}</p>
            <p class="text-sm text-[#617989] mb-6">
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-green-100 text-green-800 font-medium">Disponible</span>
            </p>
            <a href="{{ path('app_front_commande_new', { id: product.id }) }}" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-bold rounded-full hover:opacity-90 transition-opacity shadow-lg shadow-primary/30">
                <span class="material-symbols-outlined">shopping_cart</span>
                Passer commande
            </a>
        </div>
    </article>

    {# Produits fréquemment achetés ensemble #}
    {% if frequentlyBoughtTogether is not empty %}
        <div class="mt-12">
            <h2 class="text-2xl font-extrabold mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">shopping_bag</span>
                Produits fréquemment achetés ensemble
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {% for product in frequentlyBoughtTogether %}
                    <article class="bg-white rounded-xl border border-[#dbe1e6] overflow-hidden hover:shadow-xl transition-shadow">
                        <div class="p-6">
                            <h3 class="text-lg font-extrabold mb-2">{{ product.name }}</h3>
                            <p class="text-primary font-bold mb-2">{{ product.price|number_format(2, ',', ' ') }} DT</p>
                            <a href="{{ path('app_front_shop_show', { id: product.id }) }}" class="inline-flex items-center gap-1 px-4 py-2 bg-primary text-white font-bold rounded-full text-sm hover:opacity-90 transition-opacity">
                                Voir
                                <span class="material-symbols-outlined text-sm">arrow_forward</span>
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Produits similaires #}
    {% if similarProducts is not empty %}
        <div class="mt-12">
            <h2 class="text-2xl font-extrabold mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-accent-pink">auto_awesome</span>
                Produits similaires
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {% for product in similarProducts %}
                    <article class="bg-white rounded-xl border border-[#dbe1e6] overflow-hidden hover:shadow-xl transition-shadow">
                        <div class="p-6">
                            <h3 class="text-lg font-extrabold mb-2">{{ product.name }}</h3>
                            <p class="text-primary font-bold mb-2">{{ product.price|number_format(2, ',', ' ') }} DT</p>
                            <a href="{{ path('app_front_shop_show', { id: product.id }) }}" class="inline-flex items-center gap-1 px-4 py-2 bg-primary text-white font-bold rounded-full text-sm hover:opacity-90 transition-opacity">
                                Voir
                                <span class="material-symbols-outlined text-sm">arrow_forward</span>
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
