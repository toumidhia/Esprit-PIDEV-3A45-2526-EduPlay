<header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-[#dbe1e6] dark:border-gray-800 bg-white/80 dark:bg-background-dark/80 backdrop-blur-md px-6 md:px-20 lg:px-40 py-4 sticky top-0 z-50">
    <div class="flex items-center gap-3">
        <div class="size-10 bg-primary rounded-full flex items-center justify-center text-white">
            <span class="material-symbols-outlined text-2xl">rocket_launch</span>
        </div>
        <h2 class="text-2xl font-extrabold tracking-tight">EduPlay</h2>
    </div>
    <nav class="hidden md:flex items-center gap-8">
        <a class="text-sm font-bold hover:text-primary transition-colors" href="{{ path('app_home') }}">Home</a>
        <a class="text-sm font-bold hover:text-primary transition-colors" href="{{ path('front_games') }}">Games</a>
        <a class="text-sm font-bold hover:text-primary transition-colors" href="{{ path('app_library') }}">Library</a>
        <a class="text-sm font-bold hover:text-primary transition-colors" href="{{ path('app_front_shop') }}">Shop</a>
        <a class="text-sm font-bold hover:text-primary transition-colors" href="{{ path('front_event_index') }}">Events</a>

        {% if app.user %}
            {% if is_granted('ROLE_ADMIN') %}
                <a class="text-sm font-bold text-red-500 hover:text-red-400 transition-colors" href="{{ path('app_admin_dashboard') }}">Admin Panel</a>
            {% elseif is_granted('ROLE_ENSEIGNANT') %}
                <a class="text-sm font-bold text-blue-500 hover:text-blue-400 transition-colors" href="{{ path('teacher_game_index') }}">My teaching</a>
            {% elseif is_granted('ROLE_PARENT') %}
                <a class="text-sm font-bold text-green-500 hover:text-green-400 transition-colors" href="{{ path('app_parent_dashboard') }}">My Kids</a>
            {% elseif is_granted('ROLE_KID') or is_granted('ROLE_ENFANT') %}
                <a class="text-sm font-bold text-purple-500 hover:text-purple-400 transition-colors" href="{{ path('front_games') }}">My Playground</a>
            {% endif %}
        {% endif %}
    </nav>
    <div class="flex items-center gap-4">
        {% if app.user %}
            <div class="flex items-center gap-3">
                <span class="hidden sm:flex text-sm font-bold">{{ app.user.fullName }}</span>
                <a href="{{ path('app_dashboard_redirect') }}" class="flex items-center justify-center overflow-hidden rounded-full h-11 px-6 bg-primary text-white text-sm font-bold shadow-lg shadow-primary/30 hover:scale-105 transition-transform">
                    Dashboard
                </a>
                <a href="{{ path('app_logout') }}" class="hidden sm:flex text-sm font-bold px-4 py-2 hover:text-primary transition-colors">
                    Déconnexion
                </a>
            </div>
        {% else %}
            <a href="{{ path('app_register') }}" class="hidden sm:flex text-sm font-bold px-4 py-2 hover:text-primary transition-colors">
                Sign Up
            </a>
            <a href="{{ path('app_login') }}" class="flex min-w-[100px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-11 px-6 bg-primary text-white text-sm font-bold leading-normal shadow-lg shadow-primary/30 hover:scale-105 transition-transform">
                Login
            </a>
        {% endif %}
    </div>
</header>
