{% extends 'admin/base.html.twig' %}
{% block title %}Modifier Planning{% endblock %}

{% block admin_content %}
<h1 class="text-3xl font-extrabold mb-2">Modifier le planning</h1>
<p class="text-[#617989] dark:text-gray-400 font-medium mb-6">
  Événement : <b>{{ event.title }}</b>
</p>

<div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-6">
  {{ form_start(form) }}
  {{ form_errors(form) }}

  <div class="grid grid-cols-1 gap-4">
    <div class="bg-primary/10 dark:bg-white/10 rounded-xl p-4 border border-black/5 dark:border-white/10">
      {{ form_row(form.title) }}
      {{ form_row(form.context) }}
    </div>
  </div>

  <button class="mt-6 px-6 py-3 rounded-full bg-primary text-white font-extrabold hover:scale-105 transition-transform">
    Enregistrer
  </button>

  {{ form_end(form) }}
</div>

<a class="inline-block mt-6 px-5 py-3 rounded-full bg-black/5 dark:bg-white/10 font-bold hover:scale-105 transition-transform"
   href="{{ path('admin_event_resource_index', {id: event.id}) }}">
  ← Retour
</a>
{% endblock %}
