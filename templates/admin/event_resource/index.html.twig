{% extends 'admin/base.html.twig' %}
{% block title %}Ressources - {{ event.title }}{% endblock %}

{% block admin_content %}
<div class="flex items-end justify-between mb-6">
  <div>
    <h1 class="text-3xl font-extrabold">Ressources</h1>
    <p class="text-[#617989] dark:text-gray-400 font-medium mt-1">
      Événement : <b>{{ event.title }}</b>
    </p>
  </div>
  <a href="{{ path('admin_event_resource_new', {id: event.id}) }}"
     class="px-5 py-3 rounded-full bg-primary text-white font-extrabold hover:scale-105 transition-transform">
    + Ajouter
  </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  {% if resources is empty %}
    <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-6">
      <p class="font-bold">Aucune ressource.</p>
    </div>
  {% else %}
    {% for r in resources %}
      <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-2xl p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-lg font-extrabold">{{ r.title }}</h3>

              {% set badgeClass = 'bg-black/10 dark:bg-white/10' %}
              {% if r.type == 'PDF' %}{% set badgeClass = 'bg-primary/15 text-primary' %}{% endif %}
              {% if r.type == 'LINK' %}{% set badgeClass = 'bg-accent-pink/20 text-accent-pink' %}{% endif %}
              {% if r.type == 'CHECKLIST' %}{% set badgeClass = 'bg-accent-yellow/30 text-[#111518]' %}{% endif %}
              {% if r.type == 'PLANNING' %}{% set badgeClass = 'bg-primary/10 text-primary' %}{% endif %}

              <span class="text-xs font-extrabold px-3 py-1 rounded-full {{ badgeClass }}">
                {{ r.type }}
              </span>
            </div>

            {% if r.type == 'LINK' and r.url %}
              <p class="text-sm font-bold mt-2">
                🔗 <a class="text-primary hover:underline break-all" href="{{ r.url }}" target="_blank" rel="noopener">
                  {{ r.url }}
                </a>
              </p>
            {% endif %}

            {% if r.type == 'PDF' and r.filePath %}
              <p class="text-sm font-bold mt-2">
                📄 <a class="text-primary hover:underline" href="{{ asset(r.filePath) }}" target="_blank" rel="noopener">
                  Ouvrir le PDF
                </a>
              </p>
            {% endif %}

            {% if r.type == 'CHECKLIST' and r.context %}
              <div class="mt-3">
                <p class="text-sm font-extrabold mb-2">✅ Checklist</p>
                <ul class="text-sm space-y-1">
                  {% for line in r.context|split("\n") %}
                    {% set item = line|trim %}
                    {% if item != '' %}
                      <li class="flex gap-2">
                        <span class="mt-[2px]">•</span>
                        <span>{{ item|replace({'- ': ''}) }}</span>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if r.type == 'PLANNING' and r.context %}
              <div class="mt-3">
                <p class="text-sm font-extrabold mb-2">🗓️ Planning</p>
                <div class="space-y-2">
                  {% for line in r.context|split("\n") %}
                    {% set t = line|trim %}
                    {% if t != '' %}
                      <div class="flex gap-3 items-start">
                        <span class="mt-1 w-2 h-2 rounded-full bg-primary"></span>
                        <div class="text-sm">{{ t }}</div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if r.type not in ['CHECKLIST','PLANNING'] and r.context %}
              <p class="mt-3 text-sm text-[#617989] dark:text-gray-400">
                {{ r.context }}
              </p>
            {% endif %}
          </div>

          <div class="flex flex-col gap-2 shrink-0">
            {# ✅ Modifier selon le type #}
            {% if r.type == 'CHECKLIST' %}
              <a class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 font-bold text-center hover:scale-105 transition-transform"
                 href="{{ path('admin_event_checklist_edit', {eventId: event.id, resourceId: r.id}) }}">
                Modifier
              </a>
            {% elseif r.type == 'PLANNING' %}
              <a class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 font-bold text-center hover:scale-105 transition-transform"
                 href="{{ path('admin_event_planning_edit', {eventId: event.id, resourceId: r.id}) }}">
                Modifier
              </a>
            {% else %}
              <a class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 font-bold text-center hover:scale-105 transition-transform"
                 href="{{ path('admin_event_resource_edit', {eventId: event.id, resourceId: r.id}) }}">
                Modifier
              </a>
            {% endif %}

            <form method="post"
                  action="{{ path('admin_event_resource_delete', {eventId: event.id, resourceId: r.id}) }}"
                  onsubmit="return confirm('Supprimer cette ressource ?');">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_resource_' ~ r.id) }}">
              <button class="w-full px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 font-bold hover:scale-105 transition-transform"
                      type="submit">
                Supprimer
              </button>
            </form>
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>

<a class="inline-block mt-6 px-5 py-3 rounded-full bg-black/5 dark:bg-white/10 font-bold hover:scale-105 transition-transform"
   href="{{ path('admin_event_index') }}">
  ← Retour événements
</a>
{% endblock %}
