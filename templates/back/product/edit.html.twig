{% extends 'back/base.html.twig' %}

{% block title %}Modifier {{ product.name }}{% endblock %}

{% block body %}
    <div class="mb-8">
        <a href="{{ path('app_back_product_index') }}" class="text-primary font-bold hover:underline inline-flex items-center gap-1">
            <span class="material-symbols-outlined text-xl">arrow_back</span>
            Retour à la liste
        </a>
    </div>
    <h1 class="text-3xl font-extrabold mb-8">Modifier le produit</h1>

    <div class="bg-white rounded-xl border border-[#dbe1e6] p-8 max-w-2xl">
        {% import '_form_errors.html.twig' as ferrors %}
        {{ form_start(form) }}
        {{ ferrors.show(form) }}
        <div class="space-y-6">
            <div>
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                {{ ferrors.show(form.name) }}
            </div>
            <div>
                {{ form_label(form.price) }}
                {{ form_widget(form.price) }}
                {{ ferrors.show(form.price) }}
            </div>
            <div>
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ ferrors.show(form.description) }}
            </div>
            <div class="flex items-center gap-2">
                {{ form_widget(form.availability) }}
                {{ form_label(form.availability) }}
                {{ form_errors(form.availability) }}
            </div>
        </div>
        <div class="mt-8 flex gap-4">
            <button type="submit" class="px-6 py-3 bg-primary text-white font-bold rounded-full hover:opacity-90 transition-opacity">
                Enregistrer
            </button>
            <a href="{{ path('app_back_product_index') }}" class="px-6 py-3 border border-[#dbe1e6] rounded-full font-bold hover:bg-background-light transition-colors">
                Annuler
            </a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
