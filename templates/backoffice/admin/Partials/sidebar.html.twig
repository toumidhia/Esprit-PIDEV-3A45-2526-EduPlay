    <!-- Footer avec déconnexion -->
    <div class="p-4 border-t border-gray-200 mt-auto">
        <a href="{{ path('app_logout') }}" 
           class="flex items-center gap-3 p-3 bg-gradient-to-r from-red-50 to-rose-50 rounded-xl hover:from-red-100 hover:to-rose-100 transition-all duration-200 group">
            <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg flex items-center justify-center">
                <i class="bi bi-box-arrow-right text-white text-sm"></i>
            </div>
            <div>
                <span class="font-medium text-red-600">Déconnexion</span>
                <p class="text-xs text-gray-500">{{ app.user.firstName }} {{ app.user.lastName }}</p>
            </div>
        </a>
    </div>
</aside>

<style>
/* Scrollbar personnalisée pour la sidebar */
.sidebar-nav::-webkit-scrollbar {
    width: 4px;
}

.sidebar-nav::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
}

.sidebar-nav::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
    border-radius: 4px;
}

.sidebar-nav::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
}

/* Animation pour les liens */
.admin-sidebar a {
    position: relative;
    overflow: hidden;
}

.admin-sidebar a::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.1);
    transform: translate(-50%, -50%);
    transition: width 0.3s, height 0.3s;
}

.admin-sidebar a:active::after {
    width: 200px;
    height: 200px;
}

/* Style pour les éléments actifs */
.admin-sidebar a.bg-gradient-to-r {
    box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.1);
}

/* Style pour les headings */
.sidebar-heading {
    list-style: none;
}

/* Assurer que la sidebar reste fixe */
.admin-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    z-index: 1000;
    box-shadow: 4px 0 10px rgba(0, 0, 0, 0.02);
}

/* Ajustement du contenu principal */
main {
    margin-left: var(--sidebar-width);
}

/* Style pour l'état hover */
.admin-sidebar a:hover i {
    transform: scale(1.1);
    transition: transform 0.2s;
}

.admin-sidebar a i {
    transition: transform 0.2s;
}

/* Badge pour l'utilisateur actif dans le footer */
.footer-user-badge {
    font-size: 0.7rem;
    padding: 2px 6px;
    background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
    color: white;
    border-radius: 12px;
    margin-left: 8px;
}

/* Animation d'entrée pour les éléments */
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-10px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.admin-sidebar li {
    animation: slideIn 0.3s ease-out forwards;
    opacity: 0;
}

{% for i in 0..20 %}
.admin-sidebar li:nth-child({{ i }}) {
    animation-delay: {{ i * 0.02 }}s;
}
{% endfor %}
</style>