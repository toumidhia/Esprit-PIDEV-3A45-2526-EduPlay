{# templates/backoffice/admin/event/edit.html.twig #}
{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Modifier événement{% endblock %}

{% block content %}
<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

  {# ===== HEADER GRADIENT ===== #}
  <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
      <div>
        <h1 class="text-4xl font-extrabold mb-2">✏️ Modifier un événement</h1>
        <p class="text-blue-100 font-medium">Mets à jour les informations de l’événement.</p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a href="{{ path('admin_event_show', {id: event.id}) }}"
           class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-extrabold rounded-xl hover:bg-white/30 transition-all duration-300 border border-white/30">
          <span class="material-symbols-outlined mr-2 text-base">visibility</span>
          Voir
        </a>

        <a href="{{ path('admin_event_index') }}"
           class="inline-flex items-center px-6 py-3 bg-white text-indigo-700 font-extrabold rounded-xl hover:bg-indigo-50 transition-all duration-300 shadow-sm">
          <span class="material-symbols-outlined mr-2 text-base">arrow_back</span>
          Retour
        </a>
      </div>
    </div>
  </div>

  {# ===== FORM ===== #}
  <div class="p-6">
    <div class="rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50 p-6 shadow-sm">
      {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
      {{ form_errors(form) }}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          {{ form_row(form.title) }}
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          {{ form_row(form.location) }}
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          {{ form_row(form.startDate) }}
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          {{ form_row(form.endDate) }}
        </div>

        <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-3">
            <span class="material-symbols-outlined text-indigo-600">description</span>
            <div class="font-extrabold text-gray-900">Description</div>
          </div>
          {{ form_row(form.description) }}
        </div>

        <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-3">
            <span class="material-symbols-outlined text-indigo-600">image</span>
            <div class="font-extrabold text-gray-900">Image</div>
          </div>
          {{ form_row(form.imageFile) }}
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <button type="submit"
                class="inline-flex items-center px-6 py-3 rounded-xl bg-blue-600 text-white font-extrabold hover:bg-blue-700 transition shadow-sm">
          <span class="material-symbols-outlined mr-2 text-base">save</span>
          Enregistrer
        </button>

        <a href="{{ path('admin_event_index') }}"
           class="inline-flex items-center px-6 py-3 rounded-xl bg-white text-gray-800 font-extrabold border border-gray-200 hover:bg-gray-50 transition">
          Annuler
        </a>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}