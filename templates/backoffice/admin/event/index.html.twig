{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Admin - Événements{% endblock %}

{% block content %}

{# ===== HEADER GRADIENT ===== #}
<div class="rounded-2xl overflow-hidden shadow-lg border border-white/40 mb-8">
  <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
      <div>
        <h1 class="text-4xl font-extrabold mb-2">🗓️ Gestion des événements</h1>
        <p class="text-blue-100 font-medium">Créer, modifier, supprimer et rechercher des événements.</p>
      </div>

      <a href="{{ path('admin_event_new') }}"
         class="inline-flex items-center px-6 py-3 bg-white text-indigo-700 font-extrabold rounded-xl hover:bg-indigo-50 transition-all shadow-sm">
        <span class="material-symbols-outlined mr-2 text-base">add</span>
        Nouvel événement
      </a>
    </div>
  </div>

  {# ===== SEARCH + SORT BAR ===== #}
  <div class="bg-white px-6 py-5 border-t border-gray-100">
    <div class="flex flex-col lg:flex-row gap-4 lg:items-center lg:justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center">
          <span class="material-symbols-outlined text-indigo-600">search</span>
        </div>
        <div>
          <div class="text-xl font-extrabold text-gray-900">Liste des événements</div>
          <div class="text-sm text-gray-500 font-semibold">Recherche + tri</div>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-3 w-full lg:w-auto">
        <div class="relative w-full md:w-[360px]">
          <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-sm">search</span>
          <input id="eventSearch"
                 value="{{ q|default('') }}"
                 class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
                 placeholder="Rechercher (titre, lieu, description...)">
        </div>

        <select id="eventSort"
                class="w-full md:w-[220px] px-4 py-2.5 border border-gray-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="createdAt" {{ sort == 'createdAt' ? 'selected' : '' }}>Tri : création</option>
          <option value="startDate"  {{ sort == 'startDate' ? 'selected' : '' }}>Tri : date début</option>
          <option value="endDate"    {{ sort == 'endDate' ? 'selected' : '' }}>Tri : date fin</option>
          <option value="title"      {{ sort == 'title' ? 'selected' : '' }}>Tri : titre</option>
        </select>

        <button id="eventOrder"
                data-order="{{ order|default('desc') }}"
                class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-gray-50 border border-gray-200 font-extrabold hover:bg-gray-100">
          <span class="material-symbols-outlined text-base">swap_vert</span>
          <span id="orderLabel">{{ (order|default('desc')) == 'asc' ? 'Asc' : 'Desc' }}</span>
        </button>
      </div>
    </div>
  </div>
</div>

{# ===== TABLE ===== #}
<div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
  <div class="overflow-hidden rounded-2xl border border-gray-200">
    <table class="w-full text-left">
      <thead class="bg-gradient-to-r from-gray-50 to-gray-100">
        <tr>
          <th class="p-4 font-extrabold text-gray-700">Titre</th>
          <th class="p-4 font-extrabold text-gray-700">Début</th>
          <th class="p-4 font-extrabold text-gray-700">Fin</th>
          <th class="p-4 font-extrabold text-gray-700">Actions</th>
        </tr>
      </thead>

      <tbody id="eventsTbody" class="divide-y divide-gray-200">
        {% include 'BackOffice/admin/event/_rows.html.twig' with { events: events } %}
      </tbody>
    </table>
  </div>
</div>

<script>
(function () {
  const searchEl = document.getElementById('eventSearch');
  const sortEl = document.getElementById('eventSort');
  const orderBtn = document.getElementById('eventOrder');
  const orderLabel = document.getElementById('orderLabel');
  const tbody = document.getElementById('eventsTbody');

  let timer = null;

  function getOrder() {
    return orderBtn.dataset.order || 'desc';
  }

  function setOrder(v) {
    orderBtn.dataset.order = v;
    orderLabel.textContent = v === 'asc' ? 'Asc' : 'Desc';
  }

  async function refresh() {
    const params = new URLSearchParams();
    params.set('q', searchEl.value.trim());
    params.set('sort', sortEl.value);
    params.set('order', getOrder());

    const url = "{{ path('admin_event_index') }}?" + params.toString();

    const res = await fetch(url, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });

    const html = await res.text();
    tbody.innerHTML = html;

    // garder l'URL propre (optionnel)
    window.history.replaceState({}, '', url);
  }

  function debouncedRefresh() {
    clearTimeout(timer);
    timer = setTimeout(refresh, 250);
  }

  searchEl.addEventListener('input', debouncedRefresh);
  sortEl.addEventListener('change', refresh);

  orderBtn.addEventListener('click', function () {
    setOrder(getOrder() === 'asc' ? 'desc' : 'asc');
    refresh();
  });
})();
</script>

{% endblock %}