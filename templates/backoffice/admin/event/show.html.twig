{% extends 'BackOffice/admin/base.html.twig' %}
{% block title %}Voir événement{% endblock %}

{% block admin_content %}
<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
  <div class="px-8 py-10 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
      <div>
        <h1 class="text-4xl font-extrabold mb-2">👀 {{ event.title }}</h1>
        <p class="text-blue-100 font-medium">📍 {{ event.location }}</p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a href="{{ path('admin_event_resource_index', {id: event.id}) }}"
           class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-extrabold rounded-xl hover:bg-white/30 transition-all border border-white/30">
          <span class="material-symbols-outlined mr-2 text-base">folder_open</span>
          Ressources
        </a>

        <a href="{{ path('admin_event_index') }}"
           class="inline-flex items-center px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-extrabold rounded-xl hover:bg-white/30 transition-all border border-white/30">
          <span class="material-symbols-outlined mr-2 text-base">arrow_back</span>
          Retour
        </a>
      </div>
    </div>
  </div>

  <div class="p-6">
    {% if event.imagePath %}
      <div class="overflow-hidden rounded-2xl border border-gray-200 shadow-sm mb-6">
        <img src="{{ asset(event.imagePath) }}" class="w-full max-h-96 object-cover" alt="{{ event.title }}">
      </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50 p-5 shadow-sm">
        <div class="text-xs font-extrabold text-gray-500 mb-2">Début</div>
        <div class="font-extrabold text-gray-900">📅 {{ event.startDate|date('d/m/Y H:i') }}</div>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50 p-5 shadow-sm">
        <div class="text-xs font-extrabold text-gray-500 mb-2">Fin</div>
        <div class="font-extrabold text-gray-900">⏱️ {{ event.endDate|date('d/m/Y H:i') }}</div>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50 p-5 shadow-sm">
        <div class="text-xs font-extrabold text-gray-500 mb-2">Lieu</div>
        <div class="font-extrabold text-gray-900">📍 {{ event.location }}</div>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-extrabold mb-3">Description</h2>
      <p class="text-gray-700 leading-relaxed font-medium">{{ event.description }}</p>
    </div>
  </div>
</div>
{% endblock %}