{# templates/BackOffice/admin/resource/_form.html.twig #}
{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-8'}}) }}

    <!-- EN-TÊTE DU FORMULAIRE -->
    <div class="mb-8 pb-6">
        <div class="flex items-center">
            <div class="p-3 bg-gradient-to-r from-indigo-100 to-purple-100 rounded-xl mr-4">
                <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
            </div>
            <div>
            
                <p class="text-gray-500">Remplissez les champs ci-dessous pour {{ is_edit is defined and is_edit ? 'modifier' : 'créer' }} une ressource</p>
            </div>
        </div>
    </div>

    <!-- CHAMPS DU FORMULAIRE -->
    <div class="space-y-6">
        {# Titre #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.title, "Titre de la ressource", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
            </div>
            {{ form_widget(form.title, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300',
                    'placeholder': 'Ex: Le Petit Prince'
                }
            }) }}
            {{ form_errors(form.title, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            <p class="text-xs text-gray-500 mt-2">3 à 100 caractères</p>
        </div>

        {# Auteur #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.author, "Auteur", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
            </div>
            {{ form_widget(form.author, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300',
                    'placeholder': 'Ex: Antoine de Saint-Exupéry'
                }
            }) }}
            {{ form_errors(form.author, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            <p class="text-xs text-gray-500 mt-2">3 à 50 caractères</p>
        </div>

        {# Résumé #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.summary, "Résumé", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-gray-500 bg-gray-50 px-2 py-1 rounded">Optionnel</span>
            </div>
            {{ form_widget(form.summary, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300 resize-none',
                    'rows': 4,
                    'placeholder': 'Résumez brièvement le contenu de la ressource...'
                }
            }) }}
            {{ form_errors(form.summary, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            <p class="text-xs text-gray-500 mt-1">Optionnel - Max 500 caractères</p>
        </div>

        {# Type et Langue #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="group">
                <div class="flex items-center justify-between mb-2">
                    {{ form_label(form.type, "Type de ressource", {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                    }) }}
                    <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
                </div>
                {{ form_widget(form.type, {
                    'attr': {
                        'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300'
                    }
                }) }}
                {{ form_errors(form.type, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            </div>
            
            <div class="group">
                <div class="flex items-center justify-between mb-2">
                    {{ form_label(form.language, "Langue", {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                    }) }}
                    <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
                </div>
                {{ form_widget(form.language, {
                    'attr': {
                        'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300'
                    }
                }) }}
                {{ form_errors(form.language, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            </div>
        </div>

        {# Âge minimum et maximum #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="group">
                <div class="flex items-center justify-between mb-2">
                    {{ form_label(form.minAge, "Âge minimum", {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                    }) }}
                    <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
                </div>
                {{ form_widget(form.minAge, {
                    'attr': {
                        'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300',
                        'placeholder': 'Ex: 3'
                    }
                }) }}
                {{ form_errors(form.minAge, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
                <p class="text-xs text-gray-500 mt-1">Minimum 3 ans</p>
            </div>
            
            <div class="group">
                <div class="flex items-center justify-between mb-2">
                    {{ form_label(form.maxAge, "Âge maximum", {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                    }) }}
                    <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
                </div>
                {{ form_widget(form.maxAge, {
                    'attr': {
                        'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300',
                        'placeholder': 'Ex: 12'
                    }
                }) }}
                {{ form_errors(form.maxAge, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
                <p class="text-xs text-gray-500 mt-1">Maximum 12 ans</p>
            </div>
        </div>

        {# Bibliothèque #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.libraryId, "Bibliothèque associée", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-1 rounded">Requis</span>
            </div>
            {{ form_widget(form.libraryId, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300'
                }
            }) }}
            {{ form_errors(form.libraryId, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            <p class="text-xs text-gray-500 mt-1">Sélectionnez la bibliothèque parente</p>
        </div>

        {# Image de couverture #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.coverImageFile, "Image de couverture", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-gray-500 bg-gray-50 px-2 py-1 rounded">Optionnel</span>
            </div>
            
            {% if is_edit is defined and is_edit and resource.coverImage is defined and resource.coverImage %}
                <p class="text-sm text-gray-600 mb-2 bg-blue-50 px-3 py-2 rounded-lg border border-blue-100">
                    ℹ️ Laissez vide pour conserver l'image actuelle
                </p>
            {% endif %}
            
            {{ form_widget(form.coverImageFile, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl hover:border-indigo-400 transition-all duration-300 group-hover:border-indigo-300 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100'
                }
            }) }}
            {{ form_errors(form.coverImageFile, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            
            {% if resource.coverImage is defined and resource.coverImage %}
                <div class="mt-4 p-4 bg-gradient-to-r from-gray-50 to-white rounded-xl border border-gray-100">
                    <p class="text-sm font-medium text-gray-700 mb-2">Image actuelle :</p>
                    <div class="flex items-center space-x-4">
                        <img src="{{ asset('uploads/' ~ resource.coverImage) }}" 
                             alt="Image de couverture" 
                             class="w-32 h-32 object-cover rounded-lg border-2 border-gray-200 shadow-sm">
                        <div class="text-sm text-gray-600">
                            <p class="font-medium">📸 Image actuellement enregistrée</p>
                            <p class="text-xs mt-1">Taille recommandée : 800×600px</p>
                            <p class="text-xs">Formats : JPG, PNG, WebP</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# Fichier PDF #}
        <div class="group">
            <div class="flex items-center justify-between mb-2">
                {{ form_label(form.pdfFileFile, "Fichier PDF", {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}
                }) }}
                <span class="text-xs font-medium text-gray-500 bg-gray-50 px-2 py-1 rounded">Optionnel</span>
            </div>
            
            {% if is_edit is defined and is_edit and resource.pdfFile is defined and resource.pdfFile %}
                <p class="text-sm text-gray-600 mb-2 bg-blue-50 px-3 py-2 rounded-lg border border-blue-100">
                    ℹ️ Laissez vide pour conserver le PDF actuel
                </p>
            {% endif %}
            
            {{ form_widget(form.pdfFileFile, {
                'attr': {
                    'class': 'w-full px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl hover:border-indigo-400 transition-all duration-300 group-hover:border-indigo-300 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100'
                }
            }) }}
            {{ form_errors(form.pdfFileFile, {'attr': {'class': 'mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-lg border border-red-100'}}) }}
            
            {% if resource.pdfFile is defined and resource.pdfFile %}
                <div class="mt-4 p-4 bg-gradient-to-r from-gray-50 to-white rounded-xl border border-gray-100">
                    <p class="text-sm font-medium text-gray-700 mb-2">PDF actuel :</p>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="p-3 bg-red-50 rounded-lg">
                                <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-800">PDF déjà uploadé</p>
                                <p class="text-xs text-gray-500">Taille maximale : 10MB</p>
                            </div>
                        </div>
                        <a href="{{ asset('pdfs/' ~ resource.pdfFile) }}" 
                           target="_blank" 
                           class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-indigo-50 to-purple-50 text-indigo-700 font-medium rounded-lg hover:from-indigo-100 hover:to-purple-100 transition-all duration-300 border border-indigo-100">
                            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                            Télécharger
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- BOUTONS D'ACTION -->
    <div class="flex justify-end space-x-4 pt-8 border-t border-gray-200">
        <a href="{{ path('admin_resource_index') }}" 
           class="px-6 py-3 border-2 border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Annuler
        </a>
        {{ form_widget(form.save, {
            'attr': {
                'class': 'px-8 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold rounded-xl hover:from-indigo-600 hover:to-purple-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center'
            }
        }) }}
    </div>

{{ form_end(form) }}