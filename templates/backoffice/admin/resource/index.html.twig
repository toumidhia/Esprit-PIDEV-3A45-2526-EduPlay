{% extends 'backoffice/admin/Partials/container.html.twig' %}

{% block title %}Gestion des Ressources{% endblock %}

{% block content %}
<div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
    <!-- HEADER AVEC BACKGROUND GRADIENT -->
    <div class="px-8 py-10 bg-gradient-to-r from-indigo-500 to-purple-600 text-white">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-4xl font-bold mb-2">📚 Gestion des Ressources</h1>
                <p class="text-indigo-100">Explorez, recherchez et gérez votre collection de ressources</p>
            </div>
            <a href="{{ path('admin_resource_new') }}" 
               class="inline-flex items-center px-6 py-3 bg-white text-indigo-600 font-bold rounded-xl hover:bg-indigo-50 transition-all duration-300 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 hover:scale-105">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path>
                </svg>
                Nouvelle Ressource
            </a>
        </div>
    </div>

    <!-- CARTE DES FILTRES AVEC DESIGN ÉLÉGANT -->
    <div class="p-8">

 {# ========== 🎤 RECHERCHE VOCALE ========== #}
    <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-2xl border border-purple-100 p-5 mb-8">
        <div class="flex items-center mb-4">
            <div class="p-2 bg-purple-100 rounded-xl mr-3">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                </svg>
            </div>
            <div>
                <h3 class="font-bold text-purple-800 text-lg">🎤 Recherche Vocale</h3>
                <p class="text-xs text-purple-500">Parlez pour rechercher un livre instantanément</p>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <button id="voiceBtn" onclick="toggleVoiceSearch()"
                    class="flex items-center px-5 py-3 bg-purple-600 text-white font-bold rounded-xl hover:bg-purple-700 transition-all duration-300 shadow-lg">
                <svg id="micIcon" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                </svg>
                <span id="voiceBtnText">🎤 Parler</span>
            </button>

            <div id="transcriptBox" class="flex-1 min-h-[44px] px-4 py-3 bg-white rounded-xl border-2 border-purple-200 text-gray-700 hidden">
                <span id="transcriptText" class="italic text-gray-400">En écoute...</span>
            </div>

            <button id="resetVoiceBtn" onclick="resetVoiceSearch()" 
                    class="hidden px-4 py-3 border-2 border-gray-300 text-gray-600 rounded-xl hover:bg-gray-50 transition-all font-semibold">
                ✕ Effacer
            </button>
        </div>

        <div id="voiceStatus" class="mt-3 text-sm text-purple-600 hidden">
            <span class="inline-flex items-center">
                <span class="animate-pulse mr-2">🔴</span>
                <span id="voiceStatusText">Écoute en cours...</span>
            </span>
        </div>
    </div>

    {# Résultats vocaux #}
    <div id="voiceResults" class="hidden mb-8">
        <div class="flex items-center justify-between mb-4">
            <h4 class="font-bold text-gray-700 text-lg">
                Résultats pour : <span id="voiceQuery" class="text-purple-600"></span>
            </h4>
            <span id="voiceCount" class="text-sm text-gray-500 bg-gray-100 px-3 py-1 rounded-full"></span>
        </div>
        <div id="voiceResultsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </div>
    {# ========================================= #}
    
        <div class="bg-gradient-to-br from-gray-50 to-white rounded-2xl border border-gray-100 shadow-xl p-6 mb-8">
            <div class="flex items-center mb-6">
                <div class="p-3 bg-gradient-to-r from-indigo-100 to-purple-100 rounded-xl mr-4">
                    <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800">Filtres & Recherche</h2>
                    <p class="text-gray-500">Affinez votre recherche avec les critères ci-dessous</p>
                </div>
            </div>

            {{ form_start(searchForm, {'attr': {'class': 'space-y-6'}}) }}
            
            <!-- PREMIÈRE LIGNE : RECHERCHE ET FILTRES -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                <!-- Recherche par titre -->
                <div class="relative group">
                    {{ form_label(searchForm.title, null, {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2 pl-1'}
                    }) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                      d="M4 6h16M4 12h16m-7 6h7"/>
                            </svg>
                        </div>
                        {{ form_widget(searchForm.title, {
                            'attr': {
                                'class': 'pl-10 pr-4 py-3 w-full border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300',
                                'placeholder': 'Rechercher par titre...'
                            }
                        }) }}
                    </div>
                </div>

                <!-- Recherche par auteur -->
                <div class="relative group">
                    {{ form_label(searchForm.author, null, {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2 pl-1'}
                    }) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </div>
                        {{ form_widget(searchForm.author, {
                            'attr': {
                                'class': 'pl-10 pr-4 py-3 w-full border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300',
                                'placeholder': 'Rechercher par auteur...'
                            }
                        }) }}
                    </div>
                </div>

                <!-- Tri avec style premium -->
                <div class="relative group">
                    {{ form_label(searchForm.sortBy, null, {
                        'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2 pl-1'}
                    }) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                      d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"/>
                            </svg>
                        </div>
                        {{ form_widget(searchForm.sortBy, {
                            'attr': {
                                'class': 'pl-10 pr-10 py-3 w-full border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300 appearance-none bg-white'
                            }
                        }) }}
                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DEUXIÈME LIGNE : MOT-CLÉ RÉSUMÉ -->
            <div class="relative group">
                {{ form_label(searchForm.summaryKeyword, null, {
                    'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2 pl-1'}
                }) }}
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                  d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                        </svg>
                    </div>
                    {{ form_widget(searchForm.summaryKeyword, {
                        'attr': {
                            'class': 'pl-10 pr-4 py-3 w-full border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-300 group-hover:border-indigo-300',
                            'placeholder': 'Mot-clé dans le résumé...'
                        }
                    }) }}
                </div>
            </div>

            <!-- FILTRES ACTIFS (optionnel) -->
            {% if activeFilters is defined and activeFilters|length > 0 %}
            <div class="pt-4 border-t border-gray-100">
                <div class="flex flex-wrap gap-2">
                    <span class="text-sm text-gray-600 font-medium">Filtres actifs :</span>
                    {% for key, value in activeFilters %}
                        {% if value %}
                            <span class="inline-flex items-center px-3 py-1.5 bg-gradient-to-r from-indigo-50 to-purple-50 text-indigo-700 text-sm font-medium rounded-full border border-indigo-100">
                                {% if key == 'title' %}📖 "{{ value }}"
                                {% elseif key == 'author' %}👤 "{{ value }}"
                                {% elseif key == 'summaryKeyword' %}💬 "{{ value }}"
                                {% else %}{{ key }}: {{ value }}
                                {% endif %}
                                <svg class="w-4 h-4 ml-1.5 cursor-pointer" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                     onclick="removeFilter('{{ key }}')">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </span>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- TROISIÈME LIGNE : BOUTONS ET COMPTEUR -->
            <div class="flex flex-col sm:flex-row justify-between items-center pt-6 border-t border-gray-100">
                <!-- Compteur avec style -->
                <div class="mb-4 sm:mb-0">
                    {% if resources|length > 0 %}
                        <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg border border-green-100">
                            <span class="inline-flex items-center justify-center w-6 h-6 mr-2 bg-green-500 text-white text-xs font-bold rounded-full">
                                {{ resources|length }}
                            </span>
                            <span class="text-green-700 font-semibold">
                                ressource{{ resources|length > 1 ? 's' : '' }} trouvée{{ resources|length > 1 ? 's' : '' }}
                            </span>
                        </div>
                    {% endif %}
                </div>

                <!-- Boutons avec design moderne -->
                <div class="flex space-x-4">
                    {{ form_widget(searchForm.reset, {
                        'attr': {
                            'class': 'px-6 py-3 border-2 border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center'
                        }
                    }) }}
                    
                    {{ form_widget(searchForm.search, {
                        'attr': {
                            'class': 'px-8 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold rounded-xl hover:from-indigo-600 hover:to-purple-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center'
                        }
                    }) }}
                </div>
            </div>
            
            {{ form_end(searchForm) }}
        </div>

        <!-- MESSAGES FLASH AVEC ANIMATION -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 animate-fade-in-down">
                    <div class="flex items-center p-4 mb-4 rounded-xl border-l-4
                        {% if label == 'success' %}text-green-800 bg-gradient-to-r from-green-50 to-emerald-50 border-green-500
                        {% else %}text-red-800 bg-gradient-to-r from-red-50 to-rose-50 border-red-500{% endif %}">
                        <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 20 20">
                            {% if label == 'success' %}
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00 1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            {% else %}
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            {% endif %}
                        </svg>
                        <div class="font-medium">{{ message }}</div>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- LISTE DES RESSOURCES EN CARTES -->
        {% if resources|length > 0 %}
            <div class="mb-6 flex justify-between items-center">
                <h3 class="text-xl font-bold text-gray-800">Résultats de votre recherche</h3>
                <div class="text-sm text-gray-500">
                    <span class="font-semibold text-indigo-600">{{ resources|length }}</span> résultat{{ resources|length > 1 ? 's' : '' }}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for resource in resources %}
                    <!-- CARTE RESSOURCE AMÉLIORÉE -->
                    <div class="group bg-white rounded-2xl border-2 border-gray-100 hover:border-indigo-300 transition-all duration-500 hover:shadow-2xl overflow-hidden transform hover:-translate-y-2">
                        <!-- HEADER AVEC IMAGE ET TYPE -->
                        <div class="h-56 relative overflow-hidden">
                            {% if resource.coverImage %}
                                <img src="{{ asset('uploads/' ~ resource.coverImage) }}" 
                                     alt="{{ resource.title }}" 
                                     class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-indigo-100 to-purple-100">
                                    {% if resource.type == 'Livre' %}
                                        <svg class="w-20 h-20 text-indigo-300 transform group-hover:scale-110 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                                        </svg>
                                    {% elseif resource.type == 'Magazine' %}
                                        <svg class="w-20 h-20 text-purple-300 transform group-hover:scale-110 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                                        </svg>
                                    {% else %}
                                        <svg class="w-20 h-20 text-gray-300 transform group-hover:scale-110 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                    {% endif %}
                                </div>
                            {% endif %}
                            
                            <!-- BADGE TYPE AVEC COULEUR DYNAMIQUE -->
                            <div class="absolute top-4 right-4">
                                {% set type_colors = {
                                    'Livre': 'bg-gradient-to-r from-blue-400 to-indigo-500',
                                    'Magazine': 'bg-gradient-to-r from-green-400 to-teal-500',
                                    'Journal': 'bg-gradient-to-r from-yellow-400 to-orange-500',
                                    'Article': 'bg-gradient-to-r from-purple-400 to-pink-500'
                                } %}
                                <span class="px-4 py-2 {{ type_colors[resource.type]|default('bg-gradient-to-r from-gray-600 to-gray-700') }} text-white text-xs font-bold rounded-full shadow-lg backdrop-blur-sm">
                                    {{ resource.type }}
                                </span>
                            </div>
                        </div>
                        
                        <!-- CONTENU -->
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-3 group-hover:text-indigo-600 transition-colors duration-300">
                                {{ resource.title }}
                            </h3>
                            
                            <!-- AUTEUR -->
                            <div class="flex items-center text-gray-600 mb-2">
                                <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                <span class="font-medium">{{ resource.author }}</span>
                            </div>
                            
                            <!-- MÉTADONNÉES -->
                            <div class="flex flex-wrap gap-2 mb-4">
                                <span class="inline-flex items-center px-3 py-1 bg-indigo-50 text-indigo-700 text-xs font-medium rounded-full">
                                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
                                    </svg>
                                    {{ resource.language }}
                                </span>
                                 <span class="inline-flex items-center px-3 py-1 bg-blue-50 text-blue-700 text-xs font-medium rounded-full" 
                                    title="Tranche d'âge détectée par IA">
                                        🤖 {{ resource.minAge }} - {{ resource.maxAge }} ans
                                </span>
                                {% if resource.libraryId %}
                                <span class="inline-flex items-center px-3 py-1 bg-purple-50 text-purple-700 text-xs font-medium rounded-full">
                                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                    </svg>
                                    {{ resource.libraryId.name }}
                                </span>
                                {% endif %}
                            </div>
                            
                            <!-- RÉSUMÉ -->
                            {% if resource.summary %}
                            <p class="text-gray-600 text-sm mb-6 line-clamp-2 leading-relaxed">
                                {{ resource.summary|slice(0, 120) }}{% if resource.summary|length > 120 %}...{% endif %}
                            </p>
                            {% endif %}
                            
                            <!-- BOUTONS D'ACTION -->
                            <div class="flex space-x-2">
                                <!-- Bouton Voir -->
                                <a href="{{ path('admin_resource_show', {'id': resource.id}) }}" 
                                   class="flex-1 min-w-0 inline-flex items-center justify-center px-3 py-3 border border-gray-200 text-sm font-semibold rounded-xl text-gray-700 bg-white hover:bg-gray-50 hover:border-gray-300 transition-all duration-300 group/btn">
                                    <svg class="w-4 h-4 mr-2 text-gray-500 group-hover/btn:text-indigo-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                    <span class="truncate">Voir</span>
                                </a>
                                
                                <!-- Bouton Modifier -->
                                <a href="{{ path('admin_resource_edit', {'id': resource.id}) }}" 
                                   class="flex-1 min-w-0 inline-flex items-center justify-center px-3 py-3 border border-indigo-200 text-sm font-semibold rounded-xl text-indigo-700 bg-indigo-50 hover:bg-indigo-100 hover:border-indigo-300 transition-all duration-300 group/btn">
                                    <svg class="w-4 h-4 mr-2 text-indigo-600 group-hover/btn:text-indigo-700 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                    <span class="truncate">Modifier</span>
                                </a>
                                
                                <!-- Bouton Supprimer -->
                                <form method="post" 
                                      action="{{ path('admin_resource_delete', {'id': resource.id}) }}" 
                                      class="flex-1 min-w-0"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer « {{ resource.title }} » ? Cette action est irréversible.');">
                                    <input type="hidden" name="_token" 
                                           value="{{ csrf_token('delete' ~ resource.id) }}">
                                    <button type="submit" 
                                            class="w-full h-full inline-flex items-center justify-center px-3 py-3 border border-red-200 text-sm font-semibold rounded-xl text-red-700 bg-red-50 hover:bg-red-100 hover:border-red-300 transition-all duration-300 group/btn">
                                        <svg class="w-4 h-4 mr-2 text-red-600 group-hover/btn:text-red-700 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                        <span class="truncate"></span>
                                    </button>
                                </form>
                            </div>
                            
                            <!-- PDF TÉLÉCHARGEMENT SI DISPONIBLE -->
                            {% if resource.pdfFile %}
                            <div class="mt-4 pt-4 border-t border-gray-100">
                                <a href="{{ asset('pdfs/' ~ resource.pdfFile) }}" 
                                   target="_blank"
                                   class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-gradient-to-r from-gray-50 to-white border border-gray-200 text-gray-700 font-medium rounded-xl hover:bg-gray-100 hover:border-gray-300 transition-all duration-300 group/pdf">
                                    <svg class="w-5 h-5 mr-2 text-gray-500 group-hover/pdf:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                    </svg>
                                    <span class="text-sm">Télécharger PDF</span>
                                </a>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <!-- ÉTAT VIDE AVEC DESIGN AMÉLIORÉ -->
            <div class="text-center py-20 animate-fade-in">
                <div class="inline-flex items-center justify-center w-32 h-32 mb-8 bg-gradient-to-br from-indigo-50 to-purple-100 rounded-3xl">
                    <svg class="w-16 h-16 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-700 mb-3">
                    {% if activeFilters is defined and activeFilters|length > 0 %}
                        🧐 Aucun résultat trouvé
                    {% else %}
                        📄 Aucune Ressource disponible
                    {% endif %}
                </h3>
                <p class="text-gray-500 mb-8 max-w-md mx-auto">
                    {% if activeFilters is defined and activeFilters|length > 0 %}
                        Aucune ressource ne correspond à vos critères de recherche.<br>
                        Essayez de modifier vos filtres.
                    {% else %}
                        Commencez à enrichir votre collection en créant votre première ressource.
                    {% endif %}
                </p>
                <a href="{{ path('admin_resource_new') }}" 
                   class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold rounded-xl hover:from-indigo-600 hover:to-purple-700 transition-all duration-300 shadow-xl hover:shadow-2xl transform hover:-translate-y-1">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Créer une Ressource
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

@keyframes fade-in-down {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in-down {
    animation: fade-in-down 0.5s ease-out;
}

@keyframes fade-in {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

.animate-fade-in {
    animation: fade-in 0.8s ease-out;
}

/* Empêcher le débordement des textes dans les boutons */
.truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Assurer que les boutons aient une largeur minimale */
.min-w-0 {
    min-width: 0;
}
</style>

<script>
function removeFilter(filterName) {
    // Cette fonction peut être implémentée pour enlever dynamiquement les filtres
    // Pour l'instant, elle redirige vers la même page sans le filtre
    const url = new URL(window.location.href);
    url.searchParams.delete(filterName);
    window.location.href = url.toString();
}





// ========== RECHERCHE VOCALE ==========
let recognition = null;
let isListening = false;

function toggleVoiceSearch() {
    isListening ? stopListening() : startListening();
}

function startListening() {
    if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert('Utilisez Chrome pour la recherche vocale.');
        return;
    }
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SR();
    recognition.lang = 'fr-FR';
    recognition.continuous = false;
    recognition.interimResults = true;

    recognition.onstart = () => {
        isListening = true;
        document.getElementById('voiceBtn').classList.replace('bg-purple-600','bg-red-500');
        document.getElementById('voiceBtnText').textContent = '⏹ Arrêter';
        document.getElementById('transcriptBox').classList.remove('hidden');
        document.getElementById('voiceStatus').classList.remove('hidden');
    };

    recognition.onresult = (event) => {
        let final = '', interim = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
            event.results[i].isFinal ? final += event.results[i][0].transcript : interim += event.results[i][0].transcript;
        }
        document.getElementById('transcriptText').textContent = final || interim;
        document.getElementById('transcriptText').classList.remove('italic','text-gray-400');
        if (final) performVoiceSearch(final);
    };

    recognition.onerror = () => stopListening();
    recognition.onend = () => stopListening();
    recognition.start();
}

function stopListening() {
    isListening = false;
    if (recognition) recognition.stop();
    document.getElementById('voiceBtn').classList.replace('bg-red-500','bg-purple-600');
    document.getElementById('voiceBtnText').textContent = '🎤 Parler';
    document.getElementById('voiceStatus').classList.add('hidden');
}

function performVoiceSearch(query) {
    document.getElementById('resetVoiceBtn').classList.remove('hidden');
    fetch('{{ path("admin_resource_voice_search") }}', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({query: query})
    })
    .then(r => r.json())
    .then(data => displayVoiceResults(data.results, data.query));
}

function displayVoiceResults(results, query) {
    document.getElementById('voiceQuery').textContent = '"' + query + '"';
    document.getElementById('voiceCount').textContent = results.length + ' résultat(s)';
    document.getElementById('voiceResultsList').innerHTML = results.length === 0
        ? `<div class="col-span-3 text-center py-8 text-gray-500">🔍 Aucun livre trouvé pour "${query}"</div>`
        : results.map(r => `
            <a href="${r.showUrl}" class="block bg-white rounded-xl border-2 border-purple-100 hover:border-purple-400 p-4 transition-all hover:shadow-lg">
                <div class="flex items-start gap-3">
                    ${r.coverImage
                        ? `<img src="/uploads/${r.coverImage}" class="w-12 h-16 object-cover rounded-lg flex-shrink-0">`
                        : `<div class="w-12 h-16 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">📚</div>`}
                    <div>
                        <h5 class="font-bold text-gray-800">${r.title}</h5>
                        <p class="text-sm text-gray-500">👤 ${r.author}</p>
                        <span class="text-xs px-2 py-0.5 bg-blue-50 text-blue-700 rounded-full">🤖 ${r.minAge}-${r.maxAge} ans</span>
                    </div>
                </div>
            </a>`).join('');
    document.getElementById('voiceResults').classList.remove('hidden');
}

function resetVoiceSearch() {
    document.getElementById('voiceResults').classList.add('hidden');
    document.getElementById('transcriptBox').classList.add('hidden');
    document.getElementById('resetVoiceBtn').classList.add('hidden');
    document.getElementById('transcriptText').textContent = 'En écoute...';
    document.getElementById('transcriptText').classList.add('italic','text-gray-400');
}
</script>
{% endblock %}