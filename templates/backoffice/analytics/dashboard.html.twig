{% extends 'BackOffice/base.html.twig' %}

{% block title %}Analytiques - EduPlay{% endblock %}

{% block body %}
<h1 class="h3 mb-4"><i class="bi bi-graph-up"></i> Tableau de Bord Analytique</h1>

{# Main Statistics #}
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card primary">
            <div class="card-body">
                <h6 class="text-muted">Total Cours</h6>
                <h2>{{ totalCourses }}</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card success">
            <div class="card-body">
                <h6 class="text-muted">Cours Actifs</h6>
                <h2>{{ activeCourses }}</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card warning">
            <div class="card-body">
                <h6 class="text-muted">En Attente</h6>
                <h2>{{ pendingCourses }}</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card primary">
            <div class="card-body">
                <h6 class="text-muted">Inscriptions Actives</h6>
                <h2>{{ totalSubscriptions }}</h2>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        {# Level Distribution Chart #}
        <div class="card mb-4">
            <div class="card-header">
                <h5><i class="bi bi-pie-chart"></i> Répartition par Niveau</h5>
            </div>
            <div class="card-body">
                <canvas id="levelChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        {# Status Distribution Chart #}
        <div class="card mb-4">
            <div class="card-header">
                <h5><i class="bi bi-bar-chart"></i> Statut des Cours</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>Acceptés</span>
                        <strong>{{ activeCourses }}</strong>
                    </div>
                    <div class="progress" style="height: 25px;">
                        <div class="progress-bar bg-success" style="width: {{ activeCourses > 0 ? (activeCourses / totalCourses * 100)|round : 0 }}%">
                            {{ activeCourses > 0 ? (activeCourses / totalCourses * 100)|round : 0  }}%
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>En Attente</span>
                        <strong>{{ pendingCourses }}</strong>
                    </div>
                    <div class="progress" style="height: 25px;">
                        <div class="progress-bar bg-warning" style="width: {{ totalCourses > 0 ? (pendingCourses / totalCourses * 100)|round : 0 }}%">
                            {{ totalCourses > 0 ? (pendingCourses / totalCourses * 100)|round : 0 }}%
                        </div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between">
                        <span>Rejetés</span>
                        <strong>{{ rejectedCourses }}</strong>
                    </div>
                    <div class="progress" style="height: 25px;">
                        <div class="progress-bar bg-danger" style="width: {{ totalCourses > 0 ? (rejectedCourses / totalCourses * 100)|round : 0 }}%">
                            {{ totalCourses > 0 ? (rejectedCourses / totalCourses * 100)|round : 0 }}%
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-info-circle"></i> Comment utiliser les Statistiques</h5>
            </div>
            <div class="card-body">
                <h6>Fonctionnalités Analytiques Disponibles:</h6>
                <ul>
                    <li><strong>Vue d'ensemble des cours:</strong> Nombre total, statuts, et répartition par niveau</li>
                    <li><strong>Inscriptions:</strong> Suivi du nombre total d'inscriptions actives</li>
                    <li><strong>Performance:</strong> Analyse des cours les plus/moins populaires</li>
                    <li><strong>Participants:</strong> Détails démographiques (âge, niveau scolaire) pour chaque cours</li>
                    <li><strong>PDF Analytics:</strong> Informations sur les fichiers PDF téléchargés (taille, nombre de pages estimées)</li>
                </ul>

                <h6 class="mt-4">Accès Rapide:</h6>
                <div class="btn-group" role="group">
                    <a href="{{ path('app_analytics_performance') }}" class="btn btn-primary">
                        <i class="bi bi-bar-chart-line"></i> Analyse de Performance
                    </a>
                    <a href="{{ path('app_course_index') }}" class="btn btn-success">
                        <i class="bi bi-book"></i> Voir tous les Cours
                    </a>
                    <a href="{{ path('app_subscription_list') }}" class="btn btn-info">
                        <i class="bi bi-people"></i> Liste des Inscriptions
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Level Distribution Pie Chart
    const levelCtx = document.getElementById('levelChart').getContext('2d');
    new Chart(levelCtx, {
        type: 'pie',
        data: {
            labels: ['Débutant', 'Intermédiaire', 'Avancé'],
            datasets: [{
                data: [{{ beginnerCourses }}, {{ intermediateCourses }}, {{ advancedCourses }}],
                backgroundColor: ['#28a745', '#ffc107', '#dc3545'],
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                }
            }
        }
    });
</script>
{% endblock %}
