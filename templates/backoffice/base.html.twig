{# templates/BackOffice/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPlay - Administration{% endblock %}</title>

    {# Bootstrap 5 CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Bootstrap Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    {% block stylesheets %}
        <style>
            :root {
                --sidebar-width: 250px;
                --primary-color: #63b7f2;
                --secondary-color: #6c757d;
                --success-color: #28a745;
                --danger-color: #dc3545;
                --warning-color: #ffc107;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
            }

            /* Sidebar Styles */
            .sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 100;
                padding: 0;
                box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
                background-color: #2c3e50;
                width: var(--sidebar-width);
            }

            .sidebar-sticky {
                position: sticky;
                top: 0;
                height: calc(100vh - 48px);
                padding-top: .5rem;
                overflow-x: hidden;
                overflow-y: auto;
            }

            .sidebar .nav-link {
                color: #e0e0e0;
                padding: 12px 20px;
                font-weight: 500;
                transition: all 0.3s;
            }

            .sidebar .nav-link:hover {
                color: #fff;
                background-color: rgba(255, 255, 255, 0.1);
            }

            .sidebar .nav-link.active {
                color: #fff;
                background-color: var(--primary-color);
            }

            .sidebar .nav-link i {
                margin-right: 10px;
            }

            .sidebar-heading {
                font-size: .75rem;
                text-transform: uppercase;
                padding: 20px 20px 10px;
                color: #a0a0a0;
                font-weight: 600;
            }

            /* Main Content */
            main {
                margin-left: var(--sidebar-width);
                padding: 20px;
            }

            /* Top Navbar */
            .navbar-custom {
                background-color: #fff;
                box-shadow: 0 2px 4px rgba(0,0,0,.08);
                margin-left: var(--sidebar-width);
            }

            /* Cards */
            .card {
                border: none;
                box-shadow: 0 0 10px rgba(0,0,0,.05);
                margin-bottom: 20px;
            }

            .card-header {
                background-color: #fff;
                border-bottom: 2px solid #f8f9fa;
                font-weight: 600;
            }

            /* Badges */
            .badge-status-pending {
                background-color: #ffc107;
                color: #000;
            }

            .badge-status-accepted {
                background-color: #28a745;
            }

            .badge-status-rejected {
                background-color: #dc3545;
            }

            /* Forms */
            .form-error {
                color: #dc3545;
                font-size: 0.875rem;
                margin-top: 0.25rem;
            }

            .form-control.is-invalid {
                border-color: #dc3545;
            }

            /* Stat Cards */
            .stat-card {
                border-left: 4px solid;
                transition: transform 0.2s;
            }

            .stat-card:hover {
                transform: translateY(-3px);
            }

            .stat-card.primary {
                border-left-color: var(--primary-color);
            }

            .stat-card.success {
                border-left-color: var(--success-color);
            }

            .stat-card.warning {
                border-left-color: var(--warning-color);
            }

            .stat-card.danger {
                border-left-color: var(--danger-color);
            }

            /* Buttons */
            .btn-primary {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
            }

            .btn-primary:hover {
                background-color: #4a9fd6;
                border-color: #4a9fd6;
            }

            /* Table */
            .table thead th {
                border-bottom: 2px solid #dee2e6;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.875rem;
                color: #6c757d;
            }

            /* Search Bar */
            .search-wrapper {
                position: relative;
            }

            .search-wrapper i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
            }

            .search-wrapper input {
                padding-left: 40px;
            }

            /* Logo */
            .sidebar-brand {
                padding: 20px;
                background-color: rgba(0, 0, 0, 0.2);
                color: #fff;
                font-size: 1.5rem;
                font-weight: bold;
                text-align: center;
            }

            .sidebar-brand span {
                color: var(--primary-color);
            }

            /* User avatar */
            .user-avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: bold;
            }

            .bg-admin { background-color: #dc3545; }
            .bg-enseignant { background-color: #28a745; }
            .bg-parent { background-color: #ffc107; color: #000; }
            .bg-enfant { background-color: #17a2b8; }
        </style>
    {% endblock %}
</head>
<body>
{# Sidebar #}
<nav class="sidebar">
    <div class="sidebar-brand">
        <i class="bi bi-mortarboard-fill"></i> Edu<span>Play</span>
    </div>

    <div class="sidebar-sticky">
        <ul class="nav flex-column">

            {# ================= DASHBOARD ================= #}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_dashboard' %}active{% endif %}"
                   href="{{ path('app_dashboard') }}">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>

            {% if is_granted('ROLE_ADMIN') %}

                {# ================= E-COMMERCE ================= #}
                <div class="sidebar-heading">E-Commerce</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_seance' %}active{% endif %}" href="{{ path('app_seance_index') }}">
                        <i class="bi bi-calendar-event"></i> Séances
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_subscription_list' %}active{% endif %}" href="{{ path('app_subscription_list') }}">
                        <i class="bi bi-people"></i> Inscriptions Séances
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'admin_event_index' %}active{% endif %}" href="{{ path('admin_event_index') }}">
                        <i class="bi bi-people"></i> Events
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_subscription_list' %}active{% endif %}" href="{{ path('app_subscription_list') }}">
                        <i class="bi bi-people"></i> Inscriptions Event
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_back_product' %}active{% endif %}"
                       href="{{ path('app_back_product_index') }}">
                        <i class="bi bi-box-seam"></i> Produits
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_back_commande' %}active{% endif %}"
                       href="{{ path('app_back_commande_index') }}">
                        <i class="bi bi-cart-check"></i> Commandes
                    </a>
                </li>

                {# ================= LIBRARY ================= #}
                <div class="sidebar-heading">Bibliothèque</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'admin_library' %}active{% endif %}"
                       href="{{ path('admin_library_index') }}">
                        <i class="bi bi-book"></i> Library
                    </a>
                </li>

                {# ================= EVENTS ================= #}
                <div class="sidebar-heading">Événements</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'admin_event' %}active{% endif %}"
                       href="{{ path('admin_event_index') }}">
                        <i class="bi bi-calendar-event"></i> Events
                    </a>
                </li>

                {# ================= RESSOURCES ================= #}
                <div class="sidebar-heading">Ressources</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'admin_resource' %}active{% endif %}"
                       href="{{ path('admin_resource_index') }}">
                        <i class="bi bi-folder2-open"></i> Ressources
                    </a>
                </li>

                {# ================= USERS ================= #}
                <div class="sidebar-heading">Utilisateurs</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') == 'app_admin_users' %}active{% endif %}"
                       href="{{ path('app_admin_users') }}">
                        <i class="bi bi-people-fill"></i> Users
                    </a>
                </li>

                {# ================= STATISTIQUES ================= #}
                <div class="sidebar-heading">Analytiques</div>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') == 'admin_stats' %}active{% endif %}"
                       href="{{ path('admin_stats') }}">
                        <i class="bi bi-graph-up"></i> Statistiques
                    </a>
                </li>

            {% endif %}

            {# ================= ACCOUNT ================= #}
            <div class="sidebar-heading">Compte</div>

            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="bi bi-box-arrow-right"></i> Déconnexion
                </a>
            </li>

        </ul>
    </div>
</nav>


{# Top Navbar #}
<nav class="navbar navbar-custom navbar-light">
    <div class="container-fluid">
            <span class="navbar-text">
                <i class="bi bi-person-circle"></i>
                Bienvenue, <strong>{{ app.user.firstName }} {{ app.user.lastName }}</strong>
                <span class="badge bg-secondary ms-2">{{ app.user.type|upper }}</span>
            </span>
    </div>
</nav>

{# Main Content #}
<main>
    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-{% if label == 'success' %}check-circle{% elseif label == 'error' or label == 'danger' %}exclamation-triangle{% else %}info-circle{% endif %}"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

{# Bootstrap 5 JS Bundle #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>