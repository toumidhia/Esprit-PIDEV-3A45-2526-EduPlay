{% extends 'backoffice/base.html.twig' %}

{% block title %}Courses Management{% endblock %}

{% block body %}
{% set currentRole = app.request.query.get('role', 'admin')|lower %}
<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Courses</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard', {role: currentRole}) }}">Home</a></li>
            <li class="breadcrumb-item">Courses</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex d-md-none">
                <a href="javascript:void(0)" class="page-header-right-close-toggle">
                    <i class="feather-arrow-left me-2"></i>
                    <span>Back</span>
                </a>
            </div>
            <div class="d-flex align-items-center gap-2 page-header-right-items-wrapper">
                <!-- Search Box -->
                <form method="get" action="{{ path('app_course_index', {role: currentRole}) }}" class="d-flex">
                    <input type="hidden" name="role" value="{{ currentRole }}">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Search courses..." value="{{ filters.search|default('') }}">
                        <button class="btn btn-light-brand" type="submit">
                            <i class="feather-search"></i>
                        </button>
                    </div>
                </form>
                
                <a href="javascript:void(0);" class="btn btn-icon btn-light-brand" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                    <i class="feather-bar-chart"></i>
                </a>
                <div class="dropdown">
                    <a class="btn btn-icon btn-light-brand" data-bs-toggle="dropdown" data-bs-offset="0, 12" data-bs-auto-close="outside">
                        <i class="feather-filter"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <a href="{{ path('app_course_index', {role: currentRole}) }}" class="dropdown-item">
                            <i class="feather-eye me-3"></i>
                            <span>All</span>
                        </a>
                        <a href="{{ path('app_course_index', {status: 'pending', role: currentRole}) }}" class="dropdown-item">
                            <i class="feather-clock me-3"></i>
                            <span>Pending</span>
                        </a>
                        <a href="{{ path('app_course_index', {status: 'accepted', role: currentRole}) }}" class="dropdown-item">
                            <i class="feather-check me-3"></i>
                            <span>Accepted</span>
                        </a>
                        <a href="{{ path('app_course_index', {status: 'rejected', role: currentRole}) }}" class="dropdown-item">
                            <i class="feather-x me-3"></i>
                            <span>Rejected</span>
                        </a>
                    </div>
                </div>
                {% if userRole == 'ROLE_TEACHER' %}
                <a href="{{ path('app_course_new', {role: currentRole}) }}" class="btn btn-primary">
                    <i class="feather-plus me-2"></i>
                    <span>New Course</span>
                </a>
                {% endif %}
            </div>
        </div>
        <div class="d-md-none d-flex align-items-center">
            <a href="javascript:void(0)" class="page-header-right-open-toggle">
                <i class="feather-align-right fs-20"></i>
            </a>
        </div>
    </div>
</div>
<div id="collapseOne" class="accordion-collapse collapse page-header-collapse">
    <div class="accordion-body pb-2">
        <div class="row">
            <div class="col-xxl-3 col-md-6">
                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="fw-bold d-block">
                                <span class="d-block text-muted">Total Courses</span>
                                <span class="fs-20 fw-bold d-block text-dark">{{ statistics.total ?? 0 }}</span>
                            </div>
                            <div class="avatar-text avatar-lg bg-soft-primary text-primary">
                                <i class="feather-book-open"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-3 col-md-6">
                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="fw-bold d-block">
                                <span class="d-block text-muted">Pending</span>
                                <span class="fs-20 fw-bold d-block text-warning">{{ statistics.pending ?? 0 }}</span>
                            </div>
                            <div class="avatar-text avatar-lg bg-soft-warning text-warning">
                                <i class="feather-clock"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-3 col-md-6">
                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="fw-bold d-block">
                                <span class="d-block text-muted">Accepted</span>
                                <span class="fs-20 fw-bold d-block text-success">{{ statistics.accepted ?? 0 }}</span>
                            </div>
                            <div class="avatar-text avatar-lg bg-soft-success text-success">
                                <i class="feather-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-3 col-md-6">
                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="fw-bold d-block">
                                <span class="d-block text-muted">Rejected</span>
                                <span class="fs-20 fw-bold d-block text-danger">{{ statistics.rejected ?? 0 }}</span>
                            </div>
                            <div class="avatar-text avatar-lg bg-soft-danger text-danger">
                                <i class="feather-x-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ page-header ] end -->

<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card stretch stretch-full">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover" id="coursesList">
                            <thead>
                                <tr>
                                    <th>Course Title</th>
                                    <th>Teacher</th>
                                    <th>Level</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                    <th>Latest Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for course in courses %}
                                <tr class="single-item">
                                    <td>
                                        <a href="{{ path('app_course_show', {id: course.id}) }}" class="fw-bold text-dark">
                                            {{ course.title }}
                                        </a>
                                    </td>
                                    <td>
                                        <a href="javascript:void(0)" class="hstack gap-2">
                                            <div class="avatar-image avatar-sm">
                                                <div class="avatar-text avatar-sm bg-primary text-white">
                                                    {{ course.teacherId ? (course.teacherId.firstName|slice(0, 1) ~ course.teacherId.lastName|slice(0, 1))|upper : 'NA' }}
                                                </div>
                                            </div>
                                            <span>{{ course.teacherId ? course.teacherId.firstName ~ ' ' ~ course.teacherId.lastName : 'Not Assigned' }}</span>
                                        </a>
                                    </td>
                                    <td>{{ course.level|default('N/A') }}</td>
                                    <td class="fw-bold text-dark">{{ course.durationTraining }}</td>
                                    <td>
                                        {% if course.status == 'pending' %}
                                        <div class="badge bg-soft-warning text-warning">Pending</div>
                                        {% elseif course.status == 'accepted' %}
                                        <div class="badge bg-soft-success text-success">Accepted</div>
                                        {% elseif course.status == 'rejected' %}
                                        <div class="badge bg-soft-danger text-danger">Rejected</div>
                                        {% else %}
                                        <div class="badge bg-soft-secondary text-secondary">{{ course.status|capitalize }}</div>
                                        {% endif %}
                                    </td>
                                    <td>{{ course.status|capitalize }}</td>
                                    <td>
                                        <div class="hstack gap-2 justify-content-end">
                                            <a href="{{ path('app_course_show', {id: course.id}) }}" class="avatar-text avatar-md" title="View">
                                                <i class="feather feather-eye"></i>
                                            </a>
                                            {% if userRole == 'ROLE_ADMIN' or (userRole == 'ROLE_TEACHER' and course.teacherId == app.user.id|default('')) %}
                                            <div class="dropdown">
                                                <a href="javascript:void(0)" class="avatar-text avatar-md" data-bs-toggle="dropdown" data-bs-offset="0,21">
                                                    <i class="feather feather-more-horizontal"></i>
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <a class="dropdown-item" href="{{ path('app_course_edit', {id: course.id}) }}">
                                                            <i class="feather feather-edit-3 me-3"></i>
                                                            <span>Edit</span>
                                                        </a>
                                                    </li>
                                                    {% if userRole == 'ROLE_ADMIN' %}
                                                    <li class="dropdown-divider"></li>
                                                    <li>
                                                        <form method="post" action="{{ path('app_course_delete', {id: course.id}) }}" onsubmit="return confirm('Are you sure you want to delete this course?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
                                                            <button class="dropdown-item text-danger">
                                                                <i class="feather feather-trash-2 me-3"></i>
                                                                <span>Delete</span>
                                                            </button>
                                                        </form>
                                                    </li>
                                                    {% endif %}
                                                </ul>
                                            </div>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="feather-inbox fs-1 mb-3 d-block"></i>
                                            <p>No courses found</p>
                                            {% if userRole in ['ROLE_ADMIN', 'ROLE_TEACHER'] %}
                                            <a href="{{ path('app_course_new') }}" class="btn btn-primary mt-2">
                                                <i class="feather-plus me-2"></i>Create Your First Course
                                            </a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Initialize DataTable if available
    $(document).ready(function() {
        if ($.fn.DataTable) {
            $('#coursesList').DataTable({
                order: [[5, 'desc']], // Order by date
                pageLength: 25
            });
        }
    });
</script>
{% endblock %}
