{% extends 'BackOffice/base.html.twig' %}

{% block title %}Nouveau Cours - EduPlay{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-plus-circle"></i> Créer un Nouveau Cours</h4>
                </div>
                <div class="card-body">
                    {# Affichage des erreurs globales du formulaire #}
                    {% if form.vars.errors|length > 0 %}
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            {{ form_errors(form) }}
                        </div>
                    {% endif %}

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    {# Titre du cours #}
                    <div class="mb-3">
                        {{ form_label(form.title, 'Titre du cours', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        <span class="text-danger">*</span>
                        {{ form_widget(form.title, {'attr': {
                            'class': form.title.vars.errors|length > 0 ? 'form-control is-invalid' : 'form-control',
                            'placeholder': 'Ex: Programmation Python pour débutants'
                        }}) }}
                        {% if form.title.vars.errors|length > 0 %}
                            <div class="invalid-feedback">
                                {% for error in form.title.vars.errors %}
                                    {{ error.message }}<br>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <small class="form-text text-muted">Minimum 3 caractères, maximum 255 caractères</small>
                    </div>

                    {# Description du cours #}
                    <div class="mb-3">
                        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        <span class="text-danger">*</span>
                        {{ form_widget(form.description, {'attr': {
                            'class': form.description.vars.errors|length > 0 ? 'form-control is-invalid' : 'form-control',
                            'placeholder': 'Décrivez le contenu du cours, les objectifs pédagogiques...',
                            'rows': 5
                        }}) }}
                        {% if form.description.vars.errors|length > 0 %}
                            <div class="invalid-feedback">
                                {% for error in form.description.vars.errors %}
                                    {{ error.message }}<br>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <small class="form-text text-muted">Minimum 10 caractères, maximum 255 caractères</small>
                    </div>

                    <div class="row">
                        {# Durée de formation #}
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.durationTraining, 'Durée de formation', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <span class="text-danger">*</span>
                            {{ form_widget(form.durationTraining, {'attr': {
                                'class': form.durationTraining.vars.errors|length > 0 ? 'form-control is-invalid' : 'form-control',
                                'placeholder': 'Ex: 8 semaines, 3 mois'
                            }}) }}
                            {% if form.durationTraining.vars.errors|length > 0 %}
                                <div class="invalid-feedback">
                                    {% for error in form.durationTraining.vars.errors %}
                                        {{ error.message }}<br>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="form-text text-muted">Format: 8 semaines, 3 mois, etc.</small>
                        </div>

                        {# Niveau du cours #}
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.level, 'Niveau', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <span class="text-danger">*</span>
                            {{ form_widget(form.level, {'attr': {
                                'class': form.level.vars.errors|length > 0 ? 'form-select is-invalid' : 'form-select'
                            }}) }}
                            {% if form.level.vars.errors|length > 0 %}
                                <div class="invalid-feedback">
                                    {% for error in form.level.vars.errors %}
                                        {{ error.message }}<br>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Fichier PDF #}
                    <div class="mb-3">
                        {{ form_label(form.pdfFile, 'Fichier PDF', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.pdfFile, {'attr': {
                            'class': form.pdfFile.vars.errors|length > 0 ? 'form-control is-invalid' : 'form-control',
                            'accept': '.pdf'
                        }}) }}
                        {% if form.pdfFile.vars.errors|length > 0 %}
                            <div class="invalid-feedback">
                                {% for error in form.pdfFile.vars.errors %}
                                    {{ error.message }}<br>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <small class="form-text text-muted">Format PDF uniquement, max 10 MB (optionnel)</small>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Votre cours sera soumis pour approbation par un administrateur.
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_course_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Créer le Cours
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Style pour les messages d'erreur */
        .invalid-feedback {
            display: block;
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        /* Style pour les champs en erreur */
        .is-invalid {
            border-color: #dc3545 !important;
            padding-right: calc(1.5em + 0.75rem);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }

        /* Animation pour les erreurs */
        .is-invalid {
            animation: shake 0.5s;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }

        /* Style pour les champs obligatoires */
        .text-danger {
            margin-left: 2px;
        }
    </style>
{% endblock %}