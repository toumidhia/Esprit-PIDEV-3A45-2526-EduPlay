{% extends 'backoffice/base.html.twig' %}

{% block title %}Course Details{% endblock %}

{% block body %}
{% set currentRole = app.request.query.get('role', 'admin')|lower %}
<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Course Details</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard', {role: currentRole}) }}">Home</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_course_index', {role: currentRole}) }}">Courses</a></li>
            <li class="breadcrumb-item">{{ course.title }}</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex align-items-center gap-2 page-header-right-items-wrapper">
                <a href="{{ path('app_course_index') }}" class="btn btn-light-brand">
                    <i class="feather-arrow-left me-2"></i>
                    <span>Back to List</span>
                </a>
                {% if userRole == 'ROLE_ADMIN' or (userRole == 'ROLE_TEACHER' and course.teacherId == app.user.id|default('')) %}
                <a href="{{ path('app_course_edit', {id: course.id}) }}" class="btn btn-primary">
                    <i class="feather-edit me-2"></i>
                    <span>Edit Course</span>
                </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Status badges and tab navigation -->
<div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <ul class="nav nav-tabs-custom" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#overviewTab" role="tab" aria-selected="true">
                            <i class="feather-book-open me-2"></i>
                            <span>Overview</span>
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#seancesTab" role="tab" aria-selected="false">
                            <i class="feather-calendar me-2"></i>
                            <span>Seances</span>
                        </a>
                    </li>
                    {% if course.pdfFile %}
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#materialsTab" role="tab" aria-selected="false">
                            <i class="feather-file-text  me-2"></i>
                            <span>Materials</span>
                        </a>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ page-header ] end -->

<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="tab-content">
        <!-- Overview Tab -->
        <div class="tab-pane fade active show" id="overviewTab" role="tabpanel">
            <div class="row">
                <!-- Course Information -->
                <div class="col-lg-8">
                    <div class="card stretch stretch-full">
                        <div class="card-header">
                            <h5 class="card-title">{{ course.title }}</h5>
                            <div class="card-header-action">
                                {% if course.status == 'pending' %}
                                <span class="badge bg-warning text-white">Pending Approval</span>
                                {% elseif course.status == 'accepted' %}
                                <span class="badge bg-success">Accepted</span>
                                {% elseif course.status == 'rejected' %}
                                <span class="badge bg-danger">Rejected</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3">Description</h6>
                                <p class="text-muted">{{ course.description }}</p>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="avatar-text avatar-md bg-soft-primary text-primary me-3">
                                            <i class="feather-award"></i>
                                        </div>
                                        <div>
                                            <small class="text-muted">Level</small>
                                            <div class="fw-medium">{{ course.level|capitalize }}</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="avatar-text avatar-md bg-soft-info text-info me-3">
                                            <i class="feather-clock"></i>
                                        </div>
                                        <div>
                                            <small class="text-muted">Duration</small>
                                            <div class="fw-medium">{{ course.durationTraining }}</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="avatar-text avatar-md bg-soft-success text-success me-3">
                                            <i class="feather-user"></i>
                                        </div>
                                        <div>
                                            <small class="text-muted">Teacher</small>
                                            <div class="fw-medium">{{ course.teacherId ? course.teacherId.firstName ~ ' ' ~ course.teacherId.lastName : 'Not assigned' }}</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="avatar-text avatar-md bg-soft-warning text-warning me-3">
                                            <i class="feather-book"></i>
                                        </div>
                                        <div>
                                            <small class="text-muted">Status</small>
                                            <div class="fw-medium">{{ course.status|capitalize }}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {% if course.pdfFile %}
                            <div class="alert alert-info d-flex align-items-center" role="alert">
                                <i class="feather-file-text me-3 fs-4"></i>
                                <div class="flex-grow-1">
                                    <strong>Course Materials Available</strong>
                                    <p class="mb-0 small">Download the course materials for reference</p>
                                </div>
                                <a href="{{ asset('uploads/courses/' ~ course.pdfFile) }}" target="_blank" class="btn btn-sm btn-primary">
                                    <i class="feather-download me-2"></i>Download PDF
                                </a>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="col-lg-4">
                    <!-- Course Metadata -->
                    <div class="card stretch stretch-full">
                        <div class="card-header">
                            <h5 class="card-title">Course Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Teacher</small>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-text avatar-md bg-primary text-white me-2">
                                        {{ course.teacherId ? (course.teacherId.firstName|slice(0, 1) ~ course.teacherId.lastName|slice(0, 1))|upper : 'NA' }}
                                    </div>
                                    <span class="fw-medium">{{ course.teacherId ? course.teacherId.firstName ~ ' ' ~ course.teacherId.lastName : 'Not Assigned' }}</span>
                                </div>
                            </div>

                            <hr>

                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Duration</small>
                                <div class="fw-medium">{{ course.durationTraining }}</div>
                            </div>

                            <hr>

                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Status</small>
                                {% if course.status == 'pending' %}
                                <span class="badge bg-warning">Pending</span>
                                {% elseif course.status == 'accepted' %}
                                <span class="badge bg-success">Accepted</span>
                                {% elseif course.status == 'rejected' %}
                                <span class="badge bg-danger">Rejected</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- Admin Actions -->
                    {% if userRole == 'ROLE_ADMIN' %}
                    <div class="card stretch stretch-full">
                        <div class="card-header">
                            <h5 class="card-title">Admin Actions</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                {% if course.status != 'accepted' %}
                                <form method="post" action="{{ path('app_course_edit', {id: course.id}) }}">
                                    <input type="hidden" name="quick_action" value="accept">
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="feather-check me-2"></i>Approve Course
                                    </button>
                                </form>
                                {% endif %}
                                
                                {% if course.status != 'rejected' %}
                                <form method="post" action="{{ path('app_course_edit', {id: course.id}) }}">
                                    <input type="hidden" name="quick_action" value="reject">
                                    <button type="submit" class="btn btn-danger w-100">
                                        <i class="feather-x me-2"></i>Reject Course
                                    </button>
                                </form>
                                {% endif %}

                                <form method="post" action="{{ path('app_course_delete', {id: course.id}) }}" onsubmit="return confirm('Are you sure you want to delete this course?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="feather-trash-2 me-2"></i>Delete Course
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Seances Tab -->
        <div class="tab-pane fade" id="seancesTab" role="tabpanel">
            <div class="row">
                <div class="col-12">
                    <div class="card stretch stretch-full">
                        <div class="card-header">
                            <h5 class="card-title">Course Seances</h5>
                            {% if userRole == 'ROLE_ADMIN' %}
                            <a href="{{ path('app_seance_new', {course: course.id}) }}" class="btn btn-primary">
                                <i class="feather-plus me-2"></i>Add Seance
                            </a>
                            {% endif %}
                        </div>
                        <div class="card-body">
                            <p class="text-muted text-center py-5">
                                <i class="feather-calendar fs-1 d-block mb-3"></i>
                                No seances scheduled for this course yet.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Materials Tab -->
        {% if course.pdfFile %}
        <div class="tab-pane fade" id="materialsTab" role="tabpanel">
            <div class="row">
                <div class="col-12">
                    <div class="card stretch stretch-full">
                        <div class="card-header">
                            <h5 class="card-title">Course Materials</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between p-4 bg-light rounded">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-text avatar-lg bg-danger text-white me-3">
                                        <i class="feather-file-text fs-3"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1">{{ course.title ~ ' - Course Materials.pdf' }}</h6>
                                        <small class="text-muted">PDF Document</small>
                                    </div>
                                </div>
                                <a href="{{ asset('uploads/courses/' ~ course.pdfFile) }}" target="_blank" class="btn btn-primary">
                                    <i class="feather-download me-2"></i>Download
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
<!-- [ Main Content ] end -->
{% endblock %}
