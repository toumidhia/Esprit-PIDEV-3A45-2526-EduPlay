{% extends 'backoffice/base.html.twig' %}

{% block title %}Dashboard - EduPlay Admin{% endblock %}
{% block page_title %}Dashboard Overview{% endblock %}

{% block body %}
{% set currentRole = app.request.query.get('role', 'admin')|lower %}
<div class="row g-4 mb-4">
    <!-- Total Courses -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Total Courses</p>
                        <h3 class="mb-0">{{ statistics.total ?? 0 }}</h3>
                    </div>
                    <div class="avatar avatar-lg bg-primary bg-opacity-10 text-primary rounded-circle">
                        <i class="fas fa-book fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Pending Courses -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Pending</p>
                        <h3 class="mb-0 text-warning">{{ statistics.pending ?? 0 }}</h3>
                    </div>
                    <div class="avatar avatar-lg bg-warning bg-opacity-10 text-warning rounded-circle">
                        <i class="fas fa-clock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Accepted Courses -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Accepted</p>
                        <h3 class="mb-0 text-success">{{ statistics.accepted ?? 0 }}</h3>
                    </div>
                    <div class="avatar avatar-lg bg-success bg-opacity-10 text-success rounded-circle">
                        <i class="fas fa-check-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Rejected Courses -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Rejected</p>
                        <h3 class="mb-0 text-danger">{{ statistics.rejected ?? 0 }}</h3>
                    </div>
                    <div class="avatar avatar-lg bg-danger bg-opacity-10 text-danger rounded-circle">
                        <i class="fas fa-times-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% if seanceStatistics is defined %}
<div class="row g-4 mb-4">
    <!-- Total Seances -->
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Total Seances</p>
                        <h3 class="mb-0">{{ seanceStatistics.total ?? 0 }}</h3>
                    </div>
                    <div class="avatar avatar-lg bg-info bg-opacity-10 text-info rounded-circle">
                        <i class="fas fa-calendar-alt fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Upcoming Seances -->
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Upcoming</p>
                        <h3 class="mb-0 text-primary">{{ seanceStatistics.upcoming ?? 0 }}</h3>
                    </div>
                    <div class="avatar avatar-lg bg-primary bg-opacity-10 text-primary rounded-circle">
                        <i class="fas fa-arrow-right fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Past Seances -->
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Past</p>
                        <h3 class="mb-0 text-secondary">{{ seanceStatistics.past ?? 0 }}</h3>
                    </div>
                    <div class="avatar avatar-lg bg-secondary bg-opacity-10 text-secondary rounded-circle">
                        <i class="fas fa-history fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}

<div class="row g-4">
    <!--Recent Courses -->
    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Recent Courses</h5>
                <a href="{{ path('app_course_index', {role: currentRole}) }}" class="btn btn-sm btn-primary">
                    View All <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
            <div class="card-body">
                {% if recentCourses is defined and recentCourses|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Level</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for course in recentCourses %}
                                <tr>
                                    <td>
                                        <strong>{{ course.title }}</strong>
                                        <br><small class="text-muted">{{ course.description|length > 50 ? course.description|slice(0, 50) ~ '...' : course.description }}</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">{{ course.level }}</span>
                                    </td>
                                    <td>{{ course.durationTraining }}</td>
                                    <td>
                                        {% if course.status == 'pending' %}
                                            <span class="badge bg-warning">Pending</span>
                                        {% elseif course.status == 'accepted' %}
                                            <span class="badge bg-success">Accepted</span>
                                        {% else %}
                                            <span class="badge bg-danger">Rejected</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('app_course_show', {id: course.id, role: currentRole}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <i class="fas fa-book fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No courses found</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    
    <!-- Quick Actions -->
    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-3">
                    {% if userRole == 'ROLE_TEACHER' %}
                        <a href="{{ path('app_course_new', {role: currentRole}) }}" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Create New Course
                        </a>
                        <a href="{{ path('app_course_index', {role: currentRole, status: 'pending'}) }}" class="btn btn-warning text-white">
                            <i class="fas fa-clock me-2"></i>My Pending Courses
                        </a>
                    {% endif %}
                    
                    {% if userRole == 'ROLE_ADMIN' %}
                        <a href="{{ path('app_seance_new', {role: currentRole}) }}" class="btn btn-success">
                            <i class="fas fa-calendar-plus me-2"></i>Create New Seance
                        </a>
                        <a href="{{ path('app_seance_index', {role: currentRole}) }}" class="btn btn-info text-white">
                            <i class="fas fa-calendar-alt me-2"></i>View Calendar
                        </a>
                        <a href="{{ path('app_course_index', {role: currentRole, status: 'pending'}) }}" class="btn btn-warning text-white">
                            <i class="fas fa-clock me-2"></i>Pending Approvals
                        </a>
                        <a href="{{ path('app_course_index', {role: 'parent'}) }}" class="btn btn-outline-primary">
                            <i class="fas fa-users me-2"></i>Manage Subscriptions
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
        
        {% if userRole == 'ROLE_ADMIN' and pendingCourses is defined %}
        <div class="card mt-4">
            <div class="card-header bg-warning text-white">
                <h5 class="mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Pending Approvals ({{ pendingCourses|length }})
                </h5>
            </div>
            <div class="card-body">
                {% if pendingCourses|length > 0 %}
                    <div class="list-group list-group-flush">
                        {% for course in pendingCourses|slice(0, 5) %}
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>{{ course.title }}</strong>
                                        <br><small class="text-muted">{{ course.teacherId ? course.teacherId.firstName ~ ' ' ~ course.teacherId.lastName : 'No teacher assigned' }}</small>
                                    </div>
                                    <a href="{{ path('app_course_show', {id: course.id}) }}" class="btn btn-sm btn-primary">
                                        Review
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted mb-0 text-center">No pending courses</p>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
    .avatar {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
{% endblock %}
