{% extends 'backoffice/base.html.twig' %}

{% block title %}Seance Calendar{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- TUI Calendar CSS -->
<link rel="stylesheet" href="https://uicdn.toast.com/calendar/latest/toastui-calendar.min.css" />
<style>
    .apps-calendar .content-area {
        height: calc(100vh - 80px);
        display: flex;
        flex-direction: column;
    }
    .content-area-header {
        background: white;
        padding: 1rem;
        border-bottom: 1px solid #e5e7eb;
        z-index: 10;
    }
    .content-area-body {
        flex: 1;
        overflow: hidden;
    }
    #calendar {
        height: 100%;
    }
    .calendar-dropdown-btn {
        background: #f3f4f6;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        display: flex;
        align-items-center;
    }
    .move-today, .move-day {
        background: #f3f4f6;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        cursor: pointer;
    }
    .render-range {
        font-weight: 600;
        font-size: 1.1rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="nxl-content without-header nxl-full-content apps-calendar">
    <div class="content-area">
        <!-- Calendar Header -->
        <div class="content-area-header">
            <div class="page-header-left d-flex align-items-center gap-2">
                <h5 class="mb-0">Seance Calendar</h5>
                <div id="menu" class="d-flex align-items-center justify-content-between ms-4">
                    <div class="d-flex calendar-action-btn gap-2">
                        <div class="dropdown">
                            <button id="calendarViewDropdown" class="calendar-dropdown-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="feather-grid me-2"></i>
                                <span id="calendarViewName">Monthly</span>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" data-view="month"><i class="feather-grid me-2"></i>Monthly</a></li>
                                <li><a class="dropdown-item" href="#" data-view="week"><i class="feather-umbrella me-2"></i>Weekly</a></li>
                                <li><a class="dropdown-item" href="#" data-view="day"><i class="feather-list me-2"></i>Daily</a></li>
                            </ul>
                        </div>
                        <button type="button" class="move-today btn btn-light-brand" id="todayBtn">
                            <i class="feather-clock me-2"></i>Today
                        </button>
                    </div>
                </div>
            </div>
            <div class="page-header-right ms-auto">
                <div class="hstack gap-2">
                    <div id="renderRange" class="render-range"></div>
                    <div class="btn-group gap-1" role="group">
                        <button type="button" class="avatar-text avatar-md move-day" id="prevBtn">
                            <i class="feather-chevron-left"></i>
                        </button>
                        <button type="button" class="avatar-text avatar-md move-day" id="nextBtn">
                            <i class="feather-chevron-right"></i>
                        </button>
                    </div>
                    {% if userRole == 'ROLE_ADMIN' %}
                    <a href="{{ path('app_seance_new') }}" class="btn btn-primary ms-3">
                        <i class="feather-plus me-2"></i>New Seance
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Calendar Body -->
        <div class="content-area-body p-3">
            <div id="calendar"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<!-- TUI Calendar JS -->
<script src="https://uicdn.toast.com/calendar/latest/toastui-calendar.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const Calendar = window.tui.Calendar;
    
    // Initialize calendar
    const calendar = new Calendar('#calendar', {
        defaultView: 'month',
        useFormPopup: false,
        useDetailPopup: true,
        isReadOnly: {{ userRole == 'ROLE_ADMIN' ? 'false' : 'true' }},
        week: {
            startDayOfWeek: 1,
            dayNames: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            narrowWeekend: true
        },
        month: {
            dayNames: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            startDayOfWeek: 1,
            narrowWeekend: true,
            visibleWeeksCount: 5
        },
        template: {
            time(event) {
                return `<span style="color: white;">${event.title}</span>`;
            },
            allday(event) {
                return `${event.title}`;
            }
        }
    });

    // Set calendars (categories)
    calendar.setCalendars([
        {
            id: 'seances',
            name: 'Seances',
            backgroundColor: '#63b7f2',
            borderColor: '#63b7f2',
            dragBackgroundColor: '#63b7f2'
        }
    ]);

    // Load seances from server
    const seances = {{ seances|json_encode|raw }};
    
    // Format seances for calendar
    const events = seances.map(seance => ({
        id: seance.id,
        calendarId: 'seances',
        title: seance.title || 'Session',
        category: 'time',
        start: seance.start,
        end: seance.end,
        backgroundColor: seance.status === 'completed' ? '#10b981' : '#63b7f2',
        borderColor: seance.status === 'completed' ? '#10b981' : '#63b7f2',
        isReadOnly: {{ userRole != 'ROLE_ADMIN' ? 'true' : 'false' }},
        raw: seance
    }));

    calendar.createEvents(events);

    // Update date range display
    function updateRenderRange() {
        const viewName = calendar.getViewName();
        const calDate = calendar.getDate();
        const rangeStart = calendar.getDateRangeStart();
        const rangeEnd = calendar.getDateRangeEnd();

        let year = calDate.getFullYear();
        let month = calDate.getMonth() + 1;
        let date = calDate.getDate();
        let dateRangeText = '';

        const options = { year: 'numeric', month: 'long' };

        switch (viewName) {
            case 'month':
                dateRangeText = new Intl.DateTimeFormat('en-US', options).format(calDate);
                break;
            case 'week':
                const startMonth = new Intl.DateTimeFormat('en-US', { month: 'short' }).format(rangeStart);
                const endMonth = new Intl.DateTimeFormat('en-US', { month: 'short' }).format(rangeEnd);
                dateRangeText = `${startMonth} ${rangeStart.getDate()} - ${endMonth} ${rangeEnd.getDate()}, ${year}`;
                break;
            case 'day':
                dateRangeText = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(calDate);
                break;
        }

        document.getElementById('renderRange').textContent = dateRangeText;
    }

    // Navigation buttons
    document.getElementById('prevBtn').addEventListener('click', () => {
        calendar.prev();
        updateRenderRange();
    });

    document.getElementById('nextBtn').addEventListener('click', () => {
        calendar.next();
        updateRenderRange();
    });

    document.getElementById('todayBtn').addEventListener('click', () => {
        calendar.today();
        updateRenderRange();
    });

    // View change
    document.querySelectorAll('[data-view]').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const view = e.currentTarget.getAttribute('data-view');
            calendar.changeView(view);
            document.getElementById('calendarViewName').textContent = 
                view.charAt(0).toUpperCase() + view.slice(1) + 'ly';
            updateRenderRange();
        });
    });

    // Click event handler
    calendar.on('clickEvent', (event) => {
        const seance = event.event.raw;
        if (seance && seance.id) {
            window.location.href = `{{ path('app_seance_show', {id: '_ID_'}) }}`.replace('_ID_', seance.id);
        }
    });

    // Initialize render range
    updateRenderRange();
});
</script>
{% endblock %}
