{% extends 'backoffice/base.html.twig' %}

{% block title %}{{ seance.id ? 'Edit Seance' : 'Create New Seance' }}{% endblock %}

{% block body %}
<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">{{ seance.id ? 'Edit Seance' : 'Create New Seance' }}</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Home</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_seance_index') }}">Seances</a></li>
            <li class="breadcrumb-item">{{ seance.id ? 'Edit' : 'Create' }}</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex align-items-center gap-2 page-header-right-items-wrapper">
                <a href="{{ path('app_seance_index') }}" class="btn btn-light-brand">
                    <i class="feather-arrow-left me-2"></i>
                    <span>Back to List</span>
                </a>
            </div>
        </div>
    </div>
</div>
<!-- [ page-header ] end -->

<!-- [ Main Content ] start -->
<div class="main-content">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="row">
        <div class="col-xl-8">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Seance Details</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_label(form.title) }}
                            {{ form_widget(form.title) }}
                            {{ form_errors(form.title) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.date) }}
                            {{ form_widget(form.date) }}
                            {{ form_errors(form.date) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.location) }}
                            {{ form_widget(form.location) }}
                            {{ form_errors(form.location) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.startTime) }}
                            {{ form_widget(form.startTime) }}
                            {{ form_errors(form.startTime) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.endTime) }}
                            {{ form_widget(form.endTime) }}
                            {{ form_errors(form.endTime) }}
                        </div>

                        <div class="col-md-12 mb-3">
                            {{ form_label(form.courseId) }}
                            {{ form_widget(form.courseId) }}
                            {{ form_errors(form.courseId) }}
                        </div>

                        <div class="col-md-12 mb-3">
                            {{ form_label(form.status) }}
                            {{ form_widget(form.status) }}
                            {{ form_errors(form.status) }}
                        </div>

                        <div class="col-md-12 mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            {{ form_errors(form.description) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="feather-save me-2"></i>
                            {{ seance.id ? 'Update Seance' : 'Create Seance' }}
                        </button>
                        <a href="{{ path('app_seance_index') }}" class="btn btn-light-brand">
                            <i class="feather-x me-2"></i>Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
</div>
<!-- [ Main Content ] end -->
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% endblock %}
