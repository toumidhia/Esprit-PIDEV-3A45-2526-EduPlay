{% extends 'backoffice/base.html.twig' %}

{% block title %}Seance Details{% endblock %}

{% block body %}
<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Seance Details</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Home</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_seance_index') }}">Seances</a></li>
            <li class="breadcrumb-item">Details</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex align-items-center gap-2 page-header-right-items-wrapper">
                <a href="{{ path('app_seance_index') }}" class="btn btn-light-brand">
                    <i class="feather-arrow-left me-2"></i>
                    <span>Back to List</span>
                </a>
                <a href="{{ path('app_seance_edit', {id: seance.id}) }}" class="btn btn-primary">
                    <i class="feather-edit me-2"></i>
                    <span>Edit Seance</span>
                </a>
            </div>
        </div>
    </div>
</div>
<!-- [ page-header ] end -->

<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row">
        <div class="col-lg-8">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">{{ seance.title ?? 'Session #' ~ seance.id }}</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar-text avatar-md bg-soft-primary text-primary me-3">
                                    <i class="feather-calendar"></i>
                                </div>
                                <div>
                                    <small class="text-muted">Date</small>
                                    <div class="fw-medium">{{ seance.date ? seance.date|date('M d, Y') : 'Not set' }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar-text avatar-md bg-soft-info text-info me-3">
                                    <i class="feather-clock"></i>
                                </div>
                                <div>
                                    <small class="text-muted">Time</small>
                                    <div class="fw-medium">{{ seance.startTime ? seance.startTime|date('H:i') : 'N/A' }} - {{ seance.endTime ? seance.endTime|date('H:i') : 'N/A' }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar-text avatar-md bg-soft-success text-success me-3">
                                    <i class="feather-map-pin"></i>
                                </div>
                                <div>
                                    <small class="text-muted">Location</small>
                                    <div class="fw-medium">{{ seance.location ?? 'Not specified' }}</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if seance.description %}
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2">Description</h6>
                        <p class="text-muted">{{ seance.description }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Seance Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Course</small>
                        {% if seance.courseId %}
                        <a href="{{ path('app_course_show', {id: seance.courseId.id}) }}" class="fw-medium">
                            {{ seance.courseId.title }}
                        </a>
                        {% else %}
                        <span class="text-muted">Not assigned</span>
                        {% endif %}
                    </div>

                    <hr>

                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Status</small>
                        {% if seance.status == 'scheduled' %}
                        <span class="badge bg-primary">Scheduled</span>
                        {% elseif seance.status == 'completed' %}
                        <span class="badge bg-success">Completed</span>
                        {% elseif seance.status == 'cancelled' %}
                        <span class="badge bg-danger">Cancelled</span>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_seance_edit', {id: seance.id}) }}" class="btn btn-primary">
                            <i class="feather-edit me-2"></i>Edit Seance
                        </a>
                        <form method="post" action="{{ path('app_seance_delete', {id: seance.id}) }}" onsubmit="return confirm('Are you sure?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ seance.id) }}">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="feather-trash-2 me-2"></i>Delete Seance
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->
{% endblock %}
