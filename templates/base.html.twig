<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPlay{% endblock %}</title>

    {# Tailwind via CDN (ok pour prototypage) #}
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    {# Tailwind config inline #}
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#63b7f2",
                        "accent-yellow": "#F7C56E",
                        "accent-pink": "#F29BAE",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101b22",
                    },
                    fontFamily: {
                        display: ["Plus Jakarta Sans"]
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                },
            },
        }
    </script>

    <style>
        .blob {
            position: absolute;
            filter: blur(60px);
            z-index: -1;
            opacity: 0.4;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-background-light dark:bg-background-dark font-display text-[#111518] dark:text-white transition-colors duration-300">

<div class="blob bg-primary w-64 h-64 top-0 -left-20"></div>
<div class="blob bg-accent-pink w-96 h-96 top-1/2 -right-20"></div>
<div class="blob bg-accent-yellow w-72 h-72 bottom-0 left-1/4"></div>

<div class="relative flex min-h-screen flex-col overflow-x-hidden">

    {% block header %}
        {% include 'partials/_header.html.twig' %}
    {% endblock %}

    <main class="flex-1">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        {% include 'partials/_footer.html.twig' %}
    {% endblock %}

</div>

{% block javascripts %}{% endblock %}
</body>
</html>
