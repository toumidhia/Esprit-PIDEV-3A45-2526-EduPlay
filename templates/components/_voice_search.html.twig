{# Composant recherche vocale — inclure dans index admin et front #}
<div id="voice-search-container" class="mb-6">
    <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-2xl border border-purple-100 p-5">
        <div class="flex items-center mb-3">
            <div class="p-2 bg-purple-100 rounded-xl mr-3">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                </svg>
            </div>
            <div>
                <h3 class="font-bold text-purple-800">🎤 Recherche Vocale</h3>
                <p class="text-xs text-purple-500">Parlez pour rechercher un livre</p>
            </div>
        </div>

        {# Bouton microphone #}
        <div class="flex items-center gap-4">
            <button id="voiceBtn" onclick="toggleVoiceSearch()"
                    class="flex items-center px-5 py-3 bg-purple-600 text-white font-bold rounded-xl hover:bg-purple-700 transition-all duration-300 shadow-lg">
                <svg id="micIcon" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                </svg>
                <span id="voiceBtnText">Parler</span>
            </button>

            {# Transcription en temps réel #}
            <div id="transcriptBox" class="flex-1 min-h-[44px] px-4 py-2 bg-white rounded-xl border-2 border-purple-200 text-gray-700 hidden">
                <span id="transcriptText" class="italic text-gray-400">En écoute...</span>
            </div>

            {# Bouton reset #}
            <button id="resetVoiceBtn" onclick="resetVoiceSearch()" 
                    class="hidden px-4 py-3 border-2 border-gray-300 text-gray-600 rounded-xl hover:bg-gray-50 transition-all">
                ✕ Effacer
            </button>
        </div>

        {# Indicateur d'état #}
        <div id="voiceStatus" class="mt-3 text-sm text-purple-600 hidden">
            <span class="inline-flex items-center">
                <span class="animate-pulse mr-2">🔴</span>
                <span id="voiceStatusText">Écoute en cours...</span>
            </span>
        </div>
    </div>

    {# Résultats vocaux #}
    <div id="voiceResults" class="hidden mt-4">
        <div class="flex items-center justify-between mb-3">
            <h4 class="font-bold text-gray-700">
                Résultats pour : <span id="voiceQuery" class="text-purple-600"></span>
            </h4>
            <span id="voiceCount" class="text-sm text-gray-500"></span>
        </div>
        <div id="voiceResultsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
    </div>
</div>

<script>
const VOICE_SEARCH_URL = '{{ voiceSearchUrl }}';
const IS_ADMIN = {{ isAdmin ? 'true' : 'false' }};

let recognition = null;
let isListening = false;

function toggleVoiceSearch() {
    if (isListening) {
        stopListening();
    } else {
        startListening();
    }
}

function startListening() {
    if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert('Votre navigateur ne supporte pas la reconnaissance vocale. Utilisez Chrome.');
        return;
    }

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SpeechRecognition();
    recognition.lang = 'fr-FR';
    recognition.continuous = false;
    recognition.interimResults = true;

    recognition.onstart = () => {
        isListening = true;
        document.getElementById('voiceBtn').classList.replace('bg-purple-600', 'bg-red-500');
        document.getElementById('voiceBtn').classList.replace('hover:bg-purple-700', 'hover:bg-red-600');
        document.getElementById('voiceBtnText').textContent = 'Arrêter';
        document.getElementById('transcriptBox').classList.remove('hidden');
        document.getElementById('voiceStatus').classList.remove('hidden');
    };

    recognition.onresult = (event) => {
        let interim = '';
        let final = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
            if (event.results[i].isFinal) {
                final += event.results[i][0].transcript;
            } else {
                interim += event.results[i][0].transcript;
            }
        }
        document.getElementById('transcriptText').textContent = final || interim;
        document.getElementById('transcriptText').classList.remove('italic', 'text-gray-400');
        
        if (final) {
            performVoiceSearch(final);
        }
    };

    recognition.onerror = (event) => {
        document.getElementById('voiceStatusText').textContent = 'Erreur : ' + event.error;
        stopListening();
    };

    recognition.onend = () => {
        stopListening();
    };

    recognition.start();
}

function stopListening() {
    isListening = false;
    if (recognition) recognition.stop();
    
    document.getElementById('voiceBtn').classList.replace('bg-red-500', 'bg-purple-600');
    document.getElementById('voiceBtn').classList.replace('hover:bg-red-600', 'hover:bg-purple-700');
    document.getElementById('voiceBtnText').textContent = 'Parler';
    document.getElementById('voiceStatus').classList.add('hidden');
}

function performVoiceSearch(query) {
    document.getElementById('voiceStatusText').textContent = 'Recherche en cours...';
    document.getElementById('voiceStatus').classList.remove('hidden');
    document.getElementById('resetVoiceBtn').classList.remove('hidden');

    fetch(VOICE_SEARCH_URL, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({query: query})
    })
    .then(r => r.json())
    .then(data => {
        displayVoiceResults(data.results, data.query);
        document.getElementById('voiceStatus').classList.add('hidden');
    })
    .catch(() => {
        document.getElementById('voiceStatusText').textContent = 'Erreur de recherche';
    });
}

function displayVoiceResults(results, query) {
    const container = document.getElementById('voiceResults');
    const list = document.getElementById('voiceResultsList');
    
    document.getElementById('voiceQuery').textContent = '"' + query + '"';
    document.getElementById('voiceCount').textContent = results.length + ' résultat(s)';
    
    if (results.length === 0) {
        list.innerHTML = `
            <div class="col-span-3 text-center py-8 text-gray-500">
                <p class="text-4xl mb-2">🔍</p>
                <p>Aucun livre trouvé pour "${query}"</p>
            </div>`;
    } else {
        list.innerHTML = results.map(r => `
            <a href="${r.showUrl || r.readUrl}" 
               class="block bg-white rounded-xl border-2 border-purple-100 hover:border-purple-300 p-4 transition-all hover:shadow-lg">
                <div class="flex items-start gap-3">
                    ${r.coverImage 
                        ? `<img src="/uploads/${r.coverImage}" class="w-12 h-16 object-cover rounded-lg flex-shrink-0">`
                        : `<div class="w-12 h-16 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">📚</div>`
                    }
                    <div class="min-w-0">
                        <h5 class="font-bold text-gray-800 truncate">${r.title}</h5>
                        <p class="text-sm text-gray-500">👤 ${r.author}</p>
                        <div class="flex gap-1 mt-1 flex-wrap">
                            <span class="text-xs px-2 py-0.5 bg-purple-50 text-purple-700 rounded-full">${r.type}</span>
                            <span class="text-xs px-2 py-0.5 bg-blue-50 text-blue-700 rounded-full">🤖 ${r.minAge}-${r.maxAge} ans</span>
                        </div>
                        ${r.summary ? `<p class="text-xs text-gray-400 mt-1 line-clamp-2">${r.summary}...</p>` : ''}
                    </div>
                </div>
            </a>
        `).join('');
    }
    
    container.classList.remove('hidden');
}

function resetVoiceSearch() {
    document.getElementById('voiceResults').classList.add('hidden');
    document.getElementById('transcriptBox').classList.add('hidden');
    document.getElementById('resetVoiceBtn').classList.add('hidden');
    document.getElementById('transcriptText').textContent = 'En écoute...';
    document.getElementById('transcriptText').classList.add('italic', 'text-gray-400');
}
</script>