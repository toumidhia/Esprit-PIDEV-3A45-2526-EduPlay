{% extends 'base.html.twig' %}

{% block title %}Courses - EduPlay{% endblock %}

{% block body %}
{% set currentRole = app.request.query.get('role', 'parent')|lower %}
    <div class="container mx-auto px-6 py-8">
        <!-- Role Switcher & Header -->
        <div class="flex justify-between items-center mb-8">
            <div>
                <h2 class="text-3xl font-bold text-gray-900 mb-2">
                    {% if userRole == 'ROLE_PARENT' %}
                        Available Courses for Your Kids
                    {% elseif userRole == 'ROLE_KID' %}
                        My Subscribed Courses
                    {% endif %}
                </h2>
                <p class="text-gray-600">
                    {% if userRole == 'ROLE_PARENT' %}
                        Explore and subscribe your children to educational courses
                    {% elseif userRole == 'ROLE_KID' %}
                        View the courses you're enrolled in
                    {% endif %}
                </p>
            </div>
            
            <!-- Role Switcher Buttons -->
            <div class="flex bg-white rounded-lg shadow-md p-1">
                <a href="{{ path('app_course_index', {role: 'parent'}) }}" 
                   class="px-4 py-2 rounded-md font-medium transition-all {{ currentRole == 'parent' ? 'bg-blue-500 text-white' : 'text-gray-600 hover:bg-gray-100' }}">
                    <svg class="w-5 h-5 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    Parent
                </a>
                <a href="{{ path('app_course_index', {role: 'kid'}) }}" 
                   class="px-4 py-2 rounded-md font-medium transition-all {{ currentRole == 'kid' ? 'bg-purple-500 text-white' : 'text-gray-600 hover:bg-gray-100' }}">
                    <svg class="w-5 h-5 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Kid
                </a>
            </div>
        </div>
        
        <!-- Search Bar (Parent Only) -->
        {% if userRole == 'ROLE_PARENT' %}
        <div class="mb-6">
            <form method="get" action="{{ path('app_course_index') }}" class="max-w-xl">
                <input type="hidden" name="role" value="{{ currentRole }}">
                <div class="flex gap-2">
                    <div class="flex-1 relative">
                        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        <input type="text" name="search" 
                               class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                               placeholder="Search courses by title or description..." 
                               value="{{ filters.search|default('') }}">
                    </div>
                    <button type="submit" class="px-6 py-3 bg-blue-500 text-white rounded-lg font-medium hover:bg-blue-600 transition-all">
                        Search
                    </button>
                    {% if filters.search|default('') %}
                    <a href="{{ path('app_course_index', {role: currentRole}) }}" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-all">
                        Clear
                    </a>
                    {% endif %}
                </div>
            </form>
        </div>
        {% endif %}

        <!-- Flash Messages -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-lg {% if type == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif type == 'error' %}bg-red-50 text-red-800 border border-red-200{% elseif type == 'warning' %}bg-yellow-50 text-yellow-800 border border-yellow-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Courses Grid -->
        {% if courses is empty %}
            <div class="text-center py-20">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-gray-100 rounded-full mb-4">
                    <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">
                    {% if userRole == 'ROLE_PARENT' %}
                        No courses available at the moment
                    {% elseif userRole == 'ROLE_KID' %}
                        You're not subscribed to any courses yet
                    {% endif %}
                </h3>
                <p class="text-gray-500">
                    {% if userRole == 'ROLE_KID' %}
                        Ask your parent to subscribe you to a course!
                    {% endif %}
                </p>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for course in courses %}
                    <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100">
                        <!-- Course Header -->
                        <div class="bg-gradient-to-r from-blue-500 to-purple-600 p-6 text-white">
                            <div class="flex items-start justify-between mb-3">
                                <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-xs font-medium">
                                    {{ course.level|capitalize }}
                                </span>
                                {% if course.pdfFile %}
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                                    </svg>
                                {% endif %}
                            </div>
                            <h3 class="text-xl font-bold mb-2">{{ course.title }}</h3>
                            <div class="flex items-center text-sm text-white/90">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                {{ course.durationTraining }} weeks
                            </div>
                        </div>

                        <!-- Course Body -->
                        <div class="p-6">
                            <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                                {{ course.description }}
                            </p>

                            {% if course.teacherId %}
                                <div class="flex items-center text-sm text-gray-500 mb-4 pb-4 border-b border-gray-100">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                    {{ course.teacherId.firstName }} {{ course.teacherId.lastName }}
                                </div>
                            {% endif %}

                            <!-- Actions -->
                            <div class="space-y-2">
                                {% if userRole == 'ROLE_PARENT' and kids is defined and kids is not empty %}
                                    <!-- Show subscription status for each kid -->
                                    <div class="bg-gray-50 rounded-lg p-4 space-y-2">
                                        <h4 class="text-sm font-semibold text-gray-700 mb-2">Subscriptions:</h4>
                                        {% for kid in kids %}
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-600">{{ kid.firstName }} {{ kid.lastName }}</span>
                                                {% if subscriptions[course.id][kid.id] is defined and subscriptions[course.id][kid.id] %}
                                                    <!-- Kid is subscribed - show unsubscribe button -->
                                                    <form method="post" action="{{ path('app_course_unsubscribe', {'id': course.id}) }}?role=parent" class="inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('unsubscribe' ~ course.id) }}">
                                                        <input type="hidden" name="kid_id" value="{{ kid.id }}">
                                                        <button type="submit" class="px-3 py-1 bg-red-500 text-white text-xs rounded-lg font-medium hover:bg-red-600 transition-all flex items-center space-x-1">
                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                            </svg>
                                                            <span>Unsubscribe</span>
                                                        </button>
                                                    </form>
                                                {% else %}
                                                    <!-- Kid is not subscribed - show subscribe button -->
                                                    <button 
                                                        onclick="openSubscribeModal({{ course.id }}, '{{ course.title|e('js') }}', '{{ csrf_token('subscribe' ~ course.id) }}', {{ kid.id }})"
                                                        class="px-3 py-1 bg-blue-500 text-white text-xs rounded-lg font-medium hover:bg-blue-600 transition-all flex items-center space-x-1"
                                                    >
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                                        </svg>
                                                        <span>Subscribe</span>
                                                    </button>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}

                                <a 
                                    href="{{ path('app_course_show', {'id': course.id}) }}?role={{ userRole == 'ROLE_PARENT' ? 'parent' : 'kid' }}"
                                    class="w-full block text-center px-4 py-2 border-2 border-gray-300 text-gray-700 rounded-lg font-medium hover:border-blue-500 hover:text-blue-600 transition-all duration-300"
                                >
                                    View Details
                                </a>

                                {% if course.pdfFile %}
                                    <a 
                                        href="{{ path('app_course_pdf', {'id': course.id}) }}"
                                        target="_blank"
                                        class="w-full block text-center px-4 py-2 bg-gray-100 text-gray-700 rounded-lg font-medium hover:bg-gray-200 transition-all duration-300 flex items-center justify-center space-x-2"
                                    >
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                        <span>Download PDF</span>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

<!-- Subscribe Modal for Parents -->
{% if userRole == 'ROLE_PARENT' and kids is defined and kids is not empty %}
<div id="subscribeModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 relative">
        <button 
            onclick="closeSubscribeModal()"
            class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors"
        >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>

        <h3 class="text-2xl font-bold text-gray-900 mb-2">Subscribe a Kid</h3>
        <p id="modalCourseTitle" class="text-gray-600 mb-6"></p>

        <form id="subscribeForm" method="post" action="">
            <input type="hidden" id="csrfToken" name="_token" value="">
            
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-3">Select a kid:</label>
                <div class="space-y-2">
                    {% for kid in kids %}
                        <label class="flex items-center p-3 border-2 border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer transition-all">
                            <input 
                                type="radio" 
                                name="kid_id" 
                                value="{{ kid.id }}" 
                                class="w-4 h-4 text-blue-600 focus:ring-blue-500"
                                required
                            >
                            <span class="ml-3 text-gray-700 font-medium">{{ kid.firstName }} {{ kid.lastName }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>

            <div class="flex space-x-3">
                <button 
                    type="button"
                    onclick="closeSubscribeModal()"
                    class="flex-1 px-4 py-2 border-2 border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-all"
                >
                    Cancel
                </button>
                <button 
                    type="submit"
                    class="flex-1 px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-lg font-medium hover:from-blue-600 hover:to-purple-700 transition-all"
                >
                    Subscribe
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openSubscribeModal(courseId, courseTitle, csrfToken, kidId) {
    // If kidId is provided, subscribe directly without modal
    if (kidId) {
        const form = document.createElement('form');
        form.method = 'post';
        form.action = '/course/' + courseId + '/subscribe?role=parent';
        
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = csrfToken;
        
        const kidInput = document.createElement('input');
        kidInput.type = 'hidden';
        kidInput.name = 'kid_id';
        kidInput.value = kidId;
        
        form.appendChild(tokenInput);
        form.appendChild(kidInput);
        document.body.appendChild(form);
        form.submit();
    } else {
        // Show modal for selection
        document.getElementById('modalCourseTitle').textContent = courseTitle;
        document.getElementById('subscribeForm').action = '/course/' + courseId + '/subscribe?role=parent';
        document.getElementById('csrfToken').value = csrfToken;
        document.getElementById('subscribeModal').classList.remove('hidden');
    }
}

function closeSubscribeModal() {
    document.getElementById('subscribeModal').classList.add('hidden');
}
</script>
{% endif %}
{% endblock %}
