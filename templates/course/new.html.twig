{% extends 'base.html.twig' %}

{% block title %}Create New Course{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-8 max-w-4xl">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-extrabold text-[#111518] dark:text-white mb-2">Create New Course</h1>
        <p class="text-[#617989] dark:text-gray-400">
            Fill in the details below. Your course will be pending admin approval before it becomes available.
        </p>
    </div>

    <!-- Flash Messages -->
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 p-4 rounded-lg {% if type == 'success' %}bg-green-100 text-green-800{% elseif type == 'error' %}bg-red-100 text-red-800{% else %}bg-yellow-100 text-yellow-800{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
        {{ include('course/_form.html.twig') }}
    </div>
</div>
{% endblock %}
