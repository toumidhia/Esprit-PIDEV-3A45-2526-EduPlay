{% extends 'base.html.twig' %}

{% block title %}{{ course.title }}{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-8 max-w-4xl">
    <!-- Back Button -->
    <div class="mb-6">
        <a href="{{ path('app_course_index') }}" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
            <span class="material-symbols-outlined">arrow_back</span>
            Back to Courses
        </a>
    </div>

    <!-- Course Card -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden">
        <!-- Header with Status -->
        <div class="bg-gradient-to-r from-primary to-accent-pink p-8 text-white">
            <div class="flex justify-between items-start mb-4">
                <span class="inline-flex items-center gap-1 px-4 py-2 rounded-full text-sm font-bold bg-white/20 backdrop-blur-md">
                    <span class="material-symbols-outlined text-sm">
                        {% if course.status == 'accepted' %}check_circle
                        {% elseif course.status == 'rejected' %}cancel
                        {% else %}pending{% endif %}
                    </span>
                    {{ course.status|upper }}
                </span>
                <span class="px-4 py-2 bg-white/20 backdrop-blur-md rounded-full text-sm font-bold">
                    {{ course.level }}
                </span>
            </div>
            <h1 class="text-4xl font-extrabold mb-2">{{ course.title }}</h1>
            <p class="text-white/90">{{ course.description }}</p>
        </div>

        <!-- Course Details -->
        <div class="p-8 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex items-start gap-4 p-4 bg-background-light dark:bg-gray-900 rounded-lg">
                    <div class="bg-primary/10 p-3 rounded-full">
                        <span class="material-symbols-outlined text-primary">schedule</span>
                    </div>
                    <div>
                        <h3 class="font-bold text-[#111518] dark:text-white mb-1">Duration</h3>
                        <p class="text-[#617989] dark:text-gray-400">{{ course.durationTraining }}</p>
                    </div>
                </div>

                <div class="flex items-start gap-4 p-4 bg-background-light dark:bg-gray-900 rounded-lg">
                    <div class="bg-accent-pink/10 p-3 rounded-full">
                        <span class="material-symbols-outlined text-accent-pink">signal_cellular_alt</span>
                    </div>
                    <div>
                        <h3 class="font-bold text-[#111518] dark:text-white mb-1">Level</h3>
                        <p class="text-[#617989] dark:text-gray-400">{{ course.level }}</p>
                    </div>
                </div>

                {% if course.teacherId %}
                <div class="flex items-start gap-4 p-4 bg-background-light dark:bg-gray-900 rounded-lg">
                    <div class="bg-accent-yellow/10 p-3 rounded-full">
                        <span class="material-symbols-outlined text-accent-yellow">person</span>
                    </div>
                    <div>
                        <h3 class="font-bold text-[#111518] dark:text-white mb-1">Instructor</h3>
                        <p class="text-[#617989] dark:text-gray-400">
                            {{ course.teacherId.firstName }} {{ course.teacherId.lastName }}
                        </p>
                    </div>
                </div>
                {% endif %}

                {% if course.pdfFile %}
                <div class="flex items-start gap-4 p-4 bg-background-light dark:bg-gray-900 rounded-lg">
                    <div class="bg-primary/10 p-3 rounded-full">
                        <span class="material-symbols-outlined text-primary">description</span>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-bold text-[#111518] dark:text-white mb-1">Course Materials</h3>
                        <a href="{{ path('app_course_pdf', {'id': course.id}) }}" 
                           class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
                            <span class="material-symbols-outlined">download</span>
                            Download PDF
                        </a>
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap gap-4 pt-6 border-t border-[#dbe1e6] dark:border-gray-700">
                <a href="{{ path('app_course_edit', {'id': course.id}) }}" 
                   class="flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-full font-bold hover:scale-105 transition-transform shadow-lg">
                    <span class="material-symbols-outlined">edit</span>
                    Edit Course
                </a>
                <a href="{{ path('app_course_index') }}" 
                   class="flex items-center gap-2 px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#111518] dark:text-white rounded-full font-bold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
