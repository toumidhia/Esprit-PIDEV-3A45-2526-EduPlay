{% extends 'base.html.twig' %}

{% block title %}Teacher Dashboard{% endblock %}

{% block body %}
<div class="teacher-wrapper">
    {# Sidebar #}
    <aside class="teacher-sidebar">
        <div class="sidebar-header">
            <h2>EduPlay Teacher</h2>
            <p class="teacher-name">{{ teacher.prenom }} {{ teacher.nom }}</p>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_teacher_dashboard') }}" class="nav-item active">
                <span class="icon">📊</span>
                <span>My Courses</span>
            </a>
            <a href="{{ path('app_teacher_course_new') }}" class="nav-item">
                <span class="icon">➕</span>
                <span>New Course</span>
            </a>
            <a href="#" class="nav-item">
                <span class="icon">📈</span>
                <span>Analytics</span>
            </a>
            <a href="#" class="nav-item">
                <span class="icon">👥</span>
                <span>My Students</span>
            </a>
            <a href="{{ path('app_cours_front') }}" class="nav-item">
                <span class="icon">🏠</span>
                <span>View Frontend</span>
            </a>
        </nav>
    </aside>

    {# Main Content #}
    <main class="teacher-main">
        <div class="teacher-header">
            <h1>My Courses</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {# Statistics #}
        <div class="teacher-stats">
            <div class="stat-card">
                <h3>{{ stats.total }}</h3>
                <p>Total Courses</p>
            </div>
            <div class="stat-card">
                <h3>{{ stats.approved }}</h3>
                <p>Published</p>
            </div>
            <div class="stat-card">
                <h3>{{ stats.pending }}</h3>
                <p>Pending</p>
            </div>
            <div class="stat-card">
                <h3>{{ stats.rejected }}</h3>
                <p>Rejected</p>
            </div>
        </div>

        {# Courses List #}
        <div class="courses-list">
            {% if courses|length > 0 %}
                {% for cours in courses %}
                <div class="teacher-course-card">
                    <div class="course-header">
                        <div>
                            <h3>{{ cours.titre }}</h3>
                            <p class="course-meta">
                                <span>{{ cours.niveau.value }}</span>
                                •
                                <span>{{ cours.dureeFormation }}</span>
                            </p>
                        </div>
                        <div class="course-status">
                            {% if cours.status.value == 'APPROVEE' %}
                                <span class="status-badge status-published">✓ Published</span>
                            {% elseif cours.status.value == 'ENATTENTE' %}
                                <span class="status-badge status-pending">⏳ Pending</span>
                            {% else %}
                                <span class="status-badge status-rejected">✗ Rejected</span>
                            {% endif %}
                        </div>
                    </div>
                    
                    <p class="course-description">{{ cours.description }}</p>
                    
                    <div class="course-actions">
                        <a href="{{ path('app_teacher_course_edit', {id: cours.id}) }}" class="btn btn-secondary">
                            ✏️ Edit
                        </a>
                        {% if cours.status.value == 'APPROVEE' %}
                            <a href="{{ path('app_teacher_course_sessions', {id: cours.id}) }}" class="btn btn-primary">
                                📅 View Sessions
                            </a>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">📚</div>
                    <h3>No Courses Yet</h3>
                    <p>Create your first course to get started!</p>
                    <a href="{{ path('app_teacher_course_new') }}" class="btn btn-primary">
                        + Create Course
                    </a>
                </div>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
