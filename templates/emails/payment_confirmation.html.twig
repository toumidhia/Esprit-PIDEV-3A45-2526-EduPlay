{# templates/emails/payment_confirmation.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Confirmation de paiement - EduPlay</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f5f5f5;
        }
        .container {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }
        .header p {
            margin: 10px 0 0;
            opacity: 0.9;
            font-size: 16px;
        }
        .content {
            padding: 30px;
        }
        .greeting {
            font-size: 18px;
            color: #27ae60;
            margin-bottom: 20px;
            font-weight: 600;
        }
        .order-details {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 12px;
            margin: 20px 0;
            border-left: 4px solid #27ae60;
        }
        .order-details h3 {
            margin-top: 0;
            color: #229954;
            font-size: 16px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #e0e0e0;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            font-weight: 600;
            color: #555;
        }
        .detail-value {
            color: #333;
            text-align: right;
        }
        .amount-section {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            margin: 20px 0;
            text-align: center;
        }
        .amount-label {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 10px;
        }
        .amount-value {
            font-size: 36px;
            font-weight: bold;
        }
        .success-icon {
            font-size: 48px;
            display: inline-block;
            margin: 10px 0;
        }
        .action-button {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-block;
            margin: 20px 0;
            font-weight: 600;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }
        .action-button:hover {
            opacity: 0.9;
        }
        .footer {
            text-align: center;
            padding: 20px;
            border-top: 1px solid #eee;
            font-size: 12px;
            color: #999;
            background-color: #fafafa;
        }
        .footer a {
            color: #27ae60;
            text-decoration: none;
        }
        .info-box {
            background: #e8f5e9;
            border-left: 4px solid #27ae60;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            font-size: 14px;
            color: #2e7d32;
        }
        .divider {
            height: 1px;
            background: #eee;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="success-icon">✓</div>
            <h1>Paiement Confirmé!</h1>
            <p>Merci pour votre achat chez EduPlay</p>
        </div>

        <div class="content">
            <div class="greeting">
                Bonjour {{ user.firstName }},
            </div>

            <p>Votre paiement a été traité avec succès. Voici un résumé de votre commande :</p>

            <div class="order-details">
                <h3>📋 Détails de la Commande</h3>
                
                <div class="detail-row">
                    <span class="detail-label">Numéro de commande :</span>
                    <span class="detail-value">#{{ commande.id }}</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Date :</span>
                    <span class="detail-value">{{ commande.dateCommande|date('d/m/Y H:i') }}</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Produit :</span>
                    <span class="detail-value">
                        {% if product %}
                            {{ product.name }}
                        {% else %}
                            Article
                        {% endif %}
                    </span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Quantité :</span>
                    <span class="detail-value">{{ commande.quantity }}</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Montant par unité :</span>
                    <span class="detail-value">
                        ${{ (commande.totalAmount / commande.quantity)|number_format(2) }}
                    </span>
                </div>
            </div>

            <div class="amount-section">
                <div class="amount-label">MONTANT TOTAL PAYÉ</div>
                <div class="amount-value">${{ commande.totalAmount|number_format(2) }}</div>
            </div>

            <div class="info-box">
                <strong>ℹ️ Prochain étape :</strong><br>
                Vous pouvez accéder à vos commandes et télécharger vos produits à tout moment depuis votre tableau de bord.
            </div>

            <div style="text-align: center;">
                <a href="{{ commande_url }}" class="action-button">Voir vos commandes</a>
            </div>

            <div class="divider"></div>

            <p style="font-size: 14px; color: #666;">
                <strong>Important :</strong> Veuillez conserver cette confirmation pour vos dossiers. 
                Votre ID de paiement Stripe : <code style="background: #f0f0f0; padding: 4px 8px; border-radius: 4px;">{{ commande.stripePaymentId }}</code>
            </p>

            <p style="font-size: 14px; color: #999; margin-top: 20px;">
                Si vous avez des questions concernant votre commande, n'hésitez pas à <a href="mailto:contact@eduplay.com" style="color: #27ae60; text-decoration: none;">contacter notre support</a>.
            </p>
        </div>

        <div class="footer">
            <p style="margin: 0;">© {{ year }} EduPlay - Tous droits réservés</p>
            <p style="margin: 5px 0 0;">Cet email a été envoyé à <strong>{{ user.email }}</strong></p>
        </div>
    </div>
</body>
</html>
