<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{% block title %}EduPlay{% endblock %} - Learn, Play, and Grow!</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              "primary": "#63b7f2",
              "accent-yellow": "#F7C56E",
              "accent-pink": "#F29BAE",
              "background-light": "#f6f7f8",
              "background-dark": "#101b22",
            },
            fontFamily: { "display": ["Plus Jakarta Sans"] },
            borderRadius: { "DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px" },
          },
        },
      }
    </script>
    <style>
      .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
      .chatbot-container { position: fixed; bottom: 20px; right: 20px; z-index: 1000; }
      .chatbot-window { display: none; width: 380px; max-width: calc(100vw - 40px); height: 500px; background: white; border-radius: 1rem; box-shadow: 0 10px 40px rgba(0,0,0,0.15); flex-direction: column; overflow: hidden; }
      .chatbot-window.open { display: flex; }
      .chatbot-header { background: linear-gradient(135deg, #63b7f2 0%, #F29BAE 100%); padding: 1rem; color: white; display: flex; justify-content: space-between; align-items: center; }
      .chatbot-messages { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
      .chatbot-message { max-width: 75%; padding: 0.75rem 1rem; border-radius: 1rem; font-size: 0.875rem; }
      .chatbot-message.user { align-self: flex-end; background: #63b7f2; color: white; }
      .chatbot-message.bot { align-self: flex-start; background: #f6f7f8; color: #111518; }
      .chatbot-input-area { border-top: 1px solid #dbe1e6; padding: 1rem; display: flex; gap: 0.5rem; }
      .chatbot-input { flex: 1; border: 1px solid #dbe1e6; border-radius: 0.5rem; padding: 0.5rem 0.75rem; font-size: 0.875rem; }
      .chatbot-toggle { width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #63b7f2 0%, #F29BAE 100%); color: white; border: none; cursor: pointer; box-shadow: 0 4px 20px rgba(99, 183, 242, 0.4); display: flex; align-items: center; justify-content: center; transition: transform 0.2s; }
      .chatbot-toggle:hover { transform: scale(1.1); }
      .chatbot-suggestions { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0.5rem 1rem; border-top: 1px solid #dbe1e6; }
      .chatbot-suggestion { padding: 0.5rem 0.75rem; background: #f6f7f8; border-radius: 0.5rem; font-size: 0.75rem; cursor: pointer; transition: background 0.2s; }
      .chatbot-suggestion:hover { background: #e0e4e7; }
    </style>
        <style>
            /* Base variables and refined Instagram-like dark palette */
            :root{
                --bg: #ffffff;
                --surface: #ffffff;
                --card: #ffffff;
                --text: #111111;
                --muted: #8e8e8e;
                --border: #dbdbdb;
                --primary: #0095f6;
                --accent: #ff2d55;
            }
            .dark {
                --bg: #000000;
                --surface: #0b0b0b;
                --card: #111111;
                --text: #e6e6e6;
                --muted: #9a9a9a;
                --border: #222222;
                --primary: #0095f6;
                --accent: #ff2d55;
            }

            /* Smooth transitions for theme changes */
            html, body { transition: background-color 200ms ease, color 200ms ease; }

            body { background: var(--bg); color: var(--text); }
            header, footer, aside, .bg-white, .chatbot-window { background-color: var(--card) !important; }
            header, footer, .border-b, .border-t, .border-r, .border { border-color: var(--border) !important; }
            a { color: var(--primary); }

            /* Inputs / selects */
            .form-input, .form-select { background: var(--surface); color: var(--text); border-color: var(--border); }
            .form-input::placeholder { color: var(--muted); }
            .chatbot-window { background: linear-gradient(180deg, var(--card), rgba(0,0,0,0.03)); }
            .text-[#111518] { color: var(--text) !important; }
            .bg-primary { background-color: var(--primary) !important; }
            /* UI helper classes */
            .card { border-radius: 1rem; border: 1px solid var(--border); background: var(--card); box-shadow: 0 10px 30px rgba(17,21,24,0.06); overflow: hidden; }
            .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem; border-radius: 9999px; font-weight: 600; }
            .btn-primary { background: var(--primary); color: white; box-shadow: 0 8px 24px rgba(0,149,246,0.14); }
            .table-clean th, .table-clean td { padding: 0.75rem 1rem; }
            .table-clean tbody tr:hover { background: rgba(99,183,242,0.03); }
        </style>
</head>
<body class="bg-background-light font-display text-[#111518] min-h-screen">
<div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
    {% if is_granted('ROLE_PARENT') %}
        <div class="flex min-h-screen">
            {% include 'FrontOffice/parent/Partials/sidebar.html.twig' %}
            <div class="flex-1 flex flex-col">
    {% endif %}
    <header class="flex items-center justify-between border-b border-[#dbe1e6] bg-white/80 backdrop-blur-md px-8 md:px-12 lg:px-16 py-5 sticky top-0 z-50 shadow-sm">
        <a href="{{ path('app_home') }}" class="flex items-center gap-3">
            <div class="size-10 bg-primary rounded-full flex items-center justify-center text-white">
                <span class="material-symbols-outlined text-2xl">rocket_launch</span>
            </div>
            <h2 class="text-2xl font-extrabold tracking-tight">EduPlay</h2>
        </a>
        <nav class="hidden md:flex items-center gap-8">
            <a class="text-sm font-bold hover:text-primary transition-colors" href="{{ path('app_home') }}">Accueil</a>
            <a class="text-sm font-bold hover:text-primary transition-colors" href="{{ path('app_front_shop') }}">Shop</a>
            <a class="text-sm font-bold hover:text-primary transition-colors" href="#">For Teachers</a>
            <a class="text-sm font-bold hover:text-primary transition-colors" href="#">For Parents</a>
        </nav>
        <div class="flex items-center gap-4">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_back_dashboard') }}" class="hidden sm:flex text-sm font-bold px-4 py-2 text-primary">Admin</a>
            {% endif %}
            {% if is_granted('ROLE_PARENT') %}
                <a href="{{ path('app_parent_dashboard') }}" class="hidden sm:flex text-sm font-bold px-4 py-2 text-primary">Mon espace</a>
                <a href="{{ path('app_parent_commandes') }}" class="hidden sm:flex text-sm font-bold px-4 py-2 text-[#617989] hover:text-primary">Mes commandes</a>
            {% endif %}
            {% include 'front/_cart_icon.html.twig' %}
            <button id="dark-toggle" title="Basculer mode sombre" class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-white/20 text-[#111518] hover:opacity-90 transition-opacity">
                <span id="dark-icon" class="material-symbols-outlined">dark_mode</span>
            </button>
            {% if app.user %}
                <a href="{{ path('app_logout') }}" class="flex min-w-[100px] items-center justify-center rounded-full h-11 px-6 bg-gray-200 text-[#111518] text-sm font-bold hover:bg-gray-300 transition-opacity">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="flex min-w-[100px] items-center justify-center rounded-full h-11 px-6 bg-primary text-white text-sm font-bold shadow-lg shadow-primary/30 hover:opacity-90 transition-opacity">Connexion</a>
            {% endif %}
        </div>
    </header>
    <main class="flex-1 overflow-y-auto px-8 md:px-12 lg:px-16 py-12">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 px-6 py-4 rounded-xl {{ label == 'success' ? 'bg-green-100 text-green-800' : (label == 'error' ? 'bg-red-100 text-red-800' : 'bg-primary/10 text-primary') }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
    <footer class="border-t border-[#dbe1e6] bg-white px-8 md:px-12 lg:px-16 py-16 flex-shrink-0">
        <div class="max-w-[1280px] mx-auto text-center">
            <p class="text-sm text-[#617989]">© {{ 'now'|date('Y') }} EduPlay. Plateforme éducation enfants.</p>
        </div>
    </footer>
    {% if is_granted('ROLE_PARENT') %}
            </div>
        </div>
    {% endif %}
</div>

<!-- Chatbot -->
<div class="chatbot-container">
    <div id="chatbotWindow" class="chatbot-window">
        <div class="chatbot-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined">smart_toy</span>
                <span class="font-bold">Assistant EduPlay</span>
            </div>
            <button id="chatbotClose" class="text-white hover:opacity-80">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div id="chatbotMessages" class="chatbot-messages">
            <div class="chatbot-message bot">
                👋 Bonjour ! Je suis l'assistant EduPlay. Comment puis-je vous aider aujourd'hui ?
            </div>
        </div>
        <div class="chatbot-suggestions">
            <span class="chatbot-suggestion" data-query="produits disponibles">Produits disponibles</span>
            <span class="chatbot-suggestion" data-query="comment commander">Comment commander</span>
            <span class="chatbot-suggestion" data-query="prix">Prix</span>
            <span class="chatbot-suggestion" data-query="aide">Aide</span>
        </div>
        <div class="chatbot-input-area">
            <input type="text" id="chatbotInput" class="chatbot-input" placeholder="Tapez votre message..." />
            <button id="chatbotSend" class="px-4 py-2 bg-primary text-white rounded-lg hover:opacity-90 transition-opacity">
                <span class="material-symbols-outlined text-lg">send</span>
            </button>
        </div>
    </div>
    <button id="chatbotToggle" class="chatbot-toggle">
        <span class="material-symbols-outlined text-2xl">chat</span>
    </button>
</div>

<script>
(function() {
    const chatbotWindow = document.getElementById('chatbotWindow');
    const chatbotToggle = document.getElementById('chatbotToggle');
    const chatbotClose = document.getElementById('chatbotClose');
    const chatbotMessages = document.getElementById('chatbotMessages');
    const chatbotInput = document.getElementById('chatbotInput');
    const chatbotSend = document.getElementById('chatbotSend');
    const suggestions = document.querySelectorAll('.chatbot-suggestion');

    const responses = {
        'produits disponibles': 'Nous avons une large sélection de produits éducatifs disponibles ! Vous pouvez parcourir notre boutique et utiliser les filtres pour trouver ce qui vous convient.',
        'comment commander': 'Pour passer une commande : 1) Parcourez nos produits, 2) Cliquez sur "Voir le produit", 3) Cliquez sur "Passer commande", 4) Sélectionnez votre compte parent et la quantité, 5) Confirmez !',
        'prix': 'Nos prix varient selon les produits. Vous pouvez utiliser les filtres de prix (min/max) dans la boutique pour trouver des produits dans votre budget.',
        'aide': 'Je peux vous aider avec : les produits disponibles, comment commander, les prix, et plus encore ! Posez-moi une question.',
        'bonjour': 'Bonjour ! Comment puis-je vous aider aujourd\'hui ?',
        'salut': 'Salut ! Je suis là pour vous aider. Que souhaitez-vous savoir ?',
        'merci': 'De rien ! N\'hésitez pas si vous avez d\'autres questions.',
        'au revoir': 'Au revoir ! À bientôt sur EduPlay !',
        'default': 'Je ne suis pas sûr de comprendre. Pouvez-vous reformuler ? Je peux vous aider avec les produits, les commandes, les prix, etc.'
    };

    function addMessage(text, isUser = false) {
        const message = document.createElement('div');
        message.className = `chatbot-message ${isUser ? 'user' : 'bot'}`;
        message.textContent = text;
        chatbotMessages.appendChild(message);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }

    function getResponse(query) {
        const lowerQuery = query.toLowerCase().trim();
        for (const [key, response] of Object.entries(responses)) {
            if (lowerQuery.includes(key)) {
                return response;
            }
        }
        return responses.default;
    }

    function sendMessage() {
        const query = chatbotInput.value.trim();
        if (!query) return;
        
        addMessage(query, true);
        chatbotInput.value = '';
        
        setTimeout(() => {
            const response = getResponse(query);
            addMessage(response);
        }, 500);
    }

    chatbotToggle.addEventListener('click', () => {
        chatbotWindow.classList.add('open');
        chatbotToggle.style.display = 'none';
    });

    chatbotClose.addEventListener('click', () => {
        chatbotWindow.classList.remove('open');
        chatbotToggle.style.display = 'flex';
    });

    chatbotSend.addEventListener('click', sendMessage);
    chatbotInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });

    suggestions.forEach(suggestion => {
        suggestion.addEventListener('click', () => {
            const query = suggestion.getAttribute('data-query');
            chatbotInput.value = query;
            sendMessage();
        });
    });
})();
</script>
<script>
    (function(){
        const root = document.documentElement;
        const toggle = document.getElementById('dark-toggle');
        const icon = document.getElementById('dark-icon');
        const saved = localStorage.getItem('eduplay_theme');

        function applyTheme(theme) {
            if (theme === 'dark') {
                root.classList.add('dark');
                if (icon) icon.textContent = 'light_mode';
            } else {
                root.classList.remove('dark');
                if (icon) icon.textContent = 'dark_mode';
            }
        }

        if (saved === 'dark' || saved === 'light') {
            applyTheme(saved);
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            applyTheme('dark');
        }

        if (toggle) toggle.addEventListener('click', function(){
            const isDark = root.classList.toggle('dark');
            localStorage.setItem('eduplay_theme', isDark ? 'dark' : 'light');
            if (icon) icon.textContent = isDark ? 'light_mode' : 'dark_mode';
        });
    })();
</script>
</body>
</html>
