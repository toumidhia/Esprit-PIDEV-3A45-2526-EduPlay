{% extends 'base.html.twig' %}

{% block title %}Événements - EduPlay{% endblock %}

{% block body %}
<section class="px-6 md:px-20 lg:px-40 py-12">
  <div class="max-w-[1280px] mx-auto">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">Événements scolaires</h1>
        <p class="text-[#617989] dark:text-gray-400 font-medium mt-2">
          Découvrez les prochains événements et inscrivez-vous.
        </p>
      </div>

      {# ✅ Recherche + tri (GET) #}
      <form method="get" class="w-full md:w-auto flex flex-col sm:flex-row gap-3">
        <input
          class="h-11 px-5 rounded-full border border-[#dbe1e6] dark:border-gray-700 bg-white/80 dark:bg-white/5"
          type="text"
          name="q"
          value="{{ q|default('') }}"
          placeholder="Rechercher (titre/description)…"
        >

        <select
          name="sort"
          class="h-11 px-4 rounded-full border border-[#dbe1e6] dark:border-gray-700 bg-white/80 dark:bg-white/5">
          <option value="start" {{ (sort|default('start')) == 'start' ? 'selected' : '' }}>Date début</option>
          <option value="created" {{ (sort|default('start')) == 'created' ? 'selected' : '' }}>Date création</option>
        </select>

        <select
          name="order"
          class="h-11 px-4 rounded-full border border-[#dbe1e6] dark:border-gray-700 bg-white/80 dark:bg-white/5">
          <option value="asc" {{ (order|default('asc')) == 'asc' ? 'selected' : '' }}>Asc</option>
          <option value="desc" {{ (order|default('asc')) == 'desc' ? 'selected' : '' }}>Desc</option>
        </select>

        <button class="h-11 px-6 rounded-full bg-primary text-white font-extrabold hover:scale-105 transition-transform">
          Filtrer
        </button>
      </form>
    </div>

    {% if events is empty %}
      <div class="bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-xl p-8">
        <p class="font-bold">Aucun événement pour le moment.</p>
      </div>
    {% else %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for e in events %}
          <a href="{{ path('front_event_show', {id: e.id}) }}"
             class="block bg-white/80 dark:bg-white/5 border border-[#dbe1e6] dark:border-gray-800 rounded-xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all">

            {% if e.imagePath %}
              <img src="{{ asset(e.imagePath) }}" alt="{{ e.title }}" class="w-full h-44 object-cover">
            {% else %}
              <div class="w-full h-44 bg-black/5 dark:bg-white/10 flex items-center justify-center">
                <span class="text-sm font-bold text-[#617989] dark:text-gray-400">Aucune image</span>
              </div>
            {% endif %}

            <div class="p-6">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-xl font-extrabold mb-2">{{ e.title }}</h3>
                <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-primary/15 text-primary whitespace-nowrap">
                  {{ e.startDate|date('d/m/Y') }}
                </span>
              </div>

              <p class="text-sm text-[#617989] dark:text-gray-400 font-medium mb-4 line-clamp-3">
                {{ e.description }}
              </p>

              <div class="text-sm font-bold flex flex-col gap-1">
                <div>📅 {{ e.startDate|date('d/m/Y H:i') }} → {{ e.endDate|date('d/m/Y H:i') }}</div>
                {% if e.location %}
                  <div>📍 {{ e.location }}</div>
                {% endif %}
              </div>

              <div class="mt-4 text-primary font-extrabold flex items-center gap-2">
                Voir détails <span class="material-symbols-outlined">arrow_forward</span>
              </div>
            </div>

          </a>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>
{% endblock %}
