{% extends 'base.html.twig' %}

{% block title %}{{ titre }}{% endblock %}

{% block stats_section %}
<!-- Statistics Section (frontend) -->
<section class="px-6 md:px-20 lg:px-40 py-12 bg-white dark:bg-background-dark/40 border-b border-[#dbe1e6] dark:border-gray-800">
    <div class="max-w-[1280px] mx-auto">
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-2 text-center">EduPlay en chiffres</h2>
        <p class="text-[#617989] dark:text-gray-400 font-medium text-center mb-10 max-w-[600px] mx-auto">{{ description }}</p>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
            <div class="bg-background-light dark:bg-gray-800 rounded-xl p-6 text-center border border-[#dbe1e6] dark:border-gray-700">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 text-primary mb-3">
                    <span class="material-symbols-outlined text-2xl">inventory_2</span>
                </div>
                <p class="text-2xl md:text-3xl font-extrabold text-primary">{{ stats.products_total }}</p>
                <p class="text-sm font-bold text-[#617989] dark:text-gray-400">Produits</p>
            </div>
            <div class="bg-background-light dark:bg-gray-800 rounded-xl p-6 text-center border border-[#dbe1e6] dark:border-gray-700">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400 mb-3">
                    <span class="material-symbols-outlined text-2xl">check_circle</span>
                </div>
                <p class="text-2xl md:text-3xl font-extrabold text-green-600 dark:text-green-400">{{ stats.products_available }}</p>
                <p class="text-sm font-bold text-[#617989] dark:text-gray-400">Disponibles</p>
            </div>
            <div class="bg-background-light dark:bg-gray-800 rounded-xl p-6 text-center border border-[#dbe1e6] dark:border-gray-700">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent-pink/10 text-accent-pink mb-3">
                    <span class="material-symbols-outlined text-2xl">shopping_cart</span>
                </div>
                <p class="text-2xl md:text-3xl font-extrabold text-accent-pink">{{ stats.commandes_total }}</p>
                <p class="text-sm font-bold text-[#617989] dark:text-gray-400">Commandes</p>
            </div>
            <div class="bg-background-light dark:bg-gray-800 rounded-xl p-6 text-center border border-[#dbe1e6] dark:border-gray-700">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent-yellow/10 text-accent-yellow mb-3">
                    <span class="material-symbols-outlined text-2xl">payments</span>
                </div>
                <p class="text-xl md:text-2xl font-extrabold text-[#111518] dark:text-white">{{ stats.commandes_amount|number_format(0, ',', ' ') }} DT</p>
                <p class="text-sm font-bold text-[#617989] dark:text-gray-400">Montant total</p>
            </div>
            <div class="bg-background-light dark:bg-gray-800 rounded-xl p-6 text-center border border-[#dbe1e6] dark:border-gray-700 col-span-2 md:col-span-1">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 text-primary mb-3">
                    <span class="material-symbols-outlined text-2xl">group</span>
                </div>
                <p class="text-2xl md:text-3xl font-extrabold text-primary">{{ stats.users_total }}</p>
                <p class="text-sm font-bold text-[#617989] dark:text-gray-400">Utilisateurs</p>
            </div>
        </div>
        <div class="text-center mt-8">
            <a href="{{ path('app_front_shop') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-bold rounded-full hover:opacity-90 transition-opacity">
                <span class="material-symbols-outlined">shopping_bag</span>
                Voir la boutique
            </a>
        </div>
    </div>
</section>
{% endblock %}
