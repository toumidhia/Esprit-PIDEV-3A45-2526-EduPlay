{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

<div class="space-y-4">
    <div>
        {{ form_label(form.courseId, null, {'label_attr': {'class': 'block text-sm font-bold text-[#111518] dark:text-white mb-2'}}) }}
        {{ form_widget(form.courseId, {'attr': {'class': 'w-full px-4 py-3 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
        <div class="text-red-600 text-sm mt-1">{{ form_errors(form.courseId) }}</div>
        {% if form.courseId.vars.help is defined %}
            <p class="text-xs text-[#617989] dark:text-gray-400 mt-1">{{ form.courseId.vars.help }}</p>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.startTime, null, {'label_attr': {'class': 'block text-sm font-bold text-[#111518] dark:text-white mb-2'}}) }}
            {{ form_widget(form.startTime, {'attr': {'class': 'w-full px-4 py-3 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
            <div class="text-red-600 text-sm mt-1">{{ form_errors(form.startTime) }}</div>
            {% if form.startTime.vars.help is defined %}
                <p class="text-xs text-[#617989] dark:text-gray-400 mt-1">{{ form.startTime.vars.help }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.endTime, null, {'label_attr': {'class': 'block text-sm font-bold text-[#111518] dark:text-white mb-2'}}) }}
            {{ form_widget(form.endTime, {'attr': {'class': 'w-full px-4 py-3 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
            <div class="text-red-600 text-sm mt-1">{{ form_errors(form.endTime) }}</div>
            {% if form.endTime.vars.help is defined %}
                <p class="text-xs text-[#617989] dark:text-gray-400 mt-1">{{ form.endTime.vars.help }}</p>
            {% endif %}
        </div>
    </div>
</div>

<div class="flex gap-4 mt-6">
    <button type="submit" class="flex-1 px-6 py-3 bg-primary text-white rounded-full font-bold hover:scale-105 transition-transform shadow-lg">
        <span class="material-symbols-outlined text-sm inline">save</span>
        Save Session
    </button>
    <a href="{{ path('app_seance_index') }}" class="flex-1 text-center px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#111518] dark:text-white rounded-full font-bold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
        Cancel
    </a>
</div>

{{ form_end(form) }}
