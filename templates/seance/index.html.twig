{% extends 'base.html.twig' %}

{% block title %}Session Management{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-8">
    <!-- Flash Messages -->
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 p-4 rounded-lg {% if type == 'success' %}bg-green-100 text-green-800{% elseif type == 'error' %}bg-red-100 text-red-800{% else %}bg-yellow-100 text-yellow-800{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-4xl font-extrabold text-[#111518] dark:text-white">Session Management</h1>
            <p class="text-[#617989] dark:text-gray-400 mt-2">
                Admin panel - Assign sessions to accepted courses
            </p>
        </div>
        <a href="{{ path('app_seance_new') }}" class="flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-full font-bold hover:scale-105 transition-transform shadow-lg">
            <span class="material-symbols-outlined">add_circle</span>
            Create New Session
        </a>
    </div>

    <!-- Statistics Cards -->
    {% if statistics is defined and statistics %}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg border-l-4 border-primary">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-[#617989] dark:text-gray-400 uppercase font-bold">Total Sessions</p>
                    <p class="text-3xl font-extrabold text-[#111518] dark:text-white">{{ statistics.total }}</p>
                </div>
                <span class="material-symbols-outlined text-primary text-4xl">event_note</span>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg border-l-4 border-green-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-[#617989] dark:text-gray-400 uppercase font-bold">Upcoming</p>
                    <p class="text-3xl font-extrabold text-[#111518] dark:text-white">{{ statistics.upcoming }}</p>
                </div>
                <span class="material-symbols-outlined text-green-500 text-4xl">upcoming</span>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg border-l-4 border-gray-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-[#617989] dark:text-gray-400 uppercase font-bold">Past</p>
                    <p class="text-3xl font-extrabold text-[#111518] dark:text-white">{{ statistics.past }}</p>
                </div>
                <span class="material-symbols-outlined text-gray-500 text-4xl">history</span>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Advanced Filters -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 mb-8">
        <form method="get" action="{{ path('app_seance_index') }}" class="space-y-4">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-[#111518] dark:text-white flex items-center gap-2">
                    <span class="material-symbols-outlined">filter_list</span>
                    Filters & Search
                </h3>
                <a href="{{ path('app_seance_index') }}" class="text-sm text-primary font-bold hover:underline">
                    Clear All Filters
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <!-- Search by Course Title -->
                <div>
                    <label class="block text-sm font-bold text-[#111518] dark:text-white mb-2">
                        <span class="material-symbols-outlined text-sm inline">search</span>
                        Search Course
                    </label>
                    <input type="text" name="search" value="{{ filters.search }}" 
                           placeholder="Search by course title..." 
                           class="w-full px-4 py-2 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary">
                </div>

                <!-- Course Filter -->
                <div>
                    <label class="block text-sm font-bold text-[#111518] dark:text-white mb-2">
                        <span class="material-symbols-outlined text-sm inline">school</span>
                        Course
                    </label>
                    <select name="course" class="w-full px-4 py-2 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary">
                        <option value="">All Courses</option>
                        {% for course in courses %}
                            <option value="{{ course.id }}" {% if filters.courseId == course.id %}selected{% endif %}>
                                {{ course.title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Start Date Filter -->
                <div>
                    <label class="block text-sm font-bold text-[#111518] dark:text-white mb-2">
                        <span class="material-symbols-outlined text-sm inline">calendar_today</span>
                        Start Date
                    </label>
                    <input type="date" name="startDate" value="{{ filters.startDate }}" 
                           class="w-full px-4 py-2 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary">
                </div>

                <!-- End Date Filter -->
                <div>
                    <label class="block text-sm font-bold text-[#111518] dark:text-white mb-2">
                        <span class="material-symbols-outlined text-sm inline">event</span>
                        End Date
                    </label>
                    <input type="date" name="endDate" value="{{ filters.endDate }}" 
                           class="w-full px-4 py-2 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Month Filter -->
                <div>
                    <label class="block text-sm font-bold text-[#111518] dark:text-white mb-2">
                        <span class="material-symbols-outlined text-sm inline">calendar_month</span>
                        Filter by Month
                    </label>
                    <input type="month" name="month" value="{{ filters.month }}" 
                           class="w-full px-4 py-2 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary">
                </div>

                <!-- Sort By -->
                <div>
                    <label class="block text-sm font-bold text-[#111518] dark:text-white mb-2">
                        <span class="material-symbols-outlined text-sm inline">sort</span>
                        Sort By
                    </label>
                    <select name="sort" class="w-full px-4 py-2 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary">
                        <option value="startTime" {% if sortBy == 'startTime' %}selected{% endif %}>Start Time</option>
                        <option value="endTime" {% if sortBy == 'endTime' %}selected{% endif %}>End Time</option>
                        <option value="id" {% if sortBy == 'id' %}selected{% endif %}>Session ID</option>
                    </select>
                </div>

                <!-- Sort Order -->
                <div>
                    <label class="block text-sm font-bold text-[#111518] dark:text-white mb-2">
                        <span class="material-symbols-outlined text-sm inline">swap_vert</span>
                        Order
                    </label>
                    <select name="order" class="w-full px-4 py-2 rounded-lg border border-[#dbe1e6] dark:border-gray-700 focus:ring-2 focus:ring-primary">
                        <option value="DESC" {% if sortOrder == 'DESC' %}selected{% endif %}>Newest First</option>
                        <option value="ASC" {% if sortOrder == 'ASC' %}selected{% endif %}>Oldest First</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-4">
                <button type="submit" class="flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-full font-bold hover:scale-105 transition-transform">
                    <span class="material-symbols-outlined">search</span>
                    Apply Filters
                </button>
            </div>
        </form>
    </div>

    <!-- Sessions Grid -->
    {% if seances|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for seance in seances %}
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all">
                    <!-- Course Info Header -->
                    <div class="p-4 bg-primary/10">
                        <h3 class="text-lg font-bold text-[#111518] dark:text-white mb-1">
                            {{ seance.courseId.title }}
                        </h3>
                        <p class="text-sm text-[#617989] dark:text-gray-400">
                            {{ seance.courseId.level }} - {{ seance.courseId.durationTraining }}
                        </p>
                    </div>

                    <!-- Session Details -->
                    <div class="p-6">
                        <div class="space-y-4 mb-6">
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-green-500">play_circle</span>
                                <div class="flex-1">
                                    <p class="text-xs font-bold text-[#617989] dark:text-gray-400 uppercase">Start Time</p>
                                    <p class="font-bold text-[#111518] dark:text-white">
                                        {{ seance.startTime|date('F j, Y') }}<br>
                                        <span class="text-primary">{{ seance.startTime|date('g:i A') }}</span>
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-red-500">stop_circle</span>
                                <div class="flex-1">
                                    <p class="text-xs font-bold text-[#617989] dark:text-gray-400 uppercase">End Time</p>
                                    <p class="font-bold text-[#111518] dark:text-white">
                                        {{ seance.endTime|date('F j, Y') }}<br>
                                        <span class="text-accent-pink">{{ seance.endTime|date('g:i A') }}</span>
                                    </p>
                                </div>
                            </div>

                            {% set duration = date(seance.endTime).diff(date(seance.startTime)) %}
                            <div class="p-3 bg-accent-yellow/10 rounded-lg text-center">
                                <p class="text-xs font-bold text-[#617989] dark:text-gray-400 uppercase mb-1">Duration</p>
                                <p class="font-extrabold text-[#111518] dark:text-white">
                                    {% if duration.days > 0 %}{{ duration.days }} days {% endif %}
                                    {{ duration.h }} hours {{ duration.i }} minutes
                                </p>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex gap-2">
                            <a href="{{ path('app_seance_show', {'id': seance.id}) }}" 
                               class="flex-1 text-center px-4 py-2 bg-primary/10 text-primary rounded-lg font-bold hover:bg-primary/20 transition-colors">
                                View
                            </a>
                            <a href="{{ path('app_seance_edit', {'id': seance.id}) }}" 
                               class="flex-1 text-center px-4 py-2 bg-accent-yellow/10 text-[#111518] rounded-lg font-bold hover:bg-accent-yellow/20 transition-colors">
                                Edit
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-xl">
            <span class="material-symbols-outlined text-6xl text-[#617989] dark:text-gray-400 mb-4">event_note</span>
            <h3 class="text-xl font-bold text-[#617989] dark:text-gray-400 mb-2">No Sessions Found</h3>
            <p class="text-[#617989] dark:text-gray-400 mb-4">Try adjusting your filters or create a new session!</p>
            {% if filters.search or filters.courseId or filters.startDate or filters.endDate or filters.month %}
                <a href="{{ path('app_seance_index') }}" class="inline-block px-6 py-3 bg-primary text-white rounded-full font-bold hover:scale-105 transition-transform">
                    Clear Filters
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
