{% extends 'base.html.twig' %}

{% block title %}Session Details{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-8 max-w-4xl">
    <!-- Back Button -->
    <div class="mb-6">
        <a href="{{ path('app_seance_index') }}" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
            <span class="material-symbols-outlined">arrow_back</span>
            Back to Sessions
        </a>
    </div>

    <!-- Session Card -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden">
        <!-- Header with Course Info -->
        <div class="bg-gradient-to-r from-primary to-accent-pink p-8 text-white">
            <div class="flex items-center gap-3 mb-4">
                <span class="material-symbols-outlined text-4xl">event</span>
                <div>
                    <p class="text-sm text-white/80 uppercase font-bold">Session for</p>
                    <h1 class="text-3xl font-extrabold">{{ seance.courseId.title }}</h1>
                </div>
            </div>
            <div class="flex gap-4">
                <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-sm font-bold">
                    {{ seance.courseId.level }}
                </span>
                <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-sm font-bold">
                    {{ seance.courseId.durationTraining }}
                </span>
            </div>
        </div>

        <!-- Session Details -->
        <div class="p-8 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="p-6 bg-green-50 dark:bg-green-900/20 rounded-xl border-2 border-green-200 dark:border-green-800">
                    <div class="flex items-start gap-4">
                        <div class="bg-green-500 p-3 rounded-full">
                            <span class="material-symbols-outlined text-white">play_circle</span>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-sm font-bold text-[#617989] dark:text-gray-400 uppercase mb-2">Start Time</h3>
                            <p class="text-2xl font-extrabold text-[#111518] dark:text-white mb-1">
                                {{ seance.startTime|date('g:i A') }}
                            </p>
                            <p class="text-[#617989] dark:text-gray-400 font-medium">
                                {{ seance.startTime|date('l, F j, Y') }}
                            </p>
                        </div>
                    </div>
                </div>

                <div class="p-6 bg-red-50 dark:bg-red-900/20 rounded-xl border-2 border-red-200 dark:border-red-800">
                    <div class="flex items-start gap-4">
                        <div class="bg-red-500 p-3 rounded-full">
                            <span class="material-symbols-outlined text-white">stop_circle</span>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-sm font-bold text-[#617989] dark:text-gray-400 uppercase mb-2">End Time</h3>
                            <p class="text-2xl font-extrabold text-[#111518] dark:text-white mb-1">
                                {{ seance.endTime|date('g:i A') }}
                            </p>
                            <p class="text-[#617989] dark:text-gray-400 font-medium">
                                {{ seance.endTime|date('l, F j, Y') }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Duration Card -->
            {% set duration = date(seance.endTime).diff(date(seance.startTime)) %}
            <div class="p-6 bg-accent-yellow/10 rounded-xl text-center border-2 border-accent-yellow/20">
                <h3 class="text-sm font-bold text-[#617989] dark:text-gray-400 uppercase mb-3">Total Duration</h3>
                <p class="text-4xl font-extrabold text-[#111518] dark:text-white">
                    {% if duration.days > 0 %}
                        {{ duration.days }} <span class="text-2xl">days</span>
                    {% endif %}
                    {{ duration.h }} <span class="text-2xl">hours</span>
                    {{ duration.i }} <span class="text-2xl">minutes</span>
                </p>
            </div>

            <!-- Course Description -->
            <div class="p-6 bg-background-light dark:bg-gray-900 rounded-xl">
                <h3 class="font-extrabold text-[#111518] dark:text-white mb-3">Course Description</h3>
                <p class="text-[#617989] dark:text-gray-400 leading-relaxed">
                    {{ seance.courseId.description }}
                </p>
            </div>

            {% if seance.courseId.teacherId %}
            <div class="p-6 bg-background-light dark:bg-gray-900 rounded-xl">
                <h3 class="font-extrabold text-[#111518] dark:text-white mb-3">Instructor</h3>
                <div class="flex items-center gap-3">
                    <div class="bg-primary/10 p-3 rounded-full">
                        <span class="material-symbols-outlined text-primary">person</span>
                    </div>
                    <div>
                        <p class="font-bold text-[#111518] dark:text-white">
                            {{ seance.courseId.teacherId.firstName }} {{ seance.courseId.teacherId.lastName }}
                        </p>
                        <p class="text-sm text-[#617989] dark:text-gray-400">
                            {{ seance.courseId.teacherId.email }}
                        </p>
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- Actions -->
            <div class="flex flex-wrap gap-4 pt-6 border-t border-[#dbe1e6] dark:border-gray-700">
                <a href="{{ path('app_seance_edit', {'id': seance.id}) }}" 
                   class="flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-full font-bold hover:scale-105 transition-transform shadow-lg">
                    <span class="material-symbols-outlined">edit</span>
                    Edit Session
                </a>
                <a href="{{ path('app_seance_index') }}" 
                   class="flex items-center gap-2 px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#111518] dark:text-white rounded-full font-bold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
